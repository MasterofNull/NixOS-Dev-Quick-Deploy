{
  "pythonVersion": "3.13",
  "typeCheckingMode": "standard",
  "extraPaths": [
    "ai-stack/mcp-servers",
    "ai-stack/mcp-servers/hybrid-coordinator",
    "ai-stack",
    "ai-stack/capability-gap",
    "ai-stack/efficiency",
    "ai-stack/offloading",
    "ai-stack/observability",
    "ai-stack/world-model",
    "ai-stack/progressive-disclosure",
    "ai-stack/affective-engine",
    "ai-stack/autoresearch",
    "ai-stack/identity-kernel",
    "ai-stack/local-agents",
    "ai-stack/model-optimization",
    "ai-stack/real-time-learning",
    "dashboard/backend"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.git",
    "**/archive",
    "**/archived",
    ".agent/archive",
    ".agents/archive",
    ".agents/delegation",
    "result*"
  ],
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none"
}
