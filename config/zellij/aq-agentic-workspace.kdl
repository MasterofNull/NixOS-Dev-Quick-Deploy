// AQ-OS SOTA Agentic Workspace Layout for Zellij
// Dual-Board Swarm Layout:
//   • LEFT BOARD:   Direct Native CLI Agents (Local Qwen, Claude, Codex, Gemini)
//   • RIGHT BOARD:  Interactive Sub-Agents (Delegation Tree & Live Steering Console)

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Swarm & Sub-Agents" focus=true {
        pane split_direction="vertical" {
            // LEFT BOARD: ALL MAIN AGENTS (LOCAL + REMOTE) READY TO INTERACT
            pane split_direction="horizontal" size="52%" {
                pane split_direction="vertical" size="50%" {
                    pane name="󰚩 Local Qwen3-35B (Local APU :8080)" focus=true {
                        command "aq-agent-launcher"
                        args "local"
                    }
                    pane name="󰚩 Claude 3.7 / Fable-5 (Anthropic CLI)" {
                        command "aq-agent-launcher"
                        args "claude"
                    }
                }
                pane split_direction="vertical" size="50%" {
                    pane name="󰚩 OpenAI Codex / GPT-6 Astra (Codex CLI)" {
                        command "aq-agent-launcher"
                        args "codex"
                    }
                    pane name="󰚩 Google Gemini 3.8-Flash (Gemini CLI)" {
                        command "aq-agent-launcher"
                        args "gemini"
                    }
                }
            }
            // RIGHT BOARD: INTERACTIVE SUB-AGENTS & DELEGATIONS
            pane split_direction="horizontal" size="48%" {
                pane size="40%" name="󰚩 Sub-Agent Delegation Hierarchy Tree" {
                    command "aq-fleet-monitor"
                    args "--tree"
                }
                pane size="60%" name="󰚩 Interactive Sub-Agent Console & Steering" {
                    command "aq-subagent-interactive"
                }
            }
        }
    }

    tab name="Floating Swarm Board" {
        pane size="100%" borderless=true name="Background Canvas" {
            command "aq-cockpit-monitor"
        }
        floating_panes {
            // LEFT BOARD: Main Models 2x2
            pane x="1%" y="3%" width="24%" height="45%" name="󰚩 Local Qwen3-35B (APU)" focus=true {
                command "aq-agent-launcher"
                args "local"
            }
            pane x="25%" y="3%" width="24%" height="45%" name="󰚩 Claude 3.7 / Fable-5" {
                command "aq-agent-launcher"
                args "claude"
            }
            pane x="1%" y="49%" width="24%" height="47%" name="󰚩 OpenAI Codex / GPT-6 Astra" {
                command "aq-agent-launcher"
                args "codex"
            }
            pane x="25%" y="49%" width="24%" height="47%" name="󰚩 Google Gemini 3.8-Flash" {
                command "aq-agent-launcher"
                args "gemini"
            }
            // RIGHT BOARD: Sub-Agents Tree & Interactive Console
            pane x="50%" y="3%" width="49%" height="40%" name="󰚩 Sub-Agent Delegation Hierarchy Tree" {
                command "aq-fleet-monitor"
                args "--tree"
            }
            pane x="50%" y="44%" width="49%" height="52%" name="󰚩 Interactive Sub-Agent Console & Steering" {
                command "aq-subagent-interactive"
            }
        }
    }

    tab name="Coordinator Console" {
        pane split_direction="vertical" {
            pane size="58%" name="Central Steering Console" focus=true {
                command "aq-coordinator-repl"
            }
            pane split_direction="horizontal" size="42%" {
                pane size="50%" name="Sub-Agent Fleet Matrix" {
                    command "aq-fleet-monitor"
                }
                pane size="50%" name="Telemetry Cockpit" {
                    command "aq-cockpit-monitor"
                }
            }
        }
    }

    tab name="Claude & Sub-Agents" {
        pane split_direction="vertical" {
            pane size="55%" name="󰚩 Claude 3.7 / Fable-5 (Direct Native CLI)" focus=true {
                command "aq-agent-launcher"
                args "claude"
            }
            pane split_direction="horizontal" size="45%" {
                pane size="40%" name="󰚩 Claude Sub-Agent Delegation Tree (Right Board)" {
                    command "aq-fleet-monitor"
                    args "--tree" "--agent" "claude"
                }
                pane size="60%" name="󰚩 Interactive Claude Sub-Agent Console" {
                    command "aq-subagent-interactive"
                }
            }
        }
    }

    tab name="Codex & Sub-Agents" {
        pane split_direction="vertical" {
            pane size="55%" name="󰚩 OpenAI Codex (Direct Native CLI)" focus=true {
                command "aq-agent-launcher"
                args "codex"
            }
            pane split_direction="horizontal" size="45%" {
                pane size="40%" name="󰚩 Codex Sub-Agent Delegation Tree (Right Board)" {
                    command "aq-fleet-monitor"
                    args "--tree" "--agent" "codex"
                }
                pane size="60%" name="󰚩 Interactive Codex Sub-Agent Console" {
                    command "aq-subagent-interactive"
                }
            }
        }
    }

    tab name="Gemini & Sub-Agents" {
        pane split_direction="vertical" {
            pane size="55%" name="󰚩 Google Gemini (Direct Native CLI)" focus=true {
                command "aq-agent-launcher"
                args "gemini"
            }
            pane split_direction="horizontal" size="45%" {
                pane size="40%" name="󰚩 Gemini Sub-Agent Delegation Tree (Right Board)" {
                    command "aq-fleet-monitor"
                    args "--tree" "--agent" "gemini"
                }
                pane size="60%" name="󰚩 Interactive Gemini Sub-Agent Console" {
                    command "aq-subagent-interactive"
                }
            }
        }
    }

    tab name="Local Qwen & Sub-Agents" {
        pane split_direction="vertical" {
            pane size="55%" name="󰚩 Local Qwen3-35B APU (aq-chat Tool Calling)" focus=true {
                command "aq-agent-launcher"
                args "local"
            }
            pane split_direction="horizontal" size="45%" {
                pane size="40%" name="󰚩 Local Sub-Agent Delegation Tree (Right Board)" {
                    command "aq-fleet-monitor"
                    args "--tree" "--agent" "local"
                }
                pane size="60%" name="󰚩 Interactive Local Sub-Agent Console" {
                    command "aq-subagent-interactive"
                }
            }
        }
    }

    tab name="Any Model (Dynamic)" {
        pane split_direction="vertical" {
            pane size="55%" name="󰚩 Any Model Interactive Console (Left Board)" focus=true {
                command "aq-agent-launcher"
                args "local"
            }
            pane split_direction="horizontal" size="45%" {
                pane size="40%" name="󰚩 Sub-Agent Delegation Tree (Right Board)" {
                    command "aq-fleet-monitor"
                    args "--tree"
                }
                pane size="60%" name="󰚩 Interactive Sub-Agent Console" {
                    command "aq-subagent-interactive"
                }
            }
        }
    }

    tab name="Scratch Shell" {
        pane name="Local Development Shell"
    }
}
