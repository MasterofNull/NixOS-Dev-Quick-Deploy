  "runbook": "docs/harness-first/HARNESS-FIRST-RUNBOOK.md",
  "evidence_template": "docs/harness-first/HARNESS-FIRST-EVIDENCE-TEMPLATE.md",
  "required_sections": [
    "## Objective",
    "## Scope Lock",
    "## Non-Negotiable Gates",
    "## Delegation Policy (Subagents + Local Tooling)",
    "## Standard Task Lifecycle",
    "## Evidence Artifact Contract",
    "## Rollback",
    "## CI Enforcement",
    "## Local Release Gate"
