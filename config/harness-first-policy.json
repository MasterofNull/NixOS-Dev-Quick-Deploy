  "required_commands": [
    "scripts/ai/aq-hints",
    "scripts/ai/harness-rpc.js run-start",
    "scripts/ai/aq-qa 0 --json",
    "scripts/ai/aq-qa 1 --json",
    "scripts/health/system-health-check.sh --detailed",
    "scripts/automation/run-advanced-parity-suite.sh"
