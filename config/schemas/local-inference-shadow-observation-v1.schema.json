{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aq.local-inference-shadow-observation/1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_id", "observation_id", "request_ref", "trace_ref", "shadow_sequence", "observed_at", "producer", "producer_revision", "resolved_plan_digest", "legacy_observation_digest", "compatibility_adapter", "decision", "typed_error", "divergence_findings", "provenance_refs", "shadow", "non_authoritative", "no_live_cutover", "observation_digest"],
  "properties": {
    "schema_id": {"const": "aq.local-inference-shadow-observation/1.0"},
    "observation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "request_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "trace_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "shadow_sequence": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "producer": {"const": "l3-p0-kernel"}, "producer_revision": {"const": "1"},
    "resolved_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "legacy_observation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compatibility_adapter": {"const": "none"}, "decision": {"const": "shadow_only"},
    "typed_error": {"type": "null"},
    "divergence_findings": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "provenance_refs": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/provenance_ref"}},
    "shadow": {"const": true}, "non_authoritative": {"const": true}, "no_live_cutover": {"const": true},
    "observation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "provenance_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_type", "producer", "producer_revision", "evidence_ref", "value_digest"],
      "properties": {
        "fact_type": {"enum": ["authenticated_principal", "role", "approval_or_lease", "profile", "eligibility", "budget", "path", "clock"]},
        "producer": {"type": "string", "minLength": 1, "maxLength": 128},
        "producer_revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "value_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
