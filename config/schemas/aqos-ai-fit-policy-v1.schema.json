{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aq-os.local/schemas/aqos-ai-fit-policy-v1.schema.json",
  "title": "AQ-OS AI-fit policy + model catalog v1",
  "description": "Closed, secret-free, digest-pinned catalog of measured reserves, acceleration backends, and local models. Its exact file bytes are hashed (sha256) and that digest is bound into the resolved install-plan lock (catalog_digests.ai_fit_policy_catalog_sha256). No model recommendation logic lives here: this file carries only measured/provenanced data; the deterministic verdict is computed by scripts/ai/lib/ai_fit.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "policy_version", "owner", "reserves", "backends", "models"],
  "properties": {
    "catalog_version": { "const": "aqos-ai-fit-policy/v1" },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "owner": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 2048 },
    "reference_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine", "notes"],
      "properties": {
        "machine": { "type": "string", "minLength": 1, "maxLength": 256 },
        "notes": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "reserves": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os_reserve_bytes", "kv_cache_floor_bytes", "recommended_headroom_bytes", "source"],
      "properties": {
        "os_reserve_bytes": { "type": "integer", "minimum": 0 },
        "kv_cache_floor_bytes": { "type": "integer", "minimum": 0 },
        "recommended_headroom_bytes": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "backends": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offload", "requires_discrete_vram", "stable", "auto_select"],
          "properties": {
            "offload": { "enum": ["none", "partial", "full"] },
            "requires_discrete_vram": { "type": "boolean" },
            "stable": { "type": "boolean" },
            "auto_select": { "type": "boolean" },
            "apu_gpu_layer_cap": { "type": "integer", "minimum": 0, "maximum": 512 },
            "vendor_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^0x[0-9a-f]{4}$" },
              "uniqueItems": true,
              "maxItems": 8
            },
            "source": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "params_b", "quantization", "ram_required_bytes", "vram_required_bytes", "context_max", "cpu_only_supported", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 64 },
          "params_b": { "type": "number", "minimum": 0, "maximum": 10000 },
          "quantization": { "type": "string", "pattern": "^[A-Za-z0-9_]+$", "maxLength": 32 },
          "ram_required_bytes": { "type": "integer", "minimum": 0 },
          "vram_required_bytes": { "type": "integer", "minimum": 0 },
          "context_max": { "type": "integer", "minimum": 1 },
          "cpu_only_supported": { "type": "boolean" },
          "moe": { "type": "boolean" },
          "source": { "type": "string", "minLength": 1, "maxLength": 512 },
          "notes": { "type": "string", "maxLength": 1024 }
        }
      }
    }
  }
}
