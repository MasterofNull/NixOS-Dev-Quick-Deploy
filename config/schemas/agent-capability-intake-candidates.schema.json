{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-capability-intake-candidates.schema.json",
  "title": "Agent capability intake candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "owner", "policy", "candidates"],
  "properties": {
    "$schema": {"const": "./schemas/agent-capability-intake-candidates.schema.json"},
    "version": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "owner": {"type": "string", "minLength": 1, "maxLength": 80},
    "policy": {"$ref": "#/$defs/policy"},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "boundedString": {"type": "string", "minLength": 1, "maxLength": 4096},
    "boundedList": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedString"}},
    "urlOrLocal": {"anyOf": [{"const": "local"}, {"type": "string", "format": "uri", "maxLength": 2048}]},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["default_state", "activation_requires"],
      "properties": {
        "default_state": {"enum": ["proposed"]},
        "activation_requires": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"enum": ["pinned_version", "tool_allowlist", "supply_chain_scan", "runtime_sandbox", "dashboard_or_aq_report_visibility", "rollback_path"]}}
      }
    },
    "install": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "command", "args"],
      "properties": {
        "type": {"enum": ["mcp", "cli", "local-skill", "disabled-external-repo"]},
        "command": {"type": "string", "minLength": 1, "maxLength": 512},
        "args": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 2048}}
      }
    },
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["network", "filesystem", "writes", "secrets"],
      "properties": {
        "network": {"enum": [false, "localhost", "restricted-localhost-preferred", "package-bootstrap-only", "github-api", "osv-api", "vulnerability-db-updates", "nix-substituters-only", "scope-gated-local-only"]},
        "filesystem": {"enum": ["none", "workspace-read", "logs-read", "quarantine-read"]},
        "writes": {"enum": [false, "reports-only", "report-output-only", "knowledge-graph-output", "scope-receipts-and-reports"]},
        "secrets": {"anyOf": [{"const": false}, {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]*$"}]}
      }
    },
    "toolSchema": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": {"enum": ["object", "array", "string", "number", "integer", "boolean"]},
        "properties": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
          "additionalProperties": {"$ref": "#/$defs/toolSchema"}
        },
        "items": {"$ref": "#/$defs/toolSchema"},
        "additionalProperties": {"anyOf": [{"type": "boolean"}, {"$ref": "#/$defs/toolSchema"}]},
        "enum": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": ["string", "number", "integer", "boolean", "null"], "maxLength": 512}},
        "pattern": {"type": "string", "maxLength": 512},
        "maxLength": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "category", "source_url", "maturity", "priority", "state", "review_status", "install", "tool_allowlist", "permissions", "value", "risks", "activation_notes"],
      "properties": {
        "id": {"type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"},
        "name": {"$ref": "#/$defs/boundedString"},
        "category": {"enum": ["browser-automation", "security-scanning", "repo-collaboration", "supply-chain-security", "agent-security", "operations", "nixos", "code-understanding", "security-redteam", "agent-system-pattern-reference", "security-workflow-reference"]},
        "source_url": {"$ref": "#/$defs/urlOrLocal"},
        "secondary_source_url": {"$ref": "#/$defs/urlOrLocal"},
        "maturity": {"enum": ["official", "mature", "local-build", "third-party-dual-use", "third-party-reference"]},
        "priority": {"enum": ["very-high", "high", "medium-high", "medium"]},
        "state": {"enum": ["enabled", "ready-scope-gated", "proposed", "quarantined"]},
        "pinned_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_hash": {"type": "string", "minLength": 1, "maxLength": 256},
        "review_status": {"enum": ["accepted-with-mitigations", "incomplete"]},
        "mitigations": {"$ref": "#/$defs/boundedList"},
        "blocked_reason": {"$ref": "#/$defs/boundedString"},
        "unblock_condition": {"$ref": "#/$defs/boundedString"},
        "install": {"$ref": "#/$defs/install"},
        "tool_allowlist": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*$"}},
        "tool_schemas": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/toolSchema"}
        },
        "permissions": {"$ref": "#/$defs/permissions"},
        "value": {"$ref": "#/$defs/boundedString"},
        "risks": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"enum": ["browser-network-egress", "npm-package-execution", "python-package-execution", "nix-package-bootstrap", "external-api-token", "repository-metadata-exposure", "external-vulnerability-api", "external-db-update", "secret-finding-output-sensitive", "report-artifact-management", "nix-evaluation-cost", "substituter-network", "llm-generated-graph-inaccuracy", "log-sensitive-data", "dual-use-offensive-security", "network-active-scanning", "exploit-tool-exposure", "mcp-tool-authority-expansion", "agpl-license-obligations", "agpl-license-uncertainty", "authority-duplication", "hosted-plugin-surface", "custom-eula-restrictions", "privileged-install", "active-exploitation", "external-integration", "autonomous-loop", "prompt-injection", "scope-escape", "tool-execution", "resource-exhaustion"]}},
        "activation_notes": {"$ref": "#/$defs/boundedString"}
      }
    }
  }
}
