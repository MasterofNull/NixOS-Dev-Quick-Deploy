{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "aq.scheduler-lease-context/1",
  "description": "Closed Ed25519-signed scheduler context emitted by C2-SCI.",
  "required": ["schema", "schema_version", "context_id", "lease_id", "grant_digest", "task_id", "audience", "principal", "dispatch_mode", "action_class", "trust_tier", "policy_revision", "issued_at", "expires_at", "revocation_epoch", "issuer_key_id", "sig_scheme", "signature"],
  "properties": {
    "schema": {"type": "string", "const": "aq.scheduler-lease-context/1"},
    "schema_version": {"type": "integer", "const": 1},
    "context_id": {"type": "string", "minLength": 1},
    "lease_id": {"type": "string", "minLength": 1},
    "grant_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "const": "aq-f2.5-slot-queue"},
    "principal": {"type": "string", "minLength": 1},
    "dispatch_mode": {"type": "string", "minLength": 1},
    "action_class": {"type": "string", "minLength": 1},
    "trust_tier": {"type": "integer", "minimum": 0},
    "policy_revision": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revocation_epoch": {"type": "integer", "minimum": 0},
    "issuer_key_id": {"type": "string", "minLength": 1},
    "sig_scheme": {"type": "string", "const": "ed25519"},
    "signature": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
