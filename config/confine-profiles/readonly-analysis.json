{
  "schema": "aq-confine-profile/1",
  "name": "readonly-analysis",
  "description": "Read-only inputs plus one caller-provided scratch dir; no network, no git.",
  "needs_worktree": false,
  "net_ceiling": "none",
  "net_default": "none",
  "ro_system": [
    "/nix/store",
    "/usr",
    "/bin",
    "/lib",
    "/lib64",
    "/etc/alternatives"
  ],
  "path_from_system": [
    "python3",
    "sh",
    "env",
    "ls",
    "cat"
  ],
  "home": "/home/aq",
  "tmp": "tmpfs",
  "rw_allowed_roots": [],
  "git": "none",
  "git_refs": "namespace",
  "strict_history": false,
  "egress": {
    "mode": "none",
    "grantable": [],
    "services": []
  },
  "guidance": true,
  "env_base": {
    "LANG": "C.UTF-8"
  },
  "env_allow": [
    "LANG",
    "TZ"
  ],
  "limits": {
    "cpu": 300,
    "as": 4294967296,
    "fsize": 1073741824,
    "core": 0
  },
  "size_caps": {
    "quarantine": 536870912,
    "worktree": 2147483648
  },
  "timeout_s": 300,
  "unshare": [
    "all"
  ],
  "disable_userns": true,
  "readonly_root": true,
  "ro_allowed_roots": [
    "${REPO}",
    "${AQ_DELEGATION_DIR}",
    "/tmp",
    "/var/tmp"
  ],
  "tmp_size": 67108864,
  "home_size": 134217728,
  "scratch": true
}
