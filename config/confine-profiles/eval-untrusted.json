{
  "schema": "aq-confine-profile/1",
  "name": "eval-untrusted",
  "description": "Model-generated code: tmpfs /tmp only, no network, tight limits.",
  "needs_worktree": false,
  "net_ceiling": "none",
  "net_default": "none",
  "ro_system": [
    "/nix/store",
    "/usr",
    "/bin",
    "/lib",
    "/lib64",
    "/etc/alternatives"
  ],
  "path_from_system": [
    "python3",
    "sh",
    "env"
  ],
  "home": "/home/aq",
  "tmp": "tmpfs",
  "rw_allowed_roots": [],
  "git": "none",
  "git_refs": "namespace",
  "strict_history": false,
  "egress": {
    "mode": "none",
    "grantable": [],
    "services": []
  },
  "guidance": true,
  "env_base": {
    "LANG": "C.UTF-8"
  },
  "env_allow": [
    "LANG"
