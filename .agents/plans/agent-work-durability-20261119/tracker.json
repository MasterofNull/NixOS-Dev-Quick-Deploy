      "id": "d",
      "name": "D: durability MVP",
      "goal": "S0-S7",
      "order": 1
    },
    {
      "id": "d2",
      "name": "D2: coordinator + housekeeping",
      "goal": "after MVP phase proves out",
      "order": 2
    }
  ],
