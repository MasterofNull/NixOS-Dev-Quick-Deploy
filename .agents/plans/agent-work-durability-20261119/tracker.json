{
  "plan": {
    "id": "agent-work-durability-20261119",
    "title": "Agent work durability across reboots, restarts and crashes",
    "prd_ref": ".agents/plans/agent-work-durability-20261119/DESIGN.md",
    "owner": "hyperd",
    "goal": "No token-costly agent work lives only in tmpfs or process memory; unfinished dispatches resume from disk after reboot.",
    "success_criteria": [
      "J1-J6 in DESIGN.md pass with real reboots/restarts",
      "aq-reboot-ready gives a correct GO/NO-GO",
      "no work-state path under /tmp in agent tooling or coordinator"
    ]
  },
  "phases": [
