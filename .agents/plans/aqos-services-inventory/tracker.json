{
  "plan": {
    "id": "aqos-services-inventory",
    "title": "AQ-OS Services — honest integration/validation inventory",
    "prd_ref": "nix/modules/services/",
    "owner": "hyperd",
    "goal": "Every systemd service the AQ-OS refactor ships, marked on the honest tier scale — DEFINED (unit exists) -> INTEGRATED (enabled + wired + not-failed) -> VALIDATED (actually ran + did its job) -> ACCEPTED (owner signed off). Nothing reads complete until VALIDATED + owner-accepted.",
    "success_criteria": [
      "Every ai-*/lore/nvd service categorized honestly; no 'complete' without a verified successful run",
      "DB-management, health, security, learning, and sync tasks proven functional (not just scheduled)",
      "Owner sign-off recorded per domain before it counts as done"
    ],
    "tier_model": "DEFINED=unit exists; INTEGRATED=enabled+timer/active+not-failed; VALIDATED=confirmed successful run doing its real job; ACCEPTED=owner signed off. `acceptance.status` must be 'accepted' AND status VALIDATED for an item to be complete.",
    "detection_note": "Status here is editorial-honest pending a systemd-detection projector extension (aq-pm-tracker to read `systemctl is-enabled`/`show -p Result -p ActiveEnterTimestamp`). pct_hint encodes the CURRENT verified tier; it will be replaced by live projection. NOT a hand-typed 'done' — it is a hand-recorded 'not-yet-validated'."
  },
  "phases": [
    {"id": "core", "name": "Core runtime (always-on)", "goal": "the services that must stay running", "order": 1},
    {"id": "dbmgmt", "name": "Agent DB management + cleanup", "goal": "aidb reindex, session crystallization, vector bootstrap", "order": 2},
    {"id": "health", "name": "Health + monitoring", "goal": "spider, stack-health, process-watch, metrics", "order": 3},
    {"id": "security", "name": "Security + audit", "goal": "security-audit, npm-monitor, mcp-integrity, audit-sidecar", "order": 4},
    {"id": "learning", "name": "Learning + training", "goal": "autonomous-improvement, training-ingest, prompt-eval, optimizer", "order": 5},
    {"id": "sync", "name": "Sync + ingest", "goal": "lore, nvd, knowledge-sources, gap/instruction import", "order": 6}
  ],
