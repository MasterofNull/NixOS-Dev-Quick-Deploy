{
  "mcpServers": {
    "lean-ctx": {
      "command": "/run/current-system/sw/bin/lean-ctx",
      "args": [
        "mcp"
      ]
    },
    "hybrid-coordinator": {
      "command": "python3",
      "args": [
        "/home/hyperd/Documents/NixOS-Dev-Quick-Deploy/scripts/ai/mcp-bridge-hybrid.py"
      ],
      "env": {
        "HYBRID_URL": "http://127.0.0.1:8003",
        "AIDB_URL": "http://127.0.0.1:8002",
        "REPO_ROOT": "/home/hyperd/Documents/NixOS-Dev-Quick-Deploy"
      }
    },
    "semgrep": {
      "command": "/run/current-system/sw/bin/semgrep",
      "args": [
        "mcp",
        "--transport",
        "stdio"
      ],
      "env": {
        "SEMGREP_MCP_DISABLE_TRACING": "true",
        "SEMGREP_SEND_METRICS": "off"
      }
    }
  }
}
