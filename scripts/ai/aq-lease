#!/usr/bin/env python3
"""aq-lease — CapabilityLease CLI (Foundation C0, report-only, zero enforcement).

Subcommands: new, verify, inspect, attenuate. Read-only w.r.t. the system —
no service calls, no writes outside an explicit `--out`. See
`.agents/plans/aqos-foundation-c/C0-IMPLEMENTATION-SPEC.md` for the spec.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any

_HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(_HERE / "lib"))

from capability_lease import (  # noqa: E402
    DEV_KEY_BANNER,
    attenuate as lease_attenuate,
    epoch_stale,
    is_expired,
    lease_from_spec,
    resolve_key,
    verify as lease_verify,
)


def _read_spec(path: str) -> dict[str, Any]:
    if path == "-":
        return json.loads(sys.stdin.read())
    return json.loads(Path(path).read_text(encoding="utf-8"))


def _load_lease(path: str) -> dict[str, Any]:
    return json.loads(Path(path).read_text(encoding="utf-8"))


def _resolve_key(explicit_path: str | None) -> tuple[bytes, bool]:
    if explicit_path:
        raw = Path(explicit_path).read_bytes().strip()
        if not raw:
            raise SystemExit(f"aq-lease: key file is empty: {explicit_path}")
        return raw, False
    return resolve_key()


def _maybe_banner(is_dev: bool) -> None:
    if is_dev:
        print(f"aq-lease: {DEV_KEY_BANNER}", file=sys.stderr)


def _emit(obj: Any, as_json: bool, out: str | None) -> None:
    text = json.dumps(obj, indent=2, sort_keys=True)
    if out:
        Path(out).write_text(text + "\n", encoding="utf-8")
        print(f"aq-lease: wrote {out}", file=sys.stderr)
        return
    if as_json:
        print(text)
    else:
        print(text)


def cmd_new(args: argparse.Namespace) -> int:
    spec = _read_spec(args.spec)
    key, is_dev = _resolve_key(args.key)
    _maybe_banner(is_dev)
    try:
        lease = lease_from_spec(spec, key)
    except ValueError as exc:
        print(f"aq-lease: new: {exc}", file=sys.stderr)
        return 1
    _emit(lease.to_dict(), args.json, args.out)
    return 0


def cmd_verify(args: argparse.Namespace) -> int:
    data = _load_lease(args.lease_file)
    key, is_dev = _resolve_key(args.key)
    _maybe_banner(is_dev)
    verdict = lease_verify(data, key, current_epoch=args.current_epoch)
    if args.json:
        print(json.dumps({"verdict": verdict}, sort_keys=True))
    else:
        print(verdict)
    return 0 if verdict == "ok" else 2


def cmd_inspect(args: argparse.Namespace) -> int:
    data = _load_lease(args.lease_file)
    report = {
        "lease_id": data.get("lease_id"),
        "parent_lease_id": data.get("parent_lease_id"),
        "issued_to": data.get("issued_to"),
        "issued_at": data.get("issued_at"),
        "expires_at": data.get("expires_at"),
        "is_expired": is_expired(data) if "expires_at" in data else None,
        "revocation_epoch": data.get("revocation_epoch"),
        "trust_tier": data.get("trust_tier"),
        "zero_trust_behavior": data.get("zero_trust_behavior"),
        "permissions": data.get("permissions"),
    }
    if args.current_epoch is not None and "revocation_epoch" in data:
        report["epoch_stale_vs_current"] = epoch_stale(data, args.current_epoch)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        for k, v in report.items():
            print(f"{k}: {v}")
    return 0


def cmd_attenuate(args: argparse.Namespace) -> int:
    parent = _load_lease(args.parent)
    delta = _read_spec(args.delta)
    key, is_dev = _resolve_key(args.key)
    _maybe_banner(is_dev)
    try:
        child = lease_attenuate(parent, delta, key=key)
    except ValueError as exc:
        print(f"aq-lease: attenuate: rejected (would widen): {exc}", file=sys.stderr)
        return 1
    _emit(child.to_dict(), args.json, args.out)
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="aq-lease",
        description="CapabilityLease CLI (report-only, C0 — no enforcement).",
    )
    sub = p.add_subparsers(dest="command", required=True)

    p_new = sub.add_parser("new", help="build + sign a lease from a spec")
    p_new.add_argument("--spec", required=True, help="spec file, or '-' for stdin")
    p_new.add_argument("--key", help="path to signing key file")
    p_new.add_argument("--json", action="store_true", help="force JSON output")
    p_new.add_argument("--out", help="write result to this path instead of stdout")
    p_new.set_defaults(func=cmd_new)

    p_verify = sub.add_parser("verify", help="typed verdict for a lease file")
    p_verify.add_argument("lease_file")
    p_verify.add_argument("--key", help="path to signing key file")
    p_verify.add_argument("--current-epoch", type=int, default=None)
    p_verify.add_argument("--json", action="store_true")
    p_verify.set_defaults(func=cmd_verify)

    p_inspect = sub.add_parser("inspect", help="pretty-print a lease")
    p_inspect.add_argument("lease_file")
    p_inspect.add_argument("--current-epoch", type=int, default=None)
    p_inspect.add_argument("--json", action="store_true")
    p_inspect.set_defaults(func=cmd_inspect)

    p_att = sub.add_parser("attenuate", help="emit a signed child lease")
    p_att.add_argument("parent")
    p_att.add_argument("--delta", required=True, help="delta spec file, or '-' for stdin")
    p_att.add_argument("--key", help="path to signing key file")
    p_att.add_argument("--json", action="store_true")
    p_att.add_argument("--out", help="write result to this path instead of stdout")
    p_att.set_defaults(func=cmd_attenuate)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
