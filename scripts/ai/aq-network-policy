#!/usr/bin/env python3
"""aq-network-policy — read-only CLI facade for Network Profile Interoperability.

PRD: .agent/PROJECT-NETWORK-PROFILE-INTEROPERABILITY-PRD.md
Slice: N1 (passive projection and Service Coverage)

Provides status, health inspection, JSON projection, and passive observation.
Mutation verbs are prohibited by contract.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

# Locate repo root
_REPO = Path(__file__).resolve().parents[2]
if str(_REPO) not in sys.path:
    sys.path.insert(0, str(_REPO))

try:
    from scripts.ai.lib.network_dns_policy import (
        acquire_and_publish_health,
        execute_policy_transaction,
        is_valid_interface,
        read_health,
        replace_trust_map,
        run_emergency_revert,
        run_watchdog_or_recovery,
        validate_health,
    )
except ImportError:
    # If installed in system path
    from network_dns_policy import (  # type: ignore
        acquire_and_publish_health,
        execute_policy_transaction,
        is_valid_interface,
        read_health,
        replace_trust_map,
        run_emergency_revert,
        run_watchdog_or_recovery,
        validate_health,
    )

PROHIBITED_VERBS = {
    "apply",
    "revert",
    "set",
    "modify",
    "write",
    "delete",
    "mutate",
    "update",
    "override",
}


def cmd_status(args: argparse.Namespace) -> int:
    """Print human-readable summary of health projection."""
    health_path = Path(args.path) if args.path else None
    data = read_health(health_path)

    print(f"Network DNS Policy Status:")
    print(f"  Schema:       {data.get('schema_version', 'unknown')}")
    print(f"  State:        {data.get('policy_state', 'unknown')}")
    print(f"  Connectivity: {data.get('connectivity', 'unknown')}")
    print(f"  Reason:       {data.get('reason', 'unknown')}")
    print(f"  Freshness:    {data.get('freshness', 'unknown')}")
    print(f"  Lease:        {data.get('lease', 'unknown')}")
    print(f"  Age:          {data.get('last_transition_age', 'unknown')}")
    print(f"  Transitions:  {data.get('transition_count_bucket', 'unknown')}")
    print(f"  Acq Error:    {data.get('acquisition_error', 'unknown')}")
    return 0


def cmd_health(args: argparse.Namespace) -> int:
    """Print JSON representation and return 0 if valid."""
    health_path = Path(args.path) if args.path else None
    data = read_health(health_path)
    ok, err = validate_health(data)
    print(json.dumps(data, indent=2, sort_keys=True))
    if not ok:
        sys.stderr.write(f"Health validation failed: {err}\n")
        return 1
    return 0


def cmd_json(args: argparse.Namespace) -> int:
    """Print raw JSON health projection."""
    health_path = Path(args.path) if args.path else None
    data = read_health(health_path)
    print(json.dumps(data, indent=2, sort_keys=True))
    return 0


def cmd_observe(args: argparse.Namespace) -> int:
    """Execute bounded passive observation and publish health projection."""
    iface = args.iface
    if iface and not is_valid_interface(iface):
        sys.stderr.write(f"Error: unsafe or invalid interface name '{iface}'\n")
        return 1

    health_path = Path(args.path) if args.path else None
    lock_path = Path(args.lock_path) if args.lock_path else None
    sysfs_base = Path(args.sysfs_base) if args.sysfs_base else None

    pub_ok, record = acquire_and_publish_health(
        iface=iface,
        health_path=health_path,
        lock_path=lock_path,
        sysfs_base=sysfs_base,
    )
    if args.json:
        print(json.dumps(record, indent=2, sort_keys=True))
    else:
        print(f"Observed network policy: state={record.get('policy_state')}, published={pub_ok}")
    return 0 if pub_ok else 1


def cmd_trust_replace(args: argparse.Namespace) -> int:
    """Root-only, activation-gated trust map replacement interface."""
    import os

    n3_activated = os.environ.get("AQ_NETWORK_POLICY_N3_ACTIVATED", "0") == "1" or getattr(args, "n3_canary", False)
    if not n3_activated:
        if getattr(args, "machine", False):
            print(json.dumps({"result": "invalid_input", "error": "blocked_until_n3"}, indent=2))
        else:
            sys.stderr.write("Error: trust replacement interface is blocked until N3 activation.\n")
        return 2

    input_path = Path(args.input)
    target_path = Path(args.target) if getattr(args, "target", None) else None
    lock_path = Path(args.lock_path) if getattr(args, "lock_path", None) else None
    check_privileges = not getattr(args, "no_privilege_check", False)

    result, exit_code = replace_trust_map(
        input_path,
        target_path=target_path,
        lock_path=lock_path,
        check_privileges=check_privileges,
    )
    if getattr(args, "machine", False):
        print(json.dumps({"result": result.value}, indent=2))
    else:
        print(f"Trust map replacement: {result.value}")
    return exit_code


def cmd_watchdog(args: argparse.Namespace) -> int:
    mode = getattr(args, "mode", "policy")
    receipt_path = Path(args.receipt_path) if getattr(args, "receipt_path", None) else None
    effect_lock_path = Path(args.lock_path) if getattr(args, "lock_path", None) else None
    health_path = Path(args.health_path) if getattr(args, "health_path", None) else None

    ok = run_watchdog_or_recovery(
        mode=mode,
        receipt_path=receipt_path,
        effect_lock_path=effect_lock_path,
        health_path=health_path,
    )
    return 0 if ok else 1


def cmd_emergency_revert(args: argparse.Namespace) -> int:
    receipt_path = Path(args.receipt_path) if getattr(args, "receipt_path", None) else None
    health_path = Path(args.health_path) if getattr(args, "health_path", None) else None

    ok = run_emergency_revert(receipt_path=receipt_path, health_path=health_path)
    return 0 if ok else 1


def cmd_execute(args: argparse.Namespace) -> int:
    iface = args.iface
    event = args.action
    mode = getattr(args, "mode", "legacy")
    receipt_path = Path(args.receipt_path) if getattr(args, "receipt_path", None) else None
    effect_lock_path = Path(args.lock_path) if getattr(args, "lock_path", None) else None
    health_path = Path(args.health_path) if getattr(args, "health_path", None) else None

    ok, dec = execute_policy_transaction(
        iface,
        event=event,
        mode=mode,
        receipt_path=receipt_path,
        effect_lock_path=effect_lock_path,
        health_path=health_path,
    )
    if getattr(args, "json", False):
        print(json.dumps(dec, indent=2, sort_keys=True))
    return 0 if ok else 1


def main() -> int:
    for arg in sys.argv[1:]:
        if arg.lower() in PROHIBITED_VERBS:
            sys.stderr.write(f"Error: mutation verb '{arg}' is strictly prohibited in read-only facade.\n")
            return 2

    parser = argparse.ArgumentParser(
        description="aq-network-policy: machine facade for Network Profile Interoperability",
    )
    subparsers = parser.add_subparsers(dest="command", help="Subcommand")

    # status
    p_status = subparsers.add_parser("status", help="Show human-readable health summary")
    p_status.add_argument("--path", help="Override health file path", default=None)

    # health
    p_health = subparsers.add_parser("health", help="Validate and output health JSON")
    p_health.add_argument("--path", help="Override health file path", default=None)

    # json
    p_json = subparsers.add_parser("json", help="Output health JSON projection")
    p_json.add_argument("--path", help="Override health file path", default=None)

    # observe
    p_observe = subparsers.add_parser("observe", help="Perform passive bounded observation")
    p_observe.add_argument("iface", nargs="?", help="Interface to observe (default: auto-detected Wi-Fi)", default=None)
    p_observe.add_argument("--path", help="Override health file path", default=None)
    p_observe.add_argument("--lock-path", help="Override lock file path", default=None)
    p_observe.add_argument("--sysfs-base", help="Override sysfs base directory (testing)", default=None)
    p_observe.add_argument("--json", action="store_true", help="Output result as JSON")

    # trust
    p_trust = subparsers.add_parser("trust", help="Trust map management")
    trust_subs = p_trust.add_subparsers(dest="trust_command", help="Trust subcommand")
    p_trust_replace = trust_subs.add_parser("replace", help="Replace trusted profile map")
    p_trust_replace.add_argument("--input", required=True, help="Input trusted profiles JSON file")
    p_trust_replace.add_argument("--target", help="Override target path", default=None)
    p_trust_replace.add_argument("--lock-path", help="Override lock file path", default=None)
    p_trust_replace.add_argument("--machine", action="store_true", help="Machine JSON output")
    p_trust_replace.add_argument("--no-privilege-check", action="store_true", help="Skip root check (testing)")
    p_trust_replace.add_argument("--n3-canary", action="store_true", help="Owner N3 canary activation flag")

    # watchdog
    p_watchdog = subparsers.add_parser("watchdog", help="Run periodic watchdog / recovery check")
    p_watchdog.add_argument("--mode", choices=["legacy", "policy"], default="policy", help="Operation mode")
    p_watchdog.add_argument("--receipt-path", help="Override receipt path", default=None)
    p_watchdog.add_argument("--lock-path", help="Override lock path", default=None)
    p_watchdog.add_argument("--health-path", help="Override health path", default=None)

    # emergency-revert
    p_em_revert = subparsers.add_parser("emergency-revert", help="Run emergency fallback revert")
    p_em_revert.add_argument("--receipt-path", help="Override receipt path", default=None)
    p_em_revert.add_argument("--health-path", help="Override health path", default=None)

    # execute
    p_execute = subparsers.add_parser("execute", help="Execute network policy action")
    p_execute.add_argument("iface", help="Network interface")
    p_execute.add_argument("action", help="Event/action (up, down, dhcp4-change, etc.)")
    p_execute.add_argument("--mode", choices=["legacy", "policy"], default="legacy", help="Operation mode")
    p_execute.add_argument("--receipt-path", help="Override receipt path", default=None)
    p_execute.add_argument("--lock-path", help="Override lock path", default=None)
    p_execute.add_argument("--health-path", help="Override health path", default=None)
    p_execute.add_argument("--json", action="store_true", help="JSON output")

    args = parser.parse_args()

    if not args.command or args.command == "status":
        return cmd_status(args)
    elif args.command == "health":
        return cmd_health(args)
    elif args.command == "json":
        return cmd_json(args)
    elif args.command == "observe":
        return cmd_observe(args)
    elif args.command == "trust":
        if getattr(args, "trust_command", None) == "replace":
            return cmd_trust_replace(args)
        p_trust.print_help()
        return 1
    elif args.command == "watchdog":
        return cmd_watchdog(args)
    elif args.command == "emergency-revert":
        return cmd_emergency_revert(args)
    elif args.command == "execute":
        return cmd_execute(args)
    else:
        parser.print_help()
        return 1


if __name__ == "__main__":
    sys.exit(main())
