#!/usr/bin/env python3
"""CLI for hermetic candidate evaluation evidence (ECC P0-D)."""

from __future__ import annotations
try:  # aq-usage-hook
    import importlib.util as _aqu, os as _aqo
    _aqs = _aqu.spec_from_file_location("aq_usage", _aqo.path.join(_aqo.path.dirname(_aqo.path.realpath(__file__)), "lib", "aq_usage.py"))
    _aqm = _aqu.module_from_spec(_aqs); _aqs.loader.exec_module(_aqm); _aqm.record(__file__, __name__)
except Exception:
    pass

import argparse
import json
from pathlib import Path
import sys

REPO_ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO_ROOT / "scripts" / "ai" / "lib"))

import hermetic_candidate_eval as hce  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description="Hermetic candidate evaluation CLI (ECC P0-D)")
    subparsers = parser.add_subparsers(dest="command")

    # summary
    summary_p = subparsers.add_parser("summary", help="Show hermetic evaluation capability summary")
    summary_p.add_argument("--json", action="store_true", help="Output in JSON format")

    # verify
    verify_p = subparsers.add_parser("verify", help="Verify evaluation receipt fail-closed")
    verify_p.add_argument("receipt", type=Path, help="Path to receipt JSON file")
    verify_p.add_argument("--artifact", type=Path, default=None, help="Path to expected artifact")
    verify_p.add_argument("--json", action="store_true", help="Output in JSON format")

    # evaluate
    eval_p = subparsers.add_parser("evaluate", help="Generate hermetic evaluation receipt")
    eval_p.add_argument("artifact", type=Path, help="Path to candidate artifact")
    eval_p.add_argument("--candidate-id", required=True, help="Candidate identifier")
    eval_p.add_argument("--backend", default="mock", choices=["bwrap", "mock", "process"], help="Containment backend")
    eval_p.add_argument("--reviewer-role", default="reviewer", help="Role of independent reviewer")
    eval_p.add_argument("--reviewer-verdict", default="HOLD", choices=["PROMOTED", "REJECTED", "HOLD"], help="Reviewer verdict")
    eval_p.add_argument("--json", action="store_true", help="Output in JSON format")

    args = parser.parse_args()

    if args.command == "summary":
        summary = hce.dashboard_summary(REPO_ROOT)
        if args.json:
            print(json.dumps(summary, indent=2))
        else:
            print(f"Hermetic Candidate Evaluation: status={summary['status']}, real={summary['real_receipts']}, simulated={summary['simulated_receipts']}, policy={summary['policy']}")
        return 0

    elif args.command == "verify":
        try:
            if not args.receipt.is_file():
                print(f"Receipt file not found: {args.receipt}", file=sys.stderr)
                return 1
            receipt = json.loads(args.receipt.read_text(encoding="utf-8"))
            result = hce.verify_evaluation_receipt(receipt, expected_artifact_path=args.artifact)
            if args.json:
                print(json.dumps(result, indent=2))
            else:
                print(f"Verified receipt for candidate '{result['candidate_id']}': verdict={result['verdict']}")
            return 0
        except hce.HermeticEvalError as err:
            if args.json:
                print(json.dumps({"status": "failed", "reason": err.reason, "error": str(err)}, indent=2))
            else:
                print(f"FAIL-CLOSED: {err}", file=sys.stderr)
            return 1

    elif args.command == "evaluate":
        if args.backend != "mock":
            print("No real executor is available (deferred to the shared aq-confine launcher); only --backend mock (simulated) is supported.", file=sys.stderr)
            return 1
        try:
            containment = {
                "backend": args.backend,
                "network": "none",
                "read_only_paths": ["/"],
                "writable_tmp": "/tmp/sandbox",
                "memory_limit_mb": 512,
                "timeout_seconds": 30,
            }
            # NOTE: no real executor exists yet (deferred to the shared aq-confine
            # launcher). This result is a literal placeholder: the receipt is
            # marked simulated and can never be PROMOTED.
            exec_result = {
                "exit_code": 0,
                "duration_ms": 12.5,
                "peak_memory_mb": 42.0,
                "stdout": "Candidate evaluation passed hermetic tests.\n",
                "stderr": "",
                "escape_detected": False,
                "secret_detected": False,
                "network_attempted": False,
                "write_violation": False,
                "timeout_hit": False,
            }
            reviewer = {
                "reviewer_role": args.reviewer_role,
                "reviewer_verdict": args.reviewer_verdict,
                "signature_ref": f"unsigned:{args.candidate_id}",  # opaque; not verified
                "promoted_at": None,
            }
            receipt = hce.build_evaluation_receipt(
                artifact_path=args.artifact,
                candidate_id=args.candidate_id,
                containment_config=containment,
                execution_result=exec_result,
                reviewer_promotion=reviewer,
            )
            if args.json:
                print(json.dumps(receipt, indent=2))
            else:
                print(f"Evaluation receipt generated for '{args.candidate_id}' [digest: {receipt['receipt_digest']}]")
            return 0
        except hce.HermeticEvalError as err:
            print(f"Evaluation error: {err}", file=sys.stderr)
            return 1

    else:
        parser.print_help(sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
