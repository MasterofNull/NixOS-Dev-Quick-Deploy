#!/usr/bin/env python3
"""PostToolUse hook for Claude Code / harness agents.

Appends lightweight execution heartbeat to PULSE.log if write/edit occurred.
Latency budget: < 100 ms.
"""
import datetime
import os
import sys
from pathlib import Path

def main():
    repo_root = Path(os.environ.get("CLAUDE_PROJECT_DIR", Path(__file__).resolve().parent.parent.parent))
    tool_name = os.environ.get("CLAUDE_TOOL_NAME", "")
    if tool_name in ("Write", "Edit", "replace", "write_file", "mcp__lean-ctx__ctx_edit"):
        pulse_log = repo_root / ".agent" / "collaboration" / "PULSE.log"
        if pulse_log.parent.is_dir():
            ts = datetime.datetime.now(datetime.timezone.utc).isoformat()
            try:
                with open(pulse_log, "a", encoding="utf-8") as f:
                    f.write(f"[{ts}] [claude-hook] [post-tool]: {tool_name} executed\n")
            except Exception:
                pass
    return 0

if __name__ == "__main__":
    sys.exit(main())
