#!/usr/bin/env python3
"""aq-pm-tracker — project a plan's PM status from GROUND TRUTH (SSOT: .agents/plans/pm-tracker-standard/DESIGN.md).

Reads `<plan-dir>/tracker.json` (the editorial manifest: goals, deps, validation goals, detection signals).
STATUS is always PROJECTED from git commits + freeze records + activation grants + blocker notes — NEVER
hand-typed (hand-maintained status rots; this is the anti-gaming design). Generalizes aq-refactor-status.

Modes:
  aq-pm-tracker <plan-dir>            human summary (default)
  aq-pm-tracker <plan-dir> --json     projected data (JSON)
  aq-pm-tracker <plan-dir> --check    validate manifest + project; exit 0 ok / 1 on manifest error
  aq-pm-tracker --all                 aggregate human summary across every .agents/plans/*/tracker.json
  aq-pm-tracker --all-json            aggregate projection (JSON): {generated_at, plans[], program_rollup_pct}
Status precedence: ACTIVATED > SHIPPED > BLOCKED > FROZEN > IN-PROGRESS > DESIGNED > NOT-STARTED.
UNVERIFIED (untrusted-author hold): an item that would project SHIPPED/ACTIVATED but whose commit evidence
comes ONLY from `(#N)` squash commits listed in config/pm-tracker-untrusted-provenance.json is capped at
UNVERIFIED until a valid independent review receipt or a later trusted commit clears it (see DESIGN.md).
`source_health` is a closed provenance signal: complete, shallow_incomplete,
or unavailable. A read path never deepens, fetches, or otherwise mutates git.
"""
from __future__ import annotations
try:  # aq-usage-hook
    import importlib.util as _aqu, os as _aqo
    _aqs = _aqu.spec_from_file_location("aq_usage", _aqo.path.join(_aqo.path.dirname(_aqo.path.realpath(__file__)), "lib", "aq_usage.py"))
    _aqm = _aqu.module_from_spec(_aqs); _aqs.loader.exec_module(_aqm); _aqm.record(__file__, __name__)
except Exception:
    pass
import json
import os
import re
import subprocess
import sys
from datetime import date, datetime, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
_CACHE_DIR = REPO / ".agents" / "cache"
_GIT_LOG_CACHE_PATHS = (
    _CACHE_DIR / "pm-git-log.cache",
    Path("/var/lib/nixos-system-dashboard/telemetry/pm-git-log.cache"),
)
_STATUS_PCT_FLOOR = {"ACTIVATED": 100, "SHIPPED": 100, "BLOCKED": 0, "FROZEN": 20,
                     "UNVERIFIED": 40, "IN-PROGRESS": 50, "DESIGNED": 10, "NOT-STARTED": 0}
_UNVERIFIED_PCT = _STATUS_PCT_FLOOR["UNVERIFIED"]
UNTRUSTED_CONFIG = REPO / "config" / "pm-tracker-untrusted-provenance.json"
_PR_SUBJECT = re.compile(r"\(#(\d+)\)\s*$")
_RECEIPT_OK_VERDICTS = ("PASS", "PASS_WITH_FOLLOWUPS")
_SOURCE_HEALTH = frozenset(("complete", "shallow_incomplete", "unavailable"))


def _save_git_log_cache(content: str) -> None:
    if not content:
        return
    for path in _GIT_LOG_CACHE_PATHS:
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content, encoding="utf-8")
        except Exception:
            pass


def _fallback_git_log() -> tuple[str, str]:
    # Allow cache fallback when in dashboard context or when explicitly permitted
    allow_cache = (
        os.environ.get("AQ_PM_ALLOW_CACHE") == "1"
        or os.environ.get("DASHBOARD_MODE") is not None
    )
    if allow_cache:
        for path in _GIT_LOG_CACHE_PATHS:
            try:
                if path.is_file():
                    cached = path.read_text(encoding="utf-8")
                    if cached.strip():
                        return cached, "complete"
            except Exception:
                pass
    return "", "unavailable"


def _git_log() -> tuple[str, str]:
    """Return bounded read-only commit evidence and its provenance state.

    Dashboard reads must never repair a clone. `--no-optional-locks` and the
    environment setting keep git from creating optional lock files; shallow or
    unavailable history is represented in the projection instead of hidden.
    """
    git_env = {**os.environ, "GIT_OPTIONAL_LOCKS": "0"}
    try:
        shallow_result = subprocess.run(
            ["git", "--no-optional-locks", "-C", str(REPO), "rev-parse", "--is-shallow-repository"],
            capture_output=True, text=True, timeout=10, env=git_env,
        )
        if shallow_result.returncode != 0:
            return _fallback_git_log()
        shallow_value = shallow_result.stdout.strip()
        if shallow_value not in ("true", "false"):
            return _fallback_git_log()
        log_result = subprocess.run(
            ["git", "--no-optional-locks", "-C", str(REPO), "log", "--oneline", "-n", "5000"],
            capture_output=True, text=True, timeout=30, env=git_env,
        )
        if log_result.returncode != 0:
            return _fallback_git_log()
    except Exception:
        return _fallback_git_log()
    health = "shallow_incomplete" if shallow_value == "true" else "complete"
    if health == "complete" and log_result.stdout:
        _save_git_log_cache(log_result.stdout)
    return log_result.stdout, health


# Slice 1: fixed owner-controlled locations (slice 2 provisions them; absent => chain-invalid => no ACTIVATED).
# Deliberately no env/CLI override: a checkout-controlled path would let an agent point at its own chain.
_ACTIVATION_LOG_DIR = Path("/var/lib/aq-activation/log")
_ACTIVATION_HEAD = Path("/var/lib/aq-activation/head")
_ACTIVATION_SIGNERS = Path("/etc/aq-activation/signers.json")
_ACTIVATION_DEPLOYMENT_ID = Path("/etc/aq-activation/deployment-id")   # slice 2 provisions it from Nix; absent => fail closed
_ACTIVATION_ATTESTATIONS = REPO / ".agents" / "activation" / "attestations"


def _activation_chain():
    sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
    try:
        import activation_chain
    finally:
        sys.path.pop(0)
    return activation_chain


def _load_activation_ctx() -> dict:
    """Chain state + deployed closure, read once per projection. Any failure yields a blocked state."""
    ac = _activation_chain()
    try:
        signers = json.loads(_ACTIVATION_SIGNERS.read_text(encoding="utf-8")).get("keys", [])
        if not isinstance(signers, list):
            signers = []
    except (OSError, ValueError, AttributeError):
        signers = []
    try:
        dep = _ACTIVATION_DEPLOYMENT_ID.read_text(encoding="utf-8").strip()
    except OSError:
        dep = ""
    if not signers:
        state = ac.ChainState(reason="signer allowlist missing/empty")
    else:
        state = ac.load_chain(_ACTIVATION_LOG_DIR, _ACTIVATION_HEAD, signers, dep)
    return {"ac": ac, "state": state, "closure": os.path.realpath("/run/current-system"),
            "claimed": _ACTIVATION_LOG_DIR.is_dir()}


def _signed_attestation_hash(plan: str, item_id: str, signed_sha: str) -> str | None:
    """Hash of the on-disk attestation file the grant named (<id>-<sha12>.md); None when absent."""
    import hashlib
    path = _ACTIVATION_ATTESTATIONS / plan / f"{item_id}-{signed_sha[:12]}.md"
    try:
        return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() and not path.is_symlink() else None
    except OSError:
        return None


def _item_activation(item: dict, plan: str, ctx: dict | None) -> tuple[bool, str]:
    """(verified, reason). `verified` comes ONLY from activation_chain.activation_verified; `reason` is
    activation_status (activated | none | revoked | grant-stale | chain-invalid | no-subject)."""
    subj = (item.get("detection") or {}).get("activation_subject")
    if not ctx or not subj:
        return False, "no-subject"
    ac = ctx["ac"]
    iid = str(item.get("id"))
    st = ctx["state"].items.get(ac.item_key(plan, iid, subj))
    view = {"plan": plan, "item_id": iid, "subject": subj,
            "attestation_sha256": _signed_attestation_hash(plan, iid, st.attestation_sha256) if st else None}
    return ac.activation_verified(view, ctx["state"], ctx["closure"]), ac.activation_status(view, ctx["state"], ctx["closure"])


def _activation_flags(item: dict, plan: str, ctx: dict | None) -> dict:
    """Rev7 reporting: activation_stale (closure/attestation changed) and grants_unverified (a chain exists
    on disk but failed verification, so any grant in it is ignored)."""
    _, reason = _item_activation(item, plan, ctx)
    return {"activation_stale": reason == "grant-stale",
            "grants_unverified": reason == "chain-invalid" and bool(ctx and ctx.get("claimed"))}


_SYSTEMD_CACHE: dict = {}


def _systemd_state(unit: str) -> dict:
    """Read a unit's ground-truth state (cached, bounded). Empty on any error so a
    missing `systemctl` (e.g. in CI) never breaks projection — it just falls back."""
    if unit in _SYSTEMD_CACHE:
        return _SYSTEMD_CACHE[unit]
    d: dict = {}
    try:
        out = subprocess.run(
            ["systemctl", "show", unit, "-p", "ActiveState", "-p", "Result",
             "-p", "ActiveEnterTimestamp", "-p", "ExecMainStartTimestamp",
             "-p", "InactiveExitTimestamp", "-p", "UnitFileState"],
            capture_output=True, text=True, timeout=8).stdout
        for line in out.splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                d[k] = v.strip()
    except Exception:
        pass
    _SYSTEMD_CACHE[unit] = d
    return d


def _systemd_timer_state(unit: str) -> dict:
    """Read a timer's ground-truth state (cached, bounded). Used to detect whether
    a oneshot service's associated timer has ever triggered (when timestamps are
    empty but service has Result=success). Empty on any error."""
    timer_unit = unit.replace(".service", ".timer") if unit.endswith(".service") else unit + ".timer"
    cache_key = f"timer:{timer_unit}"
    if cache_key in _SYSTEMD_CACHE:
        return _SYSTEMD_CACHE[cache_key]
    d: dict = {}
    try:
        out = subprocess.run(
            ["systemctl", "show", timer_unit, "-p", "LastTriggerUSec", "-p", "Result"],
            capture_output=True, text=True, timeout=8).stdout
        for line in out.splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                d[k] = v.strip()
    except Exception:
        pass
    _SYSTEMD_CACHE[cache_key] = d
    return d


def _project_systemd(unit: str, accepted: bool) -> tuple[str, int]:
    """Honest tier for a systemd-backed feature. VALIDATED-run/active still caps at
    IN-PROGRESS until the owner ACCEPTS — 'running' proves integrated, not
    complete-to-standard. Never SHIPPED without acceptance."""
    st = _systemd_state(unit)
    if not st:
        return ("DESIGNED", 10)
    active = st.get("ActiveState", "")
    ufs = st.get("UnitFileState", "")
    ran = bool(st.get("ActiveEnterTimestamp", "").strip()
               or st.get("ExecMainStartTimestamp", "").strip()
               or st.get("InactiveExitTimestamp", "").strip())
    result = st.get("Result", "")
    enabled = ufs in ("enabled", "enabled-runtime", "linked", "linked-runtime", "static")
    if active == "active":                       # running now: integrated + up
        return ("SHIPPED", 100) if accepted else ("IN-PROGRESS", 65)
    if ran and result == "success":              # oneshot ran + succeeded
        return ("SHIPPED", 100) if accepted else ("IN-PROGRESS", 70)
    if result not in ("", "success"):            # failed
        return ("BLOCKED", 0)
    # For oneshot services, after deactivation the timestamps become empty but Result
    # persists. Check the timer's LastTriggerUSec to detect past successful runs.
    if not ran and result == "success":
        timer_st = _systemd_timer_state(unit)
        triggered = bool(timer_st.get("LastTriggerUSec", "").strip())
        if triggered:                            # timer triggered + unit has Result=success
            return ("SHIPPED", 100) if accepted else ("IN-PROGRESS", 70)
    if enabled:                                   # enabled but never observed running its job
        return ("IN-PROGRESS", 40)
    return ("DESIGNED", 15)


def _commit_hits_or_none(det: dict, gitlog: str) -> int | None:
    pats = det.get("commit_match") or []
    return sum(_count_commit_hits(s, gitlog) for s in pats) if pats else None


def _live_or_activated(result: tuple[str, int], verified: bool) -> tuple[str, int]:
    """Live ground truth (verified stands in for acceptance) must reach SHIPPED before a verified grant ACTIVATES."""
    return ("ACTIVATED", 100) if verified and result[0] == "SHIPPED" else result


def _project_command(cmd: str, accepted: bool, commit_hits: int | None = None) -> tuple[str, int]:
    """Honest tier for a tool by presence on PATH (or an absolute file). PRESENT =
    integrated-but-unvalidated (a binary existing proves installed, not that it
    works or is wired); MISSING = not integrated. Never complete w/o sign-off. When the item declares
    commit_match signals (commit_hits not None) SHIPPED also needs a hit: a generic binary on PATH
    (`aq`, `edgeai`) is not evidence this item shipped."""
    import shutil
    present = bool(shutil.which(cmd)) or (REPO / cmd).is_file() or Path(cmd).is_file()
    if not present:
        return ("NOT-STARTED", 0)
    if commit_hits == 0:
        return ("IN-PROGRESS", 55)
    return ("SHIPPED", 100) if accepted else ("IN-PROGRESS", 55)


def _count_commit_hits(pattern: str, gitlog: str) -> int:
    """Count hits for a commit match pattern, supporting regex with safe literal fallback."""
    try:
        matches = re.findall(pattern, gitlog, re.IGNORECASE)
        if matches:
            return len(matches)
    except re.error:
        pass
    return gitlog.count(pattern)


def _parse_date(v) -> date | None:
    """Strict ISO-8601 date/datetime -> date (naive treated as UTC); None when malformed."""
    if not isinstance(v, str) or not v.strip():
        return None
    v = v.strip()
    try:
        if "T" in v or " " in v:
            dt = datetime.fromisoformat(v[:-1] + "+00:00" if v.endswith("Z") else v)
            if dt.tzinfo is not None:
                dt = dt.astimezone(timezone.utc)
            return dt.date()
        return date.fromisoformat(v)
    except ValueError:
        return None


def load_untrusted(path: Path | None = None) -> tuple[dict | None, list[str]]:
    """Load + validate the untrusted-provenance config. Returns (config, errors);
    config is None when missing/malformed so callers can fail closed (--check) or warn."""
    path = Path(os.environ.get("AQ_PM_UNTRUSTED_CONFIG") or path or UNTRUSTED_CONFIG)
    if not path.is_file():
        return None, [f"untrusted-provenance config missing: {path}"]
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        return None, [f"untrusted-provenance config unreadable/invalid JSON: {e}"]
    errs: list[str] = []
    if not isinstance(raw, dict) or not isinstance(raw.get("lanes"), list):
        return None, ["untrusted-provenance config must be an object with lanes[]"]
    if not isinstance(raw.get("clears", {}), dict):
        errs.append("clears must be an object {\"<plan>/<item-id>\": receipt-path}")
    items = raw.get("items", {})
    if not isinstance(items, dict) or not all(
            isinstance(k, str) and re.fullmatch(r"[^/\s]+/[^/\s]+", k) and isinstance(v, dict)
            and isinstance(v.get("commit_match"), list)
            and all(isinstance(x, str) and x for x in v["commit_match"]) for k, v in items.items()):
        errs.append('items must be an object {"<plan>/<item-id>": {"commit_match": [patterns]}}')
        items = {}
    prs: dict[int, dict] = {}
    for n, lane in enumerate(raw["lanes"]):
        if not isinstance(lane, dict) or not isinstance(lane.get("name"), str) or not lane["name"].strip():
            errs.append(f"lanes[{n}] needs a non-empty name")
            continue
        nums = lane.get("pr_numbers")
        if not isinstance(nums, list) or not nums or not all(type(x) is int and x > 0 for x in nums):
            errs.append(f"lanes[{n}].pr_numbers must be a non-empty list of positive integers")
            continue
        if _parse_date(lane.get("since")) is None or not re.fullmatch(r"\d{4}-\d{2}-\d{2}", lane["since"]):
            errs.append(f"lanes[{n}].since must be a valid YYYY-MM-DD date")
            continue
        if not isinstance(lane.get("reason"), str) or not lane["reason"].strip():
            errs.append(f"lanes[{n}].reason must be a non-empty string")
            continue
        for x in nums:
            prs.setdefault(x, lane)
    if errs:
        return None, errs
    return {"prs": prs, "clears": raw.get("clears", {}), "items": {k: list(v["commit_match"]) for k, v in items.items()}, "lanes": raw["lanes"]}, []


_RECEIPT_MOD = None


def _receipt_module():
    global _RECEIPT_MOD
    if _RECEIPT_MOD is None:
        from importlib import machinery, util
        src = str(Path(__file__).resolve().parent / "aq-review-receipt")
        spec = util.spec_from_loader("aq_review_receipt", machinery.SourceFileLoader("aq_review_receipt", src))
        _RECEIPT_MOD = util.module_from_spec(spec)
        spec.loader.exec_module(_RECEIPT_MOD)
    return _RECEIPT_MOD


def _item_key(plan: str, item: dict) -> str:
    return f"{plan}/{item.get('id')}"


def _commit_files(commit: str) -> set[str] | None:
    """Files a commit modifies (read-only); None when unreadable."""
    if not re.fullmatch(r"[0-9a-f]{7,40}", commit):
        return None
    try:
        r = subprocess.run(["git", "--no-optional-locks", "-C", str(REPO), "show", "--name-only", "--format=", commit],
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    return set(r.stdout.split("\n")) - {""} if r.returncode == 0 else None


def _receipt_bound(item: dict, plan: str, gitlog: str, untrusted: dict, pr) -> bool:
    """The receipt's PR is a trusted explicit `(#N)` squash commit that matches the item's detection
    (frozen patterns for listed items, never the editable current ones) AND modifies the item's plan
    tracker or its detection-named freeze record."""
    if type(pr) is not int or pr in untrusted["prs"]:
        return False
    frozen = untrusted["items"].get(_item_key(plan, item))
    patterns = frozen if frozen is not None else ((item.get("detection") or {}).get("commit_match") or [])
    allowed = {f".agents/plans/{plan}/tracker.json"}
    fr = (item.get("detection") or {}).get("freeze_record")
    if isinstance(fr, str) and fr:
        allowed.add(fr)
    for line in gitlog.splitlines():
        m = _PR_SUBJECT.search(line)
        if m and int(m.group(1)) == pr and any(_line_matches(p, line) for p in patterns):
            files = _commit_files(line.split()[0])
            if files and files & allowed:
                return True
    return False


def _registry_path() -> Path:
    """Shared main-worktree delegation registry (same resolution as aq-review-receipt)."""
    sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
    try:
        from delegation_dir import resolve_delegation_dir
    finally:
        sys.path.pop(0)
    return resolve_delegation_dir(Path(__file__).resolve().parent) / "registry.jsonl"


def _hold_receipt_problem(item: dict, lane: dict, untrusted: dict, gitlog: str = "", plan: str = "") -> str | None:
    """None when the item carries a valid independent review receipt dated on/after the hold AND bound
    to this item (the receipt's PR is a trusted PR whose squash commit matches the item's detection, or
    config `clears` names this exact item + receipt); otherwise the reason it does not."""
    acc = item.get("acceptance") or {}
    rel = acc.get("review_receipt") if acc.get("status") == "accepted" else None
    rel = rel or untrusted["clears"].get(_item_key(plan, item))
    if not rel:
        return "no review receipt"
    if not isinstance(rel, str) or rel.startswith("/") or ".." in Path(rel).parts:
        return "receipt path must be repo-relative"
    path = REPO / rel
    try:
        errs = _receipt_module().verify_receipt(path, REPO, _registry_path())
        r = json.loads(path.read_text(encoding="utf-8")) if not errs else {}
    except (OSError, ValueError, SystemExit) as e:
        return f"receipt unverifiable: {e.__class__.__name__}"
    if errs:
        return "receipt invalid: " + "; ".join(errs)
    if r.get("verdict") not in _RECEIPT_OK_VERDICTS:
        return f"receipt verdict {r.get('verdict')!r} is not a pass"
    created, since = _parse_date(r.get("created_at")), _parse_date(lane["since"])
    if created is None or since is None or created < since:
        return "receipt date malformed or predates the hold"
    tokens = [t for t in re.split(r"[^a-z0-9]+", lane["name"].lower()) if t]
    reviewer = str(r.get("reviewer_lane", "")).lower()
    if any(t in reviewer for t in tokens):
        return "receipt reviewer is the untrusted lane"
    if not _receipt_bound(item, plan, gitlog, untrusted, r.get("pr")):
        return "receipt is not bound to this item (PR must be a trusted (#N) commit matching the frozen detection and touching the item's tracker)"
    return None


def _line_matches(pattern: str, line: str) -> bool:
    try:
        if re.search(pattern, line, re.IGNORECASE):
            return True
    except re.error:
        pass
    return pattern in line


def _untrusted_hold(item: dict, gitlog: str, untrusted: dict | None, plan: str = "") -> dict | None:
    """Hold record when ANY matching commit is an untrusted-PR squash commit, unless a trusted
    (non-listed) matching commit is NEWER than the newest untrusted one (git log is newest-first,
    so newer == earlier line) or a bound valid review receipt clears it. Items frozen in the config
    `items` list are held regardless of their current detection and clear ONLY via a bound receipt."""
    if not untrusted:
        return None
    frozen = untrusted["items"].get(_item_key(plan, item))
    listed = frozen is not None
    patterns = list((item.get("detection") or {}).get("commit_match") or []) + list(frozen or [])
    prs: list[int] = []
    newest_untrusted = None   # smallest line index == newest commit
    newest_trusted = None
    lane = None
    for idx, line in enumerate(gitlog.splitlines()):
        if not patterns or not any(_line_matches(p, line) for p in patterns):
            continue
        m = _PR_SUBJECT.search(line)
        if m and int(m.group(1)) in untrusted["prs"]:
            prs.append(int(m.group(1)))
            lane = lane or untrusted["prs"][int(m.group(1))]
            newest_untrusted = idx if newest_untrusted is None else newest_untrusted
        elif m and newest_trusted is None:   # only explicit (#N) squash commits count as trusted
            newest_trusted = idx
    if not prs and not listed:
        return None
    lane = lane or untrusted["lanes"][0]
    if prs and not listed and newest_trusted is not None and newest_trusted < newest_untrusted:
        return None
    if _hold_receipt_problem(item, lane, untrusted, gitlog, plan) is None:
        return None
    return {"lane": lane["name"], "since": lane["since"], "prs": sorted(set(prs)),
            "reason": f"{'item frozen in untrusted-provenance items list' if listed else 'commit evidence includes untrusted-lane PRs'} "
                      f"({lane['name']}); needs a bound independent review receipt"
                      f"{'' if listed else ' or a later trusted commit'}"}


def project_item_full(item: dict, gitlog: str, source_health: str = "complete",
                      untrusted: dict | None = None, plan: str = "",
                      activation_ctx: dict | None = None) -> tuple[str, int | None, dict | None]:
    verified, reason = _item_activation(item, plan, activation_ctx)
    status, pct = project_item(item, gitlog, source_health, verified, reason == "grant-stale")
    if status in ("SHIPPED", "ACTIVATED"):
        if untrusted is None:
            # Provenance config unavailable: commit-derived completion cannot be trusted.
            if (item.get("detection") or {}).get("commit_match"):
                return "UNKNOWN", None, {"degraded": True, "lane": "?", "since": "?", "prs": [],
                                         "reason": "untrusted-provenance config unavailable; completion unverifiable"}
            return status, pct, None
        hold = _untrusted_hold(item, gitlog, untrusted, plan)
        if hold:
            return "UNVERIFIED", _UNVERIFIED_PCT, hold
    return status, pct, None


def project_item(item: dict, gitlog: str, source_health: str = "complete", verified: bool = False,
                 stale: bool = False) -> tuple[str, int | None]:
    """`verified` = activation_verified result (via _item_activation); the only input that can yield ACTIVATED.
    `stale` = a signed grant exists but the closure/attestation changed: it counts as past sign-off for the ground-truth
    tier (SHIPPED, never ACTIVATED); the caller reports activation_stale."""
    det = item.get("detection", {}) or {}
    accepted = (item.get("acceptance") or {}).get("status") == "accepted"

    # Ground-truth systemd projection (services domain) — never complete w/o sign-off.
    unit = det.get("systemd_unit")
    if unit:
        return _live_or_activated(_project_systemd(unit, accepted or verified or stale), verified)
    # Ground-truth tool-presence projection (tools domain).
    cmd = det.get("command")
    if cmd:
        return _live_or_activated(_project_command(cmd, accepted or verified or stale, _commit_hits_or_none(det, gitlog)), verified)

    hits = sum(_count_commit_hits(s, gitlog) for s in (det.get("commit_match") or []))
    freeze = det.get("freeze_record")
    freeze_exists = bool(freeze) and (REPO / freeze).is_file()
    blocker = det.get("blocker_note")
    pct = item.get("pct_hint")
    kind = item.get("kind", "slice")
    is_activation = kind == "task" and bool(blocker) and (
        "owner acts" in (blocker or "") or "owner-gated" in (item.get("editorial_note", "")))

    def _gate(status: str, p: int) -> tuple[str, int]:
        # Owner sign-off gate: an item carrying an `acceptance` block cannot read
        # complete (SHIPPED/ACTIVATED) until acceptance == 'accepted'. Validated-but-
        # unaccepted caps at IN-PROGRESS 85 ('done pending your sign-off').
        if "acceptance" in item and not accepted and status in ("SHIPPED", "ACTIVATED"):
            return ("IN-PROGRESS", 85)
        return (status, p)

    # Positive evidence remains useful even when commit history is partial.
    # Only the *absence* of commit evidence becomes UNKNOWN in that case.
    if is_activation:
        return ("ACTIVATED", 100) if verified else (("SHIPPED", 100) if stale else ("NOT-STARTED", 0))
    if verified:
        return ("ACTIVATED", 100)
    if source_health != "complete" and det.get("commit_match"):
        if accepted:
            return ("SHIPPED", 100)
        return ("UNKNOWN", None)
    if hits > 0:
        if pct is not None and pct < 100:
            return ("IN-PROGRESS", int(pct))
        if accepted:
            return _gate("SHIPPED", 100)
        return ("IN-PROGRESS", int(pct) if pct is not None else 60)
    if accepted and (pct is None or pct == 100):
        return ("SHIPPED", 100)
    if freeze_exists:
        return ("FROZEN", 20)
    if blocker:
        return ("NOT-STARTED", 0)
    return ("DESIGNED", 10)


def _rollup(items: list[dict]) -> tuple[int | None, int, int]:
    """Return average of known evidence plus known/unknown item counts."""
    known = [item["pct"] for item in items if item.get("pct") is not None]
    return (round(sum(known) / len(known)) if known else None, len(known), len(items) - len(known))


def _format_pct(pct: int | None) -> str:
    """Human output must not turn unknown provenance into a numeric claim."""
    return "  ?" if pct is None else f"{pct:>3}"


def project(plan_dir: Path) -> dict:
    manifest = json.loads((plan_dir / "tracker.json").read_text())
    gitlog, source_health = _git_log()
    activation_ctx = _load_activation_ctx()
    untrusted, uerrs = load_untrusted()
    for e in uerrs:
        print(f"aq-pm-tracker: WARNING {e}; untrusted-author hold NOT applied (projection DEGRADED: commit-derived completions reported UNKNOWN)", file=sys.stderr)
    items = []
    for it in manifest.get("items", []):
        status, pct, hold = project_item_full(it, gitlog, source_health, untrusted, plan_dir.name, activation_ctx)
        items.append({"id": it["id"], "name": it.get("name"), "phase": it.get("phase"),
                      "kind": it.get("kind"), "goal": it.get("goal"),
                      "validation_goal": it.get("validation_goal"), "deps": it.get("deps", []),
                      "status": status, "pct": pct, "hold": hold,
                      **_activation_flags(it, plan_dir.name, activation_ctx)})
    rollup, known_items, unknown_items = _rollup(items)
    shipped = sum(1 for i in items if i["status"] in ("SHIPPED", "ACTIVATED"))
    return {"plan": manifest.get("plan", {}), "phases": manifest.get("phases", []),
            "items": items, "issues": manifest.get("issues", []),
            "rollup_pct": rollup, "shipped": shipped, "total": len(items),
            "held": sum(1 for i in items if i["status"] == "UNVERIFIED"),
            "activation_stale": sum(1 for i in items if i["activation_stale"]),
            "grants_unverified": sum(1 for i in items if i["grants_unverified"]),
            "hold_config_errors": uerrs,
            "known_items": known_items, "unknown_items": unknown_items,
            "source_health": source_health,
            "rollup_authoritative": source_health == "complete" and not uerrs,
            "hold_degraded": bool(uerrs)}


def discover_tracked_plans() -> list[Path]:
    """Every `.agents/plans/*/tracker.json` — the aggregate mode's plan universe.
    Sorted for stable output; directories without a tracker.json are simply
    untracked (PM-tracker-standard DESIGN.md 'not yet built' state) and are
    silently excluded, not an error."""
    plans_root = REPO / ".agents" / "plans"
    if not plans_root.is_dir():
        return []
    return sorted(
        (p.parent for p in plans_root.glob("*/tracker.json") if p.is_file()),
        key=lambda p: p.name,
    )


def project_plan_portfolio() -> dict:
    """Embed the canonical classified inventory; keep failure explicit."""
    try:
        result = subprocess.run(
            [sys.executable, str(REPO / "scripts" / "ai" / "aq-plans-index"), "--json"],
            capture_output=True, text=True, timeout=30, cwd=REPO,
        )
        if result.returncode != 0:
            return {"health": "unavailable", "error": "aq-plans-index exited unsuccessfully", "plans": []}
        portfolio = json.loads(result.stdout)
        if not isinstance(portfolio, dict) or not isinstance(portfolio.get("plans"), list):
            raise ValueError("unexpected portfolio shape")
        portfolio["health"] = "complete"
        return portfolio
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError, ValueError):
        return {"health": "unavailable", "error": "aq-plans-index could not provide a valid inventory", "plans": []}


def project_all() -> dict:
    """Aggregate projection across every tracked plan — reuses project() per
    plan from one read-only git/aq-event evidence snapshot, shared across plans
    so an N-plan aggregate does not multiply subprocess reads."""
    from datetime import datetime, timezone

    gitlog, source_health = _git_log()
    activation_ctx = _load_activation_ctx()
    untrusted, uerrs = load_untrusted()
    for e in uerrs:
        print(f"aq-pm-tracker: WARNING {e}; untrusted-author hold NOT applied (projection DEGRADED: commit-derived completions reported UNKNOWN)", file=sys.stderr)
    plans_out = []
    total_items = 0
    weighted_pct_sum = 0
    for plan_dir in discover_tracked_plans():
        try:
            manifest = json.loads((plan_dir / "tracker.json").read_text())
        except Exception as e:
            print(f"aq-pm-tracker --all: skipping {plan_dir.name} (bad manifest: {e})",
                  file=sys.stderr)
            continue
        items = []
        for it in manifest.get("items", []):
            status, pct, hold = project_item_full(it, gitlog, source_health, untrusted, plan_dir.name, activation_ctx)
            items.append({"id": it["id"], "name": it.get("name"), "phase": it.get("phase"),
                          "deps": it.get("deps", []), "priority_lane": it.get("priority_lane"),
                          "status": status, "pct": pct, "hold": hold,
                          **_activation_flags(it, plan_dir.name, activation_ctx)})
        rollup, known_items, unknown_items = _rollup(items)
        shipped = sum(1 for i in items if i["status"] in ("SHIPPED", "ACTIVATED"))
        plan_meta = manifest.get("plan", {})
        plans_out.append({
            "id": plan_meta.get("id", plan_dir.name),
            "title": plan_meta.get("title", plan_dir.name),
            "rollup_pct": rollup,
            "shipped": shipped,
            "held": sum(1 for i in items if i["status"] == "UNVERIFIED"),
            "activation_stale": sum(1 for i in items if i["activation_stale"]),
            "grants_unverified": sum(1 for i in items if i["grants_unverified"]),
            "total": len(items),
            "known_items": known_items,
            "unknown_items": unknown_items,
            "rollup_authoritative": source_health == "complete" and not uerrs,
            "phases": manifest.get("phases", []),
            "items": items,
        })
        total_items += len(items)
        weighted_pct_sum += sum(i["pct"] for i in items if i["pct"] is not None)
    known_items = sum(plan["known_items"] for plan in plans_out)
    unknown_items = sum(plan["unknown_items"] for plan in plans_out)
    program_rollup_pct = round(weighted_pct_sum / known_items) if known_items else None
    return {
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "plans": plans_out,
        "program_rollup_pct": program_rollup_pct,
        "known_items": known_items,
        "unknown_items": unknown_items,
        "source_health": source_health,
        "rollup_authoritative": source_health == "complete" and not uerrs,
        "hold_degraded": bool(uerrs),
        "hold_config_errors": uerrs,
        "portfolio": project_plan_portfolio(),
    }


LEGACY_ACCEPTANCES_FILE = REPO / "config" / "pm-tracker-legacy-acceptances.json"
RECEIPT_DIR = ".agent/reviews/receipts/"
RECEIPT_VERDICTS = {"PASS", "PASS_WITH_FOLLOWUPS"}
# Legacy non-owner acceptances counted by the last validate_manifest() call (WARN only).
GRANDFATHERED_ACCEPTANCES: list[str] = []


def _is_owner_acceptor(by) -> bool:
    # Known limitation: "hyperd" is self-asserted text; real owner acceptance needs an
    # aq-approve-backed record. Fail closed: only this allowlist counts as a human owner.
    return isinstance(by, str) and (by == "hyperd" or by.startswith("hyperd ("))


def _norm_lane(v) -> str:
    return v.strip().lower() if isinstance(v, str) else ""


def _receipt_problem(rcpt, by) -> str | None:
    """Return None when the receipt is a valid independent review of `by`, else the reason."""
    if not isinstance(rcpt, str) or not rcpt.startswith(RECEIPT_DIR) or ".." in rcpt.split("/"):
        return "receipt path must be repo-relative under " + RECEIPT_DIR
    f = REPO / rcpt
    if not f.is_file():
        return "receipt file missing"
    try:
        d = json.loads(f.read_text())
    except Exception as e:
        return f"receipt not valid JSON ({e})"
    if not isinstance(d, dict):
        return "receipt is not a JSON object"
    if d.get("schema") != 1:
        return "receipt schema != 1"
    if d.get("verdict") not in RECEIPT_VERDICTS:
        return f"receipt verdict {d.get('verdict')!r} not PASS/PASS_WITH_FOLLOWUPS"
    if not re.fullmatch(r"[0-9a-f]{40}", str(d.get("reviewed_head_sha") or "")):
        return "receipt reviewed_head_sha invalid"
    if not re.fullmatch(r"[0-9a-f]{64}", str(d.get("output_sha256") or "")):
        return "receipt output_sha256 invalid"
    if not isinstance(d.get("run_id"), str) or not d["run_id"].strip():
        return "receipt run_id empty"
    rev, auth = _norm_lane(d.get("reviewer_lane")), _norm_lane(d.get("author_lane"))
    if not rev or rev == auth:
        return "receipt reviewer_lane empty or equals author_lane (not independent)"
    if rev != _norm_lane(by):
        return "receipt reviewer_lane does not match acceptance `by`"
    return None


def _legacy_entries(text: str) -> set[tuple]:
    try:
        data = json.loads(text)
    except Exception:
        return set()
    return {(e.get("plan"), e.get("item"), e.get("by")) for e in data.get("entries", [])}


def _legacy_allowlist() -> set[tuple[str, str, str]]:
    """Frozen (plan, item, by) triples; remove-only (see check_legacy_allowlist). Date never consulted."""
    try:
        return _legacy_entries(LEGACY_ACCEPTANCES_FILE.read_text())
    except Exception:
        return set()


def legacy_additions(current: set, base: set) -> set:
    """Triples present now but absent in base: the allowlist is remove-only, so these are violations."""
    return current - base


def _strict_legacy_entries(text: str) -> set[tuple]:
    """Like _legacy_entries but raises ValueError on unparsable JSON or malformed entries."""
    try:
        data = json.loads(text)
    except Exception as e:
        raise ValueError(f"unparsable JSON ({e})")
    entries = data.get("entries") if isinstance(data, dict) else None
    if not isinstance(entries, list):
        raise ValueError("'entries' missing or not a list")
    out = set()
    for e in entries:
        if not isinstance(e, dict):
            raise ValueError(f"malformed entry {e!r}")
        t = tuple(e.get(k) for k in ("plan", "item", "by"))
        if not all(isinstance(v, str) and v.strip() for v in t):
            raise ValueError(f"malformed entry {e!r} (plan/item/by must be non-empty strings)")
        out.add(t)
    return out


def _git_run(*a):
    return subprocess.run(["git", "-C", str(REPO), *a], capture_output=True, text=True)


def _resolve_legacy_base(rel: str, git=_git_run) -> tuple[str, str]:
    """Return ("ok", base_text) | ("absent", "") | ("error", reason). Only a verified
    missing path at a resolved base is "absent"; every git failure is "error" (fail closed)."""
    ref = None
    for cand in ("origin/main", "main"):
        if git("rev-parse", "--verify", "--quiet", f"{cand}^{{commit}}").returncode == 0:
            ref = cand
            break
    if ref is None:
        return "error", "no base ref (origin/main or main) resolves"
    mb = git("merge-base", "HEAD", ref)
    base = mb.stdout.strip()
    if mb.returncode != 0 or not base:
        return "error", f"git merge-base HEAD {ref} failed: {mb.stderr.strip()}"
    # Absent at the merge-base is not enough (a branch cut before the file existed could
    # add arbitrary entries): fall through to the base ref tip. Absent at both = introducing commit.
    for rev in (base, ref):
        ls = git("ls-tree", rev, "--", rel)
        if ls.returncode != 0:
            return "error", f"git ls-tree {rev} failed: {ls.stderr.strip()}"
        if not ls.stdout.strip():
            continue
        show = git("show", f"{rev}:{rel}")
        if show.returncode != 0:
            return "error", f"git show {rev}:{rel} failed: {show.stderr.strip()}"
        return "ok", show.stdout
    return "absent", ""


def check_legacy_allowlist(git=_git_run) -> int:
    rel = LEGACY_ACCEPTANCES_FILE.relative_to(REPO).as_posix()
    try:
        current = _strict_legacy_entries(LEGACY_ACCEPTANCES_FILE.read_text())
    except (OSError, ValueError) as e:
        print(f"[legacy-allowlist] FAIL: current {rel} invalid: {e}")
        return 1
    status, text = _resolve_legacy_base(rel, git)
    if status == "error":
        print(f"[legacy-allowlist] FAIL: cannot resolve base (fail closed): {text}")
        return 1
    if status == "absent":
        print("[legacy-allowlist] no base version at merge-base or base ref tip; treating current file as base (introducing commit)")
        return 0
    try:
        base = _strict_legacy_entries(text)
    except ValueError as e:
        print(f"[legacy-allowlist] FAIL: base {rel} invalid: {e}")
        return 1
    added = legacy_additions(current, base)
    if added:
        for t in sorted(map(str, added)):
            print(f"[legacy-allowlist] FAIL: entry added (allowlist is remove-only): {t}")
        return 1
    print("[legacy-allowlist] PASS: no entries added vs base")
    return 0


def _untrusted_base_items(rel: str, git=_git_run) -> tuple[dict, str, str]:
    """Union of frozen items at BOTH the merge-base and the base-ref tip (a stale merge-base or a
    pre-freeze config must not make removals free). ("ok"|"absent"|"error", reason)."""
    ref = next((c for c in ("origin/main", "main")
                if git("rev-parse", "--verify", "--quiet", f"{c}^{{commit}}").returncode == 0), None)
    if ref is None:
        return {}, "error", "no base ref (origin/main or main) resolves"
    mb = git("merge-base", "HEAD", ref)
    base = mb.stdout.strip()
    if mb.returncode != 0 or not base:
        return {}, "error", f"git merge-base HEAD {ref} failed: {mb.stderr.strip()}"
    union: dict[str, list] = {}
    present = False
    for rev in dict.fromkeys((base, ref)):
        ls = git("ls-tree", rev, "--", rel)
        if ls.returncode != 0:
            return {}, "error", f"git ls-tree {rev} failed: {ls.stderr.strip()}"
        if not ls.stdout.strip():
            continue
        show = git("show", f"{rev}:{rel}")
        if show.returncode != 0:
            return {}, "error", f"git show {rev}:{rel} failed: {show.stderr.strip()}"
        present = True
        try:
            raw = json.loads(show.stdout)
            items = raw.get("items", {}) if isinstance(raw, dict) else None
            if isinstance(items, list):          # pre-freeze list form: keys only
                items = {k: {"commit_match": []} for k in items if isinstance(k, str)}
            if not isinstance(items, dict):
                raise ValueError("items not an object")
            for k, v in items.items():
                union.setdefault(k, [])
                union[k] += [x for x in (v.get("commit_match") if isinstance(v, dict) else []) or [] if x not in union[k]]
        except (ValueError, AttributeError, TypeError) as e:
            return {}, "error", f"base {rev}:{rel} unparsable: {e}"
    return (union, "ok", "") if present else ({}, "absent", "")


def check_untrusted_items(git=_git_run) -> int:
    """The config `items` list is remove-only: an entry may be removed vs base only if that item's
    hold is cleared by a bound valid receipt. Fails closed on any unresolved/invalid state."""
    tag = "[untrusted-items]"
    rel = UNTRUSTED_CONFIG.relative_to(REPO).as_posix()
    cur, errs = load_untrusted()
    if cur is None or errs:
        print(f"{tag} FAIL: current {rel} invalid: {'; '.join(errs)}")
        return 1
    base_items, status, why = _untrusted_base_items(rel, git)
    if status == "error":
        print(f"{tag} FAIL: cannot resolve base (fail closed): {why}")
        return 1
    if status == "absent":
        print(f"{tag} no base version at merge-base or base ref tip; treating current file as base (introducing commit)")
        return 0
    removed = sorted(set(base_items) - set(cur["items"]))
    if not removed:
        print(f"{tag} PASS: no entries removed vs base")
        return 0
    gitlog, _ = _git_log()
    bad = 0
    for key in removed:
        plan, _, iid = key.partition("/")
        try:
            manifest = json.loads((REPO / ".agents" / "plans" / plan / "tracker.json").read_text())
            item = next(i for i in manifest["items"] if i.get("id") == iid)
        except (OSError, ValueError, StopIteration, KeyError):
            print(f"{tag} FAIL: removed entry {key} has no resolvable tracker item (fail closed)")
            bad = 1
            continue
        forced = {**cur, "items": {**cur["items"], key: base_items[key]}}
        if _untrusted_hold(item, gitlog, forced, plan) is not None:
            print(f"{tag} FAIL: entry {key} removed but its hold is not cleared by a bound valid receipt")
            bad = 1
    if not bad:
        print(f"{tag} PASS: all removed entries are cleared by bound receipts")
    return bad


def validate_manifest(plan_dir: Path) -> list[str]:
    errs = []
    GRANDFATHERED_ACCEPTANCES.clear()
    p = plan_dir / "tracker.json"
    if not p.is_file():
        return [f"no tracker.json in {plan_dir}"]
    try:
        m = json.loads(p.read_text())
    except Exception as e:
        return [f"tracker.json invalid JSON: {e}"]
    if not isinstance(m.get("items"), list) or not m["items"]:
        errs.append("manifest must have a non-empty items[]")
    ids = set()
    for it in m.get("items", []):
        if not it.get("id"):
            errs.append("item missing id")
        elif it["id"] in ids:
            errs.append(f"duplicate item id {it['id']}")
        ids.add(it.get("id"))
        if not it.get("goal") or not it.get("validation_goal"):
            errs.append(f"item {it.get('id')} missing goal/validation_goal (editorial required)")
    legacy = _legacy_allowlist()
    for it in m.get("items", []):
        # Acceptance is the independent sign-off gate: an agent lane / test script may
        # not accept its own work unless a review receipt backs it (frozen allowlist grandfathered).
        acc = it.get("acceptance")
        if isinstance(acc, dict) and acc.get("status") == "accepted":
            by = acc.get("by")
            if _is_owner_acceptor(by):
                continue
            problem = _receipt_problem(acc.get("receipt"), by)
            if problem is None:
                continue
            if (plan_dir.name, it.get("id"), by) in legacy:
                GRANDFATHERED_ACCEPTANCES.append(f"{plan_dir.name}:{it.get('id')}")
            else:
                errs.append(f"plan {plan_dir.name} item {it.get('id')}: acceptance accepted by "
                            f"'{by}' is not an owner and has no valid independent review receipt "
                            f"({problem}); add `receipt` under {RECEIPT_DIR} or have the owner accept")
    for it in m.get("items", []):
        for d in it.get("deps", []):
            if d not in ids:
                errs.append(f"item {it.get('id')} dep '{d}' not an item id")
    return errs


def _print_hold(it: dict, indent: str) -> None:
    h = it.get("hold")
    if h and h.get("degraded"):
        print(f"{indent}degraded: {h['reason']}")
    elif h:
        prs = ", ".join(f"#{n}" for n in h["prs"])
        print(f"{indent}held: evidence includes untrusted {h['lane']} PRs {prs} since {h['since']}; "
              f"clear via review receipt or later trusted commit")


def main() -> int:
    args = [a for a in sys.argv[1:]]
    if "--check-legacy-allowlist" in args:
        return check_legacy_allowlist()
    if "--check-untrusted-items" in args:
        return check_untrusted_items()

    # Aggregate mode — discovers every .agents/plans/*/tracker.json and
    # projects the program-wide rollup. Independent of the single-plan
    # modes below; does not touch plan_dir resolution.
    if "--all-json" in args:
        print(json.dumps(project_all(), indent=2))
        return 0
    if "--all" in args:
        data = project_all()
        print(f"# Program rollup — {data['program_rollup_pct']}%  "
              f"({len(data['plans'])} tracked plans)  generated {data['generated_at']}")
        if data.get("hold_degraded"):
            print("!! DEGRADED: untrusted-provenance config unavailable; commit-derived completions are UNKNOWN, rollup not authoritative")
        for p in data["plans"]:
            held = f", {p['held']} UNVERIFIED" if p["held"] else ""
            print(f"\n## {p['title']}  —  {p['rollup_pct']}%  ({p['shipped']}/{p['total']} shipped{held})")
            by_phase = {}
            for it in p["items"]:
                by_phase.setdefault(it["phase"], []).append(it)
            for ph in p["phases"]:
                rows = by_phase.get(ph["id"], [])
                if not rows:
                    continue
                print(f"  {ph['name']}:")
                for it in rows:
                    print(f"    [{it['status']:<11}] {_format_pct(it['pct'])}%  {it['name']}")
                    _print_hold(it, "      ")
        return 0

    mode = "summary"
    for m in ("--json", "--check", "--summary"):
        if m in args:
            mode = m.lstrip("-")
            args.remove(m)
    if not args:
        print("usage: aq-pm-tracker <plan-dir> [--json|--check] | aq-pm-tracker --all[-json]",
              file=sys.stderr)
        return 2
    plan_dir = Path(args[0])
    if not plan_dir.is_absolute():
        plan_dir = REPO / plan_dir
    # convenience: accept a bare plan name resolving under .agents/plans/
    if not (plan_dir / "tracker.json").is_file():
        alt = REPO / ".agents" / "plans" / args[0]
        if (alt / "tracker.json").is_file():
            plan_dir = alt
    if mode == "check":
        errs = validate_manifest(plan_dir)
        errs += load_untrusted()[1]
        if errs:
            for e in errs:
                print(f"FAIL: {e}")
            return 1
        project(plan_dir)  # ensure it projects without error
        if GRANDFATHERED_ACCEPTANCES:
            print(f"WARN: {plan_dir.name}: {len(GRANDFATHERED_ACCEPTANCES)} allowlisted legacy "
                  f"agent/test acceptance(s) lack independent review (config/pm-tracker-legacy-acceptances.json)")
        print(f"PASS: {plan_dir.name}/tracker.json valid + projects")
        return 0
    data = project(plan_dir)
    if mode == "json":
        print(json.dumps(data, indent=2))
        return 0
    pl = data["plan"]
    held = f", {data['held']} UNVERIFIED" if data["held"] else ""
    print(f"# {pl.get('title', plan_dir.name)}  —  {data['rollup_pct']}%  ({data['shipped']}/{data['total']} shipped{held})")
    print(f"  goal: {pl.get('goal', '')}")
    if data.get("hold_degraded"):
        print("  !! DEGRADED: untrusted-provenance config unavailable; commit-derived completions are UNKNOWN, rollup not authoritative")
    by_phase = {}
    for it in data["items"]:
        by_phase.setdefault(it["phase"], []).append(it)
    for ph in data["phases"]:
        rows = by_phase.get(ph["id"], [])
        print(f"\n## {ph['name']}")
        for it in rows:
            print(f"  [{it['status']:<11}] {_format_pct(it['pct'])}%  {it['name']}")
            _print_hold(it, "    ")
    if data["issues"]:
        print("\n## issues")
        for i in data["issues"]:
            print(f"  ({i.get('sev')}) {i.get('title')}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
