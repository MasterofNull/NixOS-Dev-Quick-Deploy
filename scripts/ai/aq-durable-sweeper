import argparse
import datetime
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional

STATE_SCHEMA_VERSION = "2026-10-19"
DEFAULT_STATE_FILE = Path("/var/lib/aq-durable-agent/sweeper-state.json")
LOCAL_STATE_FALLBACK = Path.home() / ".local/share/aq-durable-agent/sweeper-state.json"

DOMAIN_CATEGORIES = [
    "agentic_architecture",
    "os_systems_confinement",
    "frontend_cockpit_ux",
    "quant_financial_stochastic",
    "testing_verification",
    "operational_facts",
    "hype"
]

def get_state_path(custom_path: Optional[str] = None) -> Path:
    if custom_path:
        return Path(custom_path)
    if os.access(DEFAULT_STATE_FILE.parent, os.W_OK) or (
        not DEFAULT_STATE_FILE.parent.exists() and os.access(Path("/var/lib"), os.W_OK)
    ):
        return DEFAULT_STATE_FILE
    LOCAL_STATE_FALLBACK.parent.mkdir(parents=True, exist_ok=True)
    return LOCAL_STATE_FALLBACK

def init_default_state(agent_id: str) -> Dict[str, Any]:
    now = datetime.datetime.now(datetime.timezone.utc).isoformat()
    return {
        "schema_version": STATE_SCHEMA_VERSION,
        "agent_id": agent_id,
        "status": "idle",
        "last_tick_utc": now,
        "next_scheduled_tick_utc": now,
        "cursor_tokens": {},
        "processed_hashes": [],
        "metrics": {
            "total_sweeps": 0,
            "items_ingested": 0,
            "hype_count": 0,
            "facts_count": 0,
            "signal_count": 0,
            "domain_counts": {d: 0 for d in DOMAIN_CATEGORIES}
        },
    }

import fcntl

def load_state(path: Path, agent_id: str = "default-sweeper") -> Dict[str, Any]:
    if not path.exists():
        return init_default_state(agent_id)
    try:
        with open(path, "r", encoding="utf-8") as f:
            fcntl.flock(f.fileno(), fcntl.LOCK_SH)
            try:
                data = json.load(f)
            finally:
                fcntl.flock(f.fileno(), fcntl.LOCK_UN)
            if data.get("schema_version") != STATE_SCHEMA_VERSION:
                data["schema_version"] = STATE_SCHEMA_VERSION
            data.setdefault("metrics", {}).setdefault("domain_counts", {d: 0 for d in DOMAIN_CATEGORIES})
            return data
    except Exception as e:
        sys.stderr.write(f"[aq-durable-sweeper] ERROR: Failed to load state from {path} ({e})\n")
        corrupted_backup = path.with_suffix(f".corrupted.{int(datetime.datetime.now().timestamp())}.json")
        try:
            if path.exists():
                os.rename(path, corrupted_backup)
                sys.stderr.write(f"[aq-durable-sweeper] Preserved corrupted state at {corrupted_backup}\n")
        except Exception:
            pass
        return init_default_state(agent_id)

def save_state(path: Path, state: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    lock_file = path.with_suffix(".lock")
    with open(lock_file, "w", encoding="utf-8") as lf:
        fcntl.flock(lf.fileno(), fcntl.LOCK_EX)
        try:
            tmp_path = path.with_suffix(".tmp")
            with open(tmp_path, "w", encoding="utf-8") as f:
                json.dump(state, f, indent=2)
            os.replace(tmp_path, path)
        finally:
            fcntl.flock(lf.fileno(), fcntl.LOCK_UN)

def hash_item(title: str, source: str, content: str) -> str:
    raw = f"{title}|{source}|{content}".encode("utf-8")
    return hashlib.sha256(raw).hexdigest()

def classify_heuristic(title: str, content: str) -> Dict[str, Any]:
    """
    Multi-domain deterministic classifier mapping items across the 5 core engineering domains.
    """
    combined = f"{title} {content}".lower()

    # 1. Hype signals
    hype_keywords = ["game-changer", "blow your mind", "agi achieved", "100x faster than everything", "revolutionary tool that replaces all humans"]
    for kw in hype_keywords:
        if kw in combined:
            return {
                "category": "hype",
                "domain": "hype",
                "confidence": 0.85,
                "summary": f"Detected marketing exaggeration keywords ('{kw}').",
                "actionable_takeaways": [],
                "target_rag_collection": "none",
            }

    # 2. Facts signals: package bumps, vulnerabilities, driver updates
    facts_keywords = ["cve-", "security advisory", "nixpkgs bump", "release v", "bugfix", "kernel patch", "driver update"]
    for kw in facts_keywords:
        if kw in combined:
            return {
                "category": "facts",
                "domain": "os_systems_confinement" if any(k in combined for k in ["cve-", "security advisory", "kernel patch"]) else "operational_facts",
                "confidence": 0.90,
                "summary": f"Verified upstream release or operational notice ('{kw}').",
                "actionable_takeaways": [f"Operational maintenance signal: {title}"],
                "target_rag_collection": "best-practices",
            }

    # 3. OS, Systems & Confinement
    os_keywords = ["landlock", "ebpf", "bubblewrap", "bwrap", "firecracker", "microvm", "qemu", "virtio", "apparmor", "cgroups", "seccomp"]
    for kw in os_keywords:
        if kw in combined:
            return {
                "category": "signal",
                "domain": "os_systems_confinement",
                "confidence": 0.95,
                "summary": f"Identified systems or microarchitectural isolation pattern ('{kw}').",
                "actionable_takeaways": [f"Review declarative confinement pattern from: {title}"],
                "target_rag_collection": "best-practices",
            }

    # 3. Agentic Architecture & Factory
    agent_keywords = ["durable agent", "autonomous loop", "multi-agent", "reasoning", "subagent", "state checkpoint", "self-improvement", "prm", "speculative decoding", "kv cache", "token efficiency"]
    for kw in agent_keywords:
        if kw in combined:
            return {
                "category": "signal",
                "domain": "agentic_architecture",
                "confidence": 0.95,
                "summary": f"Identified agentic architecture or factory advancement ('{kw}').",
                "actionable_takeaways": [f"Evaluate architectural pattern from {title} for local factory adoption."],
                "target_rag_collection": "skills-patterns",
            }

    # 4. Frontend & Cockpit Ergonomics
    ui_keywords = ["design system", "human-computer interaction", "cockpit", "hud", "oklch", "d3", "canvas", "telemetry", "websocket", "latency"]
    for kw in ui_keywords:
        if kw in combined:
            return {
                "category": "signal",
                "domain": "frontend_cockpit_ux",
                "confidence": 0.90,
                "summary": f"Identified frontend design, cockpit telemetry, or ergonomics pattern ('{kw}').",
                "actionable_takeaways": [f"Adopt cockpit telemetry / UX improvement from {title}."],
                "target_rag_collection": "skills-patterns",
            }

    # 5. Quantitative, Stochastic & Financial
    quant_keywords = ["market microstructure", "portfolio management", "stochastic", "kalman", "state filtering", "game theory", "mechanism design", "causal inference", "hawkes process"]
    for kw in quant_keywords:
        if kw in combined:
            return {
                "category": "signal",
                "domain": "quant_financial_stochastic",
                "confidence": 0.90,
                "summary": f"Identified quantitative or stochastic decision modeling pattern ('{kw}').",
                "actionable_takeaways": [f"Incorporate stochastic / quantitative strategy from {title} into TradingAgents."],
                "target_rag_collection": "best-practices",
            }

    # 6. Testing, Reliability & Verification
    test_keywords = ["fuzzing", "property-based testing", "mutation testing", "invariant", "smt solver", "sat solver", "flake elimination", "regression test"]
    for kw in test_keywords:
        if kw in combined:
            return {
                "category": "signal",
                "domain": "testing_verification",
                "confidence": 0.90,
                "summary": f"Identified formal verification or testing pattern ('{kw}').",
                "actionable_takeaways": [f"Integrate testing / verification pattern from {title}."],
                "target_rag_collection": "error-solutions",
            }

    # Default facts
    return {
        "category": "facts",
        "domain": "operational_facts",
        "confidence": 0.50,
        "summary": "Operational note or general technical update.",
        "actionable_takeaways": [],
        "target_rag_collection": "none",
    }

def process_item(state: Dict[str, Any], title: str, source: str, content: str) -> Dict[str, Any]:
    item_hash = hash_item(title, source, content)
    if item_hash in state["processed_hashes"]:
        return {"status": "skipped", "reason": "already_processed", "hash": item_hash}

    classification = classify_heuristic(title, content)
    category = classification["category"]
    domain = classification.get("domain", "operational_facts")

    state["processed_hashes"].append(item_hash)
    if len(state["processed_hashes"]) > 5000:
        state["processed_hashes"] = state["processed_hashes"][-5000:]

    state["metrics"]["items_ingested"] += 1
    state["metrics"].setdefault("domain_counts", {})[domain] = state["metrics"].setdefault("domain_counts", {}).get(domain, 0) + 1

    if category == "hype":
        state["metrics"]["hype_count"] += 1
    elif category == "facts":
        state["metrics"]["facts_count"] += 1
    elif category == "signal":
        state["metrics"]["signal_count"] += 1

    return {
        "status": "processed",
        "hash": item_hash,
        "title": title,
        "source": source,
        "domain": domain,
        "classification": classification,
    }

def sweep_local_sources(state: Dict[str, Any], scan_radar: bool = False) -> int:
    """Sweep local intelligence feeds and conditionally trigger live multi-domain radar scan."""
    repo_root = Path(__file__).resolve().parents[2]
    ingested = 0

    # 1. Sweep local frontier evidence backlog
    backlog_path = repo_root / ".agents/plans/frontier-evidence-intake/BACKLOG.jsonl"
    if backlog_path.is_file():
        try:
            with open(backlog_path, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        doc = json.loads(line)
                        title = doc.get("technique") or doc.get("id") or "Untitled"
                        source = doc.get("source") or "frontier-backlog"
                        content = f"{doc.get('claim', '')} {doc.get('proposed_slice', '')}"
                        res = process_item(state, title, source, content)
                        if res.get("status") == "processed":
                            ingested += 1
                    except Exception:
                        continue
        except Exception as e:
            sys.stderr.write(f"[aq-durable-sweeper] Warning: failed reading backlog: {e}\n")

    # 2. Sweep research papers directory (.agent/research/papers/*.json)
    papers_dir = repo_root / ".agent/research/papers"
    if papers_dir.is_dir():
        for pfile in papers_dir.glob("*.json"):
            try:
                pdata = json.loads(pfile.read_text(encoding="utf-8"))
                title = pdata.get("title") or pfile.stem
                source = pdata.get("url") or pdata.get("source_id") or "arxiv"
                content = f"{pdata.get('summary', '')} {' '.join(pdata.get('matched_keywords', []))}"
                res = process_item(state, title, source, content)
                if res.get("status") == "processed":
                    ingested += 1
            except Exception:
                continue

    # 3. Trigger live radar ingest scan across all 5 engineering domains when requested
    if scan_radar:
        radar_bin = repo_root / "scripts/ai/aq-radar-ingest"
        if radar_bin.is_file() and os.access(radar_bin, os.X_OK):
            try:
                cmd = [sys.executable, str(radar_bin), "scan", "--deep", "--limit", "2", "--auto-embed"]
                subprocess.run(cmd, capture_output=True, timeout=120)
            except Exception as e:
                sys.stderr.write(f"[aq-durable-sweeper] Warning: radar sweep execution: {e}\n")

    return ingested

def main():
    parser = argparse.ArgumentParser(description="AQ-OS Proactive Durable Sweeper & Signal Classifier")
    parser.add_argument("--state-file", type=str, help="Custom path to state checkpoint JSON")
    parser.add_argument("--agent-id", type=str, default="sota-frontier-sweeper", help="Identifier for durable agent instance")

    subparsers = parser.add_subparsers(dest="command")

    # status command
    subparsers.add_parser("status", help="Show current state checkpoint metrics")

    # ingest command
    ingest_p = subparsers.add_parser("ingest", help="Ingest and classify a single item")
    ingest_p.add_argument("--title", required=True, help="Title of intelligence item")
    ingest_p.add_argument("--source", required=True, help="Source URL or publisher")
    ingest_p.add_argument("--content", required=True, help="Body text or summary")
    ingest_p.add_argument("--json", action="store_true", help="Output result as JSON")

    # tick command
    tick_p = subparsers.add_parser("tick", help="Execute one durable sweeper tick cycle")
    tick_p.add_argument("--dry-run", action="store_true", help="Simulate tick without updating external state")
    tick_p.add_argument("--with-radar", action="store_true", help="Trigger live multi-domain radar ingest scan")

    args = parser.parse_args()
    state_path = get_state_path(args.state_file)
    state = load_state(state_path, args.agent_id)

    if args.command == "status":
        print(json.dumps(state, indent=2))
        sys.exit(0)

    elif args.command == "ingest":
        result = process_item(state, args.title, args.source, args.content)
        state["last_tick_utc"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
        save_state(state_path, state)
        if args.json:
            print(json.dumps(result, indent=2))
        else:
            cat = result.get("classification", {}).get("category", "unknown")
            dom = result.get("domain", "operational_facts")
            print(f"[{result['status'].upper()}] [{dom.upper()}] {args.title} -> {cat.upper()} ({result.get('hash', '')[:12]})")
        sys.exit(0)

    elif args.command == "tick":
        if args.dry_run:
            print(f"[DRY-RUN] Simulated durable sweeper tick. Active status: {state['status']}, Total sweeps: {state['metrics']['total_sweeps']}")
            sys.exit(0)
        state["status"] = "sweeping"
        state["metrics"]["total_sweeps"] += 1
        with_radar = getattr(args, "with_radar", False)
        new_items = sweep_local_sources(state, scan_radar=with_radar)
        now = datetime.datetime.now(datetime.timezone.utc)
        state["last_tick_utc"] = now.isoformat()
        state["next_scheduled_tick_utc"] = (now + datetime.timedelta(hours=1)).isoformat()
        state["status"] = "idle"
        save_state(state_path, state)
        print(f"Durable sweeper tick complete. Total sweeps: {state['metrics']['total_sweeps']}, New items: {new_items}, Total ingested: {state['metrics']['items_ingested']}")
        sys.exit(0)

    else:
        parser.print_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
