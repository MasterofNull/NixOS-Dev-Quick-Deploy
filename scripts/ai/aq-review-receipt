#!/usr/bin/env python3
"""Mint, publish, verify and audit review receipts that back PR review claims.

`mint` writes a schema 2 receipt (repo, PR, head, tree, base, policy) and `publish`
appends it to the `review-receipts` branch with git plumbing, so the PR head never
moves. `verify` and `audit` still read old in-tree schema 1 receipts.

A receipt ties a PR review claim to a real harness reviewer run recorded in
.agents/delegation/registry.jsonl. Detection-grade only: lanes share one Unix
user, so the receipt is not cryptographically signed (see WORKAROUND-REGISTER).
"""
from __future__ import annotations
try:  # aq-usage-hook
    import importlib.util as _aqu, os as _aqo
    _aqs = _aqu.spec_from_file_location("aq_usage", _aqo.path.join(_aqo.path.dirname(_aqo.path.realpath(__file__)), "lib", "aq_usage.py"))
    _aqm = _aqu.module_from_spec(_aqs); _aqs.loader.exec_module(_aqm); _aqm.record(__file__, __name__)
except Exception:
    pass

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from delegation_dir import resolve_delegation_dir, resolve_main_root  # noqa: E402
from instance_label import build_label  # noqa: E402

# Registry + outputs live in the MAIN worktree's delegation dir (shared by worktree copies).
DEFAULT_REGISTRY = resolve_delegation_dir(Path(__file__).resolve().parent) / "registry.jsonl"
MAIN_ROOT = resolve_main_root(Path(__file__).resolve().parent)
RECEIPT_DIR = ".agent/reviews/receipts"
RECEIPT_BRANCH = "review-receipts"
POLICY_VERSION = "review-receipts/1"
PUBLISH_RETRIES = 5
GIT_TIMEOUT = 180
# The repo's pre-push hook runs full CI parity before the push itself (about 10 minutes
# on a large branch), so the publish push needs far more than GIT_TIMEOUT. The env
# override exists for tests only.
PUSH_TIMEOUT = int(os.environ.get("AQ_REVIEW_RECEIPT_PUSH_TIMEOUT", "1200"))
RECEIPT_EMAIL = "aq-review-receipt@noreply.invalid"  # pre-push identity check needs a dot in the domain
VERDICTS = ("PASS", "PASS_WITH_FOLLOWUPS", "REQUEST_CHANGES")


def norm(lane: str) -> str:
    return re.sub(r"\s+", " ", (lane or "").strip().lower())


def load_registry(path: Path) -> dict:
    rows: dict = {}
    if path.is_file():
        for line in path.read_text(encoding="utf-8").splitlines():
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict) and row.get("id"):
                rows[row["id"]] = row  # last row wins
    return rows


def _rel(root: Path, p: str) -> tuple[Path, str]:
    full = Path(p) if Path(p).is_absolute() else root / p
    if not full.exists() and not Path(p).is_absolute() and (MAIN_ROOT / p).exists():
        full = MAIN_ROOT / p
    full = full.resolve()
    for base in (root.resolve(), MAIN_ROOT.resolve()):
        try:
            return full, str(full.relative_to(base))
        except ValueError:
            continue
    raise SystemExit(f"output_file {full} is outside the repo")


def _run_checks(entry, root: Path):
    """Return (errors, output_path, rel, text) for a registry entry."""
    errs = []
    if not entry:
        return ["run-id not in registry"], None, None, ""
    if entry.get("status") != "done":
        errs.append(f"registry status is {entry.get('status')!r}, need 'done'")
    if "review" not in str(entry.get("role", "")).lower():
        errs.append(f"registry role {entry.get('role')!r} is not a review role")
    if not entry.get("output_file"):
        return errs + ["registry entry has no output_file"], None, None, ""
    full, rel = _rel(root, entry["output_file"])
    if not full.is_file():
        return errs + [f"output_file missing: {rel}"], full, rel, ""
    return errs, full, rel, full.read_text(encoding="utf-8", errors="replace")


def reviewer_instance(entry: dict, persona: bool | None = None) -> str:
    """Label from the review run's own registry provenance, never from the minting process."""
    model = next((str(entry[k]) for k in ("model_effective", "model_requested")
                  if entry.get(k) and entry[k] != "unknown"), "")
    return build_label(str(entry.get("agent", "")), model, str(entry.get("id", "")), persona)


def parse_verdict(text: str) -> str:
    m = re.findall(r"^Review-Disposition:[ \t]*(\S+)[ \t]*$", text, re.M)
    return m[-1] if m else ""


def cmd_mint(a) -> int:
    root = Path(a.root).resolve()
    reg = load_registry(Path(a.registry) if a.registry else DEFAULT_REGISTRY)
    entry = reg.get(a.run_id)
    errs, full, rel, text = _run_checks(entry, root)
    if not re.fullmatch(r"[0-9a-f]{40}", a.head):
        errs.append("--head must be 40 lowercase hex")
    if entry and norm(entry.get("agent")) == norm(a.author_lane):
        errs.append(f"reviewer lane {entry.get('agent')!r} equals author lane")
    verdict = parse_verdict(text)
    if full is not None and full.is_file():
        if not text.strip():
            errs.append("output is empty")
        elif a.head not in text and a.head[:12] not in text:
            errs.append("output does not mention the head sha")
        if verdict not in VERDICTS:
            errs.append(f"output lacks a valid 'Review-Disposition:' line (got {verdict!r})")
    if errs:
        for e in errs:
            print(f"mint FAILED: {e}", file=sys.stderr)
        return 1
    receipt = {
        "schema": 1, "pr": a.pr, "reviewed_head_sha": a.head, "run_id": a.run_id,
        "reviewer_lane": entry["agent"], "author_lane": a.author_lane, "verdict": verdict,
        "reviewer_instance": reviewer_instance(entry),
        "author_instance": build_label(a.author_lane, a.author_model, a.author_session),
        "output_file": rel, "output_sha256": hashlib.sha256(full.read_bytes()).hexdigest(),
        "created_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    }
    try:
        receipt.update(schema=2, repo=a.repo or _repo_slug(root), policy_version=POLICY_VERSION,
                       tree=_git(root, "rev-parse", f"{a.head}^{{tree}}"),
                       base_commit=a.base or _git(root, "merge-base", a.head, "refs/remotes/origin/main"))
    except (subprocess.SubprocessError, OSError, ValueError) as exc:
        print(f"mint FAILED: cannot bind head to tree/base/repo ({exc.__class__.__name__}); fetch the head and origin/main", file=sys.stderr)
        return 1
    out = Path(a.out) if a.out else MAIN_ROOT / ".agents/delegation/review-receipts" / f"pr{a.pr}-{a.head[:12]}.json"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(receipt, indent=2) + "\n", encoding="utf-8")
    print(f"wrote {out}")
    return 0


def _git(root, *args, env=None, input=None, timeout=GIT_TIMEOUT):
    r = subprocess.run(["git", "-C", str(root), "-c", "commit.gpgsign=false", *args], capture_output=True, text=True,
                       env=env, input=input, timeout=timeout)
    if r.returncode != 0:
        raise subprocess.CalledProcessError(r.returncode, args, r.stdout, r.stderr)
    return r.stdout.strip()


def _repo_slug(root) -> str:
    url = _git(root, "remote", "get-url", "origin")
    m = re.search(r"github\.com[:/]([\w.-]+/[\w.-]+?)(?:\.git)?/?$", url)
    if not m:
        raise ValueError("cannot derive owner/repo from origin; pass --repo")
    return m.group(1)


def verify_receipt(path: Path, root: Path, registry: Path) -> list[str]:
    try:
        r = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        return [f"unreadable receipt: {exc.__class__.__name__}"]
    if not isinstance(r, dict) or r.get("schema") not in (1, 2):
        return ["not a schema 1 or 2 receipt"]
    entry = load_registry(registry).get(r.get("run_id"))
    errs, full, rel, text = _run_checks(entry, root)
    if entry and norm(entry.get("agent")) != norm(r.get("reviewer_lane")):
        errs.append("registry agent != receipt reviewer_lane")
    if norm(r.get("reviewer_lane")) == norm(r.get("author_lane")):
        errs.append("reviewer_lane == author_lane")
    # Key absent only on old receipts; any present value (even "" or null) must match.
    if entry and "reviewer_instance" in r and r["reviewer_instance"] not in (
            reviewer_instance(entry, True), reviewer_instance(entry, False)):
        errs.append("receipt reviewer_instance != label derived from the registry run")
    if rel is not None and rel != r.get("output_file"):
        errs.append("registry output_file != receipt output_file")
    if full is not None and full.is_file():
        if hashlib.sha256(full.read_bytes()).hexdigest() != r.get("output_sha256"):
            errs.append("output_sha256 mismatch")
        rhead = r.get("reviewed_head_sha")
        if not isinstance(rhead, str) or not re.fullmatch(r"[0-9a-f]{40}", rhead):
            errs.append("receipt reviewed_head_sha must be 40 lowercase hex")
        elif not text.strip() or (rhead not in text and rhead[:12] not in text):
            errs.append("output is empty or does not mention reviewed head")
        if r.get("verdict") not in VERDICTS or r.get("verdict") != parse_verdict(text):
            errs.append("receipt verdict != last Review-Disposition in output")
    if r.get("schema") == 2:
        for k in ("tree", "base_commit"):
            if not re.fullmatch(r"[0-9a-f]{40}", str(r.get(k, ""))):
                errs.append(f"receipt {k} must be 40 lowercase hex")
        if not re.fullmatch(r"[\w.-]+/[\w.-]+", str(r.get("repo", ""))):
            errs.append("receipt repo must be owner/name")
        if r.get("policy_version") != POLICY_VERSION:
            errs.append("receipt policy_version unknown")
        if type(r.get("pr")) is not int:
            errs.append("receipt pr must be an integer")
    return errs


def cmd_publish(a) -> int:
    """Append a verified schema 2 receipt to the review-receipts branch (plumbing only; idempotent)."""
    root = Path(a.root).resolve()
    src = Path(a.receipt)
    errs = verify_receipt(src, root, Path(a.registry) if a.registry else DEFAULT_REGISTRY)
    try:
        r = json.loads(src.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        r = {}
    if r.get("schema") != 2:
        errs.append("publish needs a schema 2 receipt (from mint)")
    if errs:
        for e in errs:
            print(f"publish FAILED: {e}", file=sys.stderr)
        return 1
    path = f"receipts/pr{r['pr']}-{r['reviewed_head_sha'][:12]}.json"
    blob_text = json.dumps(r, indent=2) + "\n"
    env_id = {"GIT_AUTHOR_NAME": "aq-review-receipt", "GIT_AUTHOR_EMAIL": RECEIPT_EMAIL,
              "GIT_COMMITTER_NAME": "aq-review-receipt", "GIT_COMMITTER_EMAIL": RECEIPT_EMAIL}
    ref = f"refs/heads/{RECEIPT_BRANCH}"
    last = ""
    for _ in range(PUBLISH_RETRIES):
        try:
            parent = ""
            if _git(root, "ls-remote", a.remote, ref):
                _git(root, "fetch", "--no-tags", "-q", a.remote, ref)
                parent = _git(root, "rev-parse", "FETCH_HEAD")
            with tempfile.TemporaryDirectory() as td:
                env = {**os.environ, **env_id, "GIT_INDEX_FILE": os.path.join(td, "index")}
                if parent:
                    _git(root, "read-tree", parent, env=env)
                    try:
                        existing = json.loads(_git(root, "show", f"{parent}:{path}"))
                    except subprocess.CalledProcessError:
                        existing = None
                    if existing is not None:
                        same = {k: v for k, v in existing.items() if k != "created_at"} == {k: v for k, v in r.items() if k != "created_at"}
                        if same:
                            print(f"already published: {RECEIPT_BRANCH}:{path}")
                            return 0
                        if existing.get("verdict") != "REQUEST_CHANGES":
                            print(f"publish FAILED: {path} already holds a different {existing.get('verdict')} receipt (append-only)", file=sys.stderr)
                            return 1
                blob = _git(root, "hash-object", "-w", "--stdin", input=blob_text)
                _git(root, "update-index", "--add", "--cacheinfo", f"100644,{blob},{path}", env=env)
                tree = _git(root, "write-tree", env=env)
                cmd = ["commit-tree", tree, "-m", f"receipt PR {r['pr']} {r['reviewed_head_sha'][:12]} {r['verdict']}"]
                if parent:
                    cmd += ["-p", parent]
                commit = _git(root, *cmd, env=env)
            _git(root, "push", "-q", a.remote, f"{commit}:{ref}", timeout=PUSH_TIMEOUT)
            print(f"published {RECEIPT_BRANCH}:{path} ({commit[:12]})")
            return 0
        except subprocess.TimeoutExpired as exc:
            what = " ".join(str(x) for x in exc.cmd[:3]) if isinstance(exc.cmd, (list, tuple)) else "git"
            print(f"publish FAILED: git timed out after {int(exc.timeout)}s ({what}); not retrying because the push state is "
                  f"unknown. Check {RECEIPT_BRANCH} on {a.remote}, then re-run publish (it is idempotent).", file=sys.stderr)
            return 1
        except subprocess.CalledProcessError as exc:
            last = (exc.stderr or "").strip()[:300]  # non-fast-forward or transient: rebuild on the new tip
        except (subprocess.SubprocessError, OSError, ValueError) as exc:
            print(f"publish FAILED: {exc.__class__.__name__}: {str(exc)[:200]}", file=sys.stderr)
            return 1
    print(f"publish FAILED after {PUBLISH_RETRIES} attempts: {last}", file=sys.stderr)
    return 1


def cmd_verify(a) -> int:
    root = Path(a.root).resolve()
    reg = Path(a.registry) if a.registry else DEFAULT_REGISTRY
    errs = verify_receipt(Path(a.receipt), root, reg)
    for e in errs:
        print(f"verify FAILED: {e}", file=sys.stderr)
    if not errs:
        print("receipt OK")
    return 1 if errs else 0


def cmd_audit(a) -> int:
    root = Path(a.root).resolve()
    reg = Path(a.registry) if a.registry else DEFAULT_REGISTRY
    bad = 0
    print(f"{'receipt':40} {'reviewer':12} {'verdict':20} result")
    for p in sorted((root / RECEIPT_DIR).glob("*.json")):
        try:
            r = json.loads(p.read_text(encoding="utf-8"))
        except ValueError:
            r = {}
        if a.since and str(r.get("created_at", ""))[:10] < a.since:
            continue
        errs = verify_receipt(p, root, reg)
        bad += bool(errs)
        print(f"{p.name:40} {str(r.get('reviewer_lane', '?')):12} {str(r.get('verdict', '?')):20} "
              f"{'OK' if not errs else 'FAIL: ' + '; '.join(errs)}")
    return 1 if bad else 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--root", default=str(ROOT))
    ap.add_argument("--registry", default="")
    sub = ap.add_subparsers(dest="cmd", required=True)
    m = sub.add_parser("mint")
    m.add_argument("--run-id", required=True)
    m.add_argument("--pr", type=int, required=True)
    m.add_argument("--head", required=True)
    m.add_argument("--author-lane", required=True)
    m.add_argument("--author-model", default="")
    m.add_argument("--author-session", default="")
    m.add_argument("--offbranch", action="store_true", help="accepted for old callers; every mint is off-branch")
    m.add_argument("--repo", default="")
    m.add_argument("--base", default="")
    m.add_argument("--out", default="")
    m.set_defaults(fn=cmd_mint)
    pb = sub.add_parser("publish")
    pb.add_argument("receipt")
    pb.add_argument("--remote", default="origin")
    pb.set_defaults(fn=cmd_publish)
    v = sub.add_parser("verify")
    v.add_argument("receipt")
    v.set_defaults(fn=cmd_verify)
    u = sub.add_parser("audit")
    u.add_argument("--since", default="")
    u.set_defaults(fn=cmd_audit)
    a = ap.parse_args()
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
