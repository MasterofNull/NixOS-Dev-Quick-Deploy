#!/usr/bin/env python3
"""aq-risk-tier -- FT-6 risk classifier CLI (report-only; always exits 0 on a successful classification).

  aq-risk-tier --staged | --paths P [P...]  [--claimed TIER] [--json]
"""
try:  # aq-usage-hook
    import importlib.util as _aqu, os as _aqo
    _aqs = _aqu.spec_from_file_location("aq_usage", _aqo.path.join(_aqo.path.dirname(_aqo.path.realpath(__file__)), "lib", "aq_usage.py"))
    _aqm = _aqu.module_from_spec(_aqs); _aqs.loader.exec_module(_aqm); _aqm.record(__file__, __name__)
except Exception:
    pass
import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import risk_tier  # noqa: E402


def _git(*a):
    return subprocess.run(["git", *a], capture_output=True, text=True, check=False).stdout


def main():
    ap = argparse.ArgumentParser()
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--staged", action="store_true")
    g.add_argument("--paths", nargs="+")
    ap.add_argument("--claimed", help="tier claimed by caller; never lowers the computed tier")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    stats = None
    if a.staged:
        paths = [p for p in _git("diff", "--cached", "--name-only").splitlines() if p]
        add = dele = 0
        for ln in _git("diff", "--cached", "--numstat").splitlines():
            f = ln.split("\t")
            if len(f) >= 2 and f[0].isdigit() and f[1].isdigit():
                add += int(f[0]); dele += int(f[1])
        stats = {"added": add, "deleted": dele, "files": len(paths)}
    else:
        paths = a.paths
    res = risk_tier.classify(paths, stats, claimed=a.claimed)
    if a.json:
        print(json.dumps(res, sort_keys=True))
    else:
        pol = res["policy"]
        print(f"risk-tier={res['tier']} ({res['mode']}) min_reviewers={pol['min_reviewers']} "
              f"independent={pol['independent_reviewer_required']} lock={pol['lock']} "
              f"validation={','.join(pol['validation_set'])}")
        for r in res["reasons"]:
            print(f"  - {r}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
