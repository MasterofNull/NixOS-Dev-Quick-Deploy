#!/usr/bin/env bash
# Sandbox launcher for the playwright-mcp capability-intake candidate.
#
# Enforces the remaining REQUEST_REVISION boundaries from
# tasks_inbox/capability-intake-playwright-mcp.md ("Follow-up Patch Scope"):
#   1. Admission — both capability SSOTs must say enabled/accepted. A profile
#      name alone cannot promote a quarantined capability.
#   2. Enforcing AppArmor attachment — aa-exec attaches the verified profile;
#      there is no unconfined or advisory user-scope fallback.
#   3. Dynamic version check — re-resolves the pinned version + npm dist
#      integrity hash against the registry on every launch and refuses to
#      run on drift, mismatch, or lookup failure (fail closed). This is the
#      concrete defense against the finding's "npx dynamic installer which
#      fetches mutable remote packages" risk: a same-version-string
#      republish under the pinned tag changes dist.integrity and is caught
#      here, not just a floating/@latest tag.
#
# All Playwright MCP client entries (.claude/settings.json, .gemini/settings.json,
# ai-stack/continue/config.json, config/agent-capability-intake-candidates.json)
# invoke this wrapper instead of calling npx directly. Each still declares
# "-y" "@playwright/mcp@0.0.76" as its first two args (asserted by
# scripts/testing/test-enabled-external-mcp-candidates.py) — this wrapper
# checks those two args match its own hardcoded pin before doing anything
# network-facing, so a config file edited out of step with this wrapper's
# pin is caught immediately rather than silently launching a different
# version.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/../.." && pwd)"
CANDIDATE_REGISTRY="${REPO_ROOT}/config/agent-capability-intake-candidates.json"
CAPABILITY_CATALOG="${REPO_ROOT}/config/system-capability-catalog.json"

PINNED_PACKAGE="@playwright/mcp"
PINNED_VERSION="0.0.76"
PINNED_SPEC="${PINNED_PACKAGE}@${PINNED_VERSION}"
APPARMOR_PROFILE="mcp-playwright"
APPARMOR_PROFILES_PATH="/sys/kernel/security/apparmor/profiles"
# Captured 2026-07-23 via: npm view @playwright/mcp@0.0.76 dist.integrity
PINNED_INTEGRITY="sha512-ICcW6wAV+HoNEco19eni+JTVylCIIedruWkrRl2Rsv/qcGhBZLT/c0I1VounjIjSVSupw3pHmcr3CNCikTHTBQ=="

verify_admission() {
  if ! python3 - "${CANDIDATE_REGISTRY}" "${CAPABILITY_CATALOG}" <<'PY'
import json
import sys
from pathlib import Path

candidate_doc = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
catalog_doc = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
candidate = next((item for item in candidate_doc.get("candidates", []) if item.get("id") == "playwright-mcp"), None)
catalog = next((item for item in catalog_doc.get("capabilities", []) if item.get("id") == "playwright-mcp"), None)
accepted = {"accepted", "accepted-with-mitigations"}
if not (
    isinstance(candidate, dict)
    and candidate.get("state") == "enabled"
    and candidate.get("review_status") in accepted
    and not candidate.get("blocked_reason")
    and isinstance(catalog, dict)
    and catalog.get("state") == "enabled"
    and (catalog.get("security") or {}).get("admission") in accepted
):
    raise SystemExit(1)
PY
  then
    echo "mcp-playwright-sandboxed: ADMISSION UNAVAILABLE — capability SSOTs are not enabled and independently accepted" >&2
    return 1
  fi
}

verify_apparmor_confinement() {
  if ! command -v aa-exec >/dev/null 2>&1; then
    echo "mcp-playwright-sandboxed: UNAVAILABLE — aa-exec launcher is absent; refusing unconfined browser execution" >&2
    return 1
  fi
  if [[ ! -r "${APPARMOR_PROFILES_PATH}" ]]; then
    echo "mcp-playwright-sandboxed: UNAVAILABLE — AppArmor profile state is unreadable; confinement cannot be verified" >&2
    return 1
  fi
  if ! grep -Fqx "${APPARMOR_PROFILE} (enforce)" "${APPARMOR_PROFILES_PATH}" 2>/dev/null; then
    echo "mcp-playwright-sandboxed: UNAVAILABLE — required AppArmor profile ${APPARMOR_PROFILE} is not enforce-mode loaded or cannot be inspected" >&2
    return 1
  fi
}

if [[ "${1:-}" == "--check-confinement" ]]; then
  if verify_apparmor_confinement; then
    echo "mcp-playwright-sandboxed: confinement AVAILABLE — ${APPARMOR_PROFILE} is enforced" >&2
    exit 0
  fi
  exit 1
fi

if [[ "${1:-}" == "--check-admission" ]]; then
  if verify_admission; then
    echo "mcp-playwright-sandboxed: admission AVAILABLE — both capability SSOTs are accepted" >&2
    exit 0
  fi
  exit 1
fi

# Reject before package registry access: a loaded profile name is not sufficient
# authority while either capability SSOT remains quarantined or unaccepted.
verify_admission || exit 1
verify_apparmor_confinement || exit 1

# --- Mitigation 2a: config/wrapper pin agreement ---
if [[ "${1:-}" != "-y" || "${2:-}" != "${PINNED_SPEC}" ]]; then
  echo "mcp-playwright-sandboxed: refusing to launch — expected '-y ${PINNED_SPEC}' as the first two args, got '${1:-}' '${2:-}' (client config / wrapper pin drift)" >&2
  exit 1
fi
shift 2

# --- Mitigation 2b: dynamic registry version + integrity check (fail closed) ---
resolved_version="$(npm view "${PINNED_SPEC}" version 2>/dev/null || true)"
if [[ -z "${resolved_version}" ]]; then
  echo "mcp-playwright-sandboxed: could not resolve ${PINNED_SPEC} from the npm registry — refusing to launch (fail closed; offline or registry unreachable)" >&2
  exit 1
fi
if [[ "${resolved_version}" != "${PINNED_VERSION}" ]]; then
  echo "mcp-playwright-sandboxed: version drift detected — expected ${PINNED_VERSION}, registry reports ${resolved_version} — refusing to launch" >&2
  exit 1
fi

resolved_integrity="$(npm view "${PINNED_SPEC}" dist.integrity 2>/dev/null || true)"
if [[ -z "${resolved_integrity}" ]]; then
  echo "mcp-playwright-sandboxed: could not resolve dist.integrity for ${PINNED_SPEC} — refusing to launch (fail closed)" >&2
  exit 1
fi
if [[ "${resolved_integrity}" != "${PINNED_INTEGRITY}" ]]; then
  echo "mcp-playwright-sandboxed: dist.integrity drift detected for ${PINNED_SPEC} — expected ${PINNED_INTEGRITY}, registry reports ${resolved_integrity} — refusing to launch (possible tampered republish under the pinned version)" >&2
  exit 1
fi

# A real loaded AppArmor profile is the confinement boundary. `aa-exec` attaches
# the MCP process to that exact enforce-mode profile; no unconfined or advisory
# user-scope fallback exists. Profile policy and Nix activation remain separately
# authorized future work.
exec aa-exec -p "${APPARMOR_PROFILE}" -- npx -y "${PINNED_SPEC}" "$@"
