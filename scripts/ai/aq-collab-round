def _write_manifest(rd: Path, name: str, task: str, target: str) -> None:
    """F1.5: write round.json (state DISPATCHED) beside the per-agent files. Best-effort; never raises."""
    if not _LIB_OK:
        return
    try:
        m = _rstate.RoundManifest(
            round_id=name, state=_rstate.RoundState.CREATED,
            task=_rstate.RoundTask(prompt=task, target=target or "", scope_files=[]),
            opened_at=_rstate.utc_iso(),
            quorum_policy=_rstate.QuorumPolicy(min_lanes=2, required_agents=[],
                                               timeout_seconds=None, deadline=None),
            lanes=[], consensus_hash=None, aggregate_path=None, aggregate_hash=None, locked_at=None)
        for agent in ALL_AGENTS:
            _raggr.register_lane(m, agent, "reviewer", task)
        m = _rstate.transition(m, _rstate.RoundState.DISPATCHED, "aq-collab-round")
        _rstate.save(m, rd / "round.json")
    except Exception:  # noqa: BLE001
        pass


def _typed_consensus(rd: Path, name: str) -> str | None:
    """F1.5: read-only typed aggregation over whatever contributions are present. Returns a one-line
    printable summary, or None if the lib is unavailable or anything fails. NEVER mutates <agent>.md
    (uses the read-only extract_contribution); persists round.json only when it already exists (round-
    owned, derived)."""
    if not _LIB_OK:
        return None
    try:
        rjson = rd / "round.json"
        if rjson.exists():
            m = _rstate.load(rjson)
        else:  # legacy round — synthesize an in-memory manifest, never written for legacy dirs
            m = _rstate.RoundManifest(
                round_id=name, state=_rstate.RoundState.CREATED,
                task=_rstate.RoundTask(prompt="(legacy)", target="", scope_files=[]),
                opened_at=_rstate.utc_iso(),
                quorum_policy=_rstate.QuorumPolicy(min_lanes=2, required_agents=[],
                                                   timeout_seconds=None, deadline=None),
                lanes=[], consensus_hash=None, aggregate_path=None, aggregate_hash=None, locked_at=None)
            for agent in _round_agents(rd):
                _raggr.register_lane(m, agent, "reviewer", "(legacy)")
            m = _rstate.transition(m, _rstate.RoundState.DISPATCHED, "aq-collab-round")
        try:
            disp = json.loads((rd / ".round-dispatch.json").read_text()).get("dispatch", {})
        except Exception:  # noqa: BLE001
            disp = {}
        contribs = {}
        review_subject = _review_subject(rd)
        for agent in _round_agents(rd):
            markdown = rd / f"{agent}.md"
            if not markdown.exists() and agent not in disp:
                continue
            # Hash-bound reviews only aggregate a landed, validated artifact.
            # A terminal provider log may be truncated or unavailable and must
            # never be projected as a synthetic ABSTAIN contribution.
            if review_subject is not None and not markdown.exists():
                continue
            if markdown.exists():
                ok, _reason = _validate_review_contribution(
                    rd, markdown.read_text(encoding="utf-8", errors="replace")
                )
                if not ok:
                    continue
            tid = str(disp.get(agent, ""))
            log = OUTPUTS / f"{tid}.log" if tid and not tid.startswith(("inbox", "error", "running")) else None
            # For a hash-bound review the validated Markdown is authoritative;
            # generic rounds retain the legacy log fallback.
            use_log = None if review_subject is not None else (log if (log and log.exists()) else None)
            c, _note = _rcontrib.extract_contribution(agent, rd, use_log)
            if c is not None:
                contribs[agent] = c
        if not contribs:
            return None
        if m.state == _rstate.RoundState.DISPATCHED:
            m = _rstate.transition(m, _rstate.RoundState.CONTRIBUTING, "aq-collab-round")
        if m.state == _rstate.RoundState.CONTRIBUTING:
            m = _rstate.transition(m, _rstate.RoundState.COLLECTED, "aq-collab-round")
        for lane in m.lanes:  # F1.5: reflect landed contributions so quorum_met is accurate
            if lane.agent in contribs:
                lane.status = _rstate.LaneStatus.submitted
        # v1/fallback contributions remain readable, but are explicitly untrusted and
        # cannot create v2 decision/authorization evidence. This compatibility path is
        # presentation-only; assignment requires an ImplementationAuthorization.
        legacy_untrusted = any(
            c.schema_version != "2.0" or not c.producer_verified for c in contribs.values()
        )
        if m.state == _rstate.RoundState.COLLECTED and not legacy_untrusted:
            m = _raggr.aggregate(m, contribs)
        if rjson.exists():
            _rstate.save(m, rjson)  # round-owned derived file; legacy dirs are never written
        tally: dict[str, int] = {}
        for c in contribs.values():
            tally[c.verdict.value] = tally.get(c.verdict.value, 0) + 1
        trust = "legacy_untrusted" if legacy_untrusted else "evidence_bound"
        return (f"typed consensus: state={m.state.value} trust={trust} verdicts={tally} "
                f"conflicts={len(m.conflicts)} hash={(m.consensus_hash or '—')[:12]}")
    except Exception:  # noqa: BLE001 — typed path is additive; never break collect
        return None


def _round_dir(name: str) -> Path:
    return PLANS / name


def _round_agents(rd: Path) -> list:
    """Current seats plus any retired seat that landed a file in this (older) round."""
    return ALL_AGENTS + [a for a in LEGACY_AGENTS if (rd / f"{a}.md").exists()]


def _now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _readme(name: str, task: str, target: str) -> str:
    return f"""# Collaborative Round — {name}

Opened: {_now()}
Target artifact (if a review round): {target or '(none — fresh drafting round)'}

## Task
{task}

## Protocol
Each agent writes its OWN file here — `codex.md`, `local.md`, `gemini.md`, `claude.md`.
NEVER append to a shared file. The orchestrator aggregates into `AGGREGATE.md`.
- local[Qwen] runs long — the round stays OPEN for it; never skipped.
- gemini (headless Gemini CLI via delegate-to-gemini, plan mode, its OWN OAuth) replies read-only;
  `collect` records the reply as `gemini.md`. No API keys.
"""


# Local (on-host APU) runs with a ~12000-char context budget (agent_executor
# _CTX_CHAR_BUDGET). Inline no more than this for local so the task text, system
# prompt, and the model's own reasoning still fit without triggering the
# pinned+sliding prune that evicts the very content under review. Genuinely large
# artifacts need chunked map-reduce, not a bigger inline (see the local-lane
# large-context note in docs/operations/collab-workflow-exposure.md).
LOCAL_INLINE_CAP = 7000


def _write_prompt(rd: Path, name: str, task: str, target: str) -> Path:
    # INLINE the target artifact (do not make agents READ a file). local[Qwen] chunk-reads a
    # --target file and burns its whole run on re-reading (observed: it never designs). Inlining
    # (capped) makes every lane — especially local — see the artifact directly. Live finding from
    # the f1 round.
    target_block = ""
    if target:
        try:
            tp = Path(target) if Path(target).is_absolute() else (REPO / target)
            content = tp.read_text(encoding="utf-8")
            target_block = (f"=== REVIEW ARTIFACT ({target}) — INLINED; do NOT read the file ===\n"
                            f"{content[:12000]}\n=== END ARTIFACT ===\n\n")
        except OSError:
            target_block = f"Review artifact: {target} (read it).\n"
    prompt = (f"COLLABORATIVE ROUND '{name}'.\n{target_block}"
              f"TASK:\n{task}\n\n"
              f"Write your contribution to YOUR OWN file ONLY: "
              f".agents/plans/{name}/<AGENT>.md (<AGENT> = codex | local | gemini). "
              f"Do NOT edit any shared file. Do NOT read the artifact file (it is inlined above). "
              f"Be decisive and concise.")
    pf = rd / ".round-prompt.txt"
    pf.write_text(prompt)

    # LOCAL variant — the on-host APU agent runs with a hard ~12000-char context
    # budget (agent_executor _CTX_CHAR_BUDGET; Qwen3-35B re-prefills fully every
    # call, so context is capped for latency). A full multi-file review blows that
    # budget: reading files via tool calls evicts their content (pinned+sliding
    # prune), so the model sees fragments, believes the content is "compacted",
    # re-reads in a loop, and abstains — the exact failure observed in the f1/
    # dispatch-integration rounds. So local gets: (a) a SMALLER inlined slice that
    # fits with reasoning headroom, and (b) explicit leaf-node rules — never read
    # more files, never delegate/hand off, judge only what is inlined.
    local_target_block = ""
    if target:
        try:
            tp = Path(target) if Path(target).is_absolute() else (REPO / target)
            _c = tp.read_text(encoding="utf-8")
            local_target_block = (
                f"=== REVIEW SLICE ({target}) — INLINED (may be truncated to fit your "
                f"context budget); judge ONLY what is shown ===\n{_c[:LOCAL_INLINE_CAP]}\n"
                f"=== END SLICE ===\n\n")
        except OSError:
            local_target_block = ""
    local_prompt = (
        f"COLLABORATIVE ROUND '{name}' — LOCAL lane (on-host APU, small context).\n"
        f"{local_target_block}TASK:\n{task}\n\n"
        f"LEAF-NODE RULES (hard — you are the final responder on this lane):\n"
        f"- Do NOT read additional files. Your context is small; reading evicts prior "
        f"content and you lose your work. Judge ONLY the material inlined above.\n"
        f"- Do NOT delegate, hand off, or emit another agent's name/tag. There is no "
        f"agent after you on this lane; produce YOUR OWN verdict.\n"
        f"- Never reply that content is 'compacted' or ask to re-read — work with what "
        f"is inlined. If a full verdict needs more than is shown, give a decisive verdict "
        f"on the specific aspect(s) you CAN assess from the inlined slice, and name the "
        f"one thing you could not see. A scoped, real insight beats an abstention.\n\n"
        f"Write your contribution to YOUR OWN file ONLY: .agents/plans/{name}/local.md. "
        f"Be decisive and concise (a few short paragraphs).")
    (rd / ".round-prompt-local.txt").write_text(local_prompt)
    # GEMINI variant — plan mode cannot write files, so the reply text IS the contribution.
    gemini_prompt = (
        f"{GEMINI_SCOPE_STOP_PREAMBLE}COLLABORATIVE ROUND '{name}' — GEMINI lane (headless, read-only).\n"
        f"{target_block}TASK:\n{task}\n\n"
        f"Reply with your complete contribution as your final message; aq-collab-round records it as "
        f".agents/plans/{name}/gemini.md. Be decisive and concise.")
    (rd / ".round-prompt-gemini.txt").write_text(gemini_prompt)
    return pf


_TASK_ID_RE = re.compile(r"\] Delegating task:\s*(\S+)")


def _parse_task_id(stdout: str) -> str:
    """Task id from the shim's 'Delegating task: <id>' line ('' when it never got there)."""
    m = _TASK_ID_RE.search(stdout or "")
    return m.group(1) if m else ""


def _dispatch_process(agent: str, prompt_file: Path, local_timeout: int) -> str:
    """Fire a live process dispatch (codex/local/gemini), background. Returns the task id (or error)."""
    try:
        if agent == "codex":
            # Isolated worktree, not --shared: delegate-to-codex refuses shared editing,
            # and collect imports the lane's owned file from its terminal worktree.
            cmd = ["bash", str(SCRIPTS / "delegate-to-codex"), "--mode", "edit",
                   "--prompt-file", str(prompt_file)]
            env = os.environ
        elif agent == "gemini":
            # Headless Gemini CLI, read-only plan mode; the reply is recorded by collect.
            gem_pf = prompt_file.parent / ".round-prompt-gemini.txt"
            use_pf = gem_pf if gem_pf.exists() else prompt_file
            cmd = ["bash", str(SCRIPTS / "delegate-to-gemini"), "--role", "reviewer",
                   "--mode", "plan", "--prompt-file", str(use_pf)]
            env = {**os.environ, "AQ_AGENT_ROLE": "reviewer"}
        else:  # local — never-skip: agent-mode, budget-fitting local prompt, async
            # Use the local-specific bounded prompt (smaller inline + leaf-node rules)
            # when present; fall back to the shared prompt for older/dry callers.
            local_pf = prompt_file.parent / ".round-prompt-local.txt"
            use_pf = local_pf if local_pf.exists() else prompt_file
            cmd = ["bash", str(SCRIPTS / "delegate-to-local"), "--mode", "agent", "--role",
                   "reviewer", "--timeout", str(local_timeout), "--prompt-file", str(use_pf)]
            env = {**os.environ, "AQ_AGENT_ROLE": "reviewer"}
        # The shims detach the real task and exit; pre-launch gates (consult, budget,
        # worktree) can take well over 30s, and a run() timeout kills the shim before
        # it launches anything.
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=env,
            start_new_session=True,
        )
        try:
            stdout, stderr = proc.communicate(timeout=300)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            proc.communicate()
            return "error:launch-timeout"
        tid = _parse_task_id(stdout)
        if tid and proc.returncode == 0:
            return tid
        err = (stderr.strip().splitlines() or stdout.strip().splitlines() or ["no output"])[-1]
        return f"error:rc={proc.returncode}:{err[:300]}"
    except Exception as e:  # noqa: BLE001 — one lane failing must not abort the fan-out
        return f"error:{e}"


_TASK_PATH_RE = re.compile(r"(?<![\w/.-])((?:\.?[\w-]+/)+[\w.-]+\.\w+)")


def _uncommitted_task_inputs(task: str) -> list[str]:
    """Repo paths named in the task that are untracked or differ from HEAD.

    Isolated lanes run in worktrees cut from HEAD, so such inputs are missing or
    stale there (round tiered-auto-update-prd-r2: codex could not see the PRD).
    """
    bad = []
    for rel in sorted(set(_TASK_PATH_RE.findall(task or ""))):
        if not (REPO / rel).exists():
            continue
        tracked = subprocess.run(["git", "-C", str(REPO), "ls-files", "--error-unmatch", rel],
                                 capture_output=True).returncode == 0
        clean = tracked and subprocess.run(["git", "-C", str(REPO), "diff", "--quiet", "HEAD", "--", rel],
                                           capture_output=True).returncode == 0
        if not clean:
            bad.append(rel)
    return bad


def cmd_open(args) -> int:
    rd = _round_dir(args.round)
    dirty = _uncommitted_task_inputs(args.task)
    if dirty and not args.allow_uncommitted_inputs:
        print("[aq-collab-round] refusing to open: isolated lanes see HEAD, but these task inputs "
              f"are uncommitted: {', '.join(dirty)}. Commit them or pass --allow-uncommitted-inputs.",
              file=sys.stderr)
        return 2
    if args.dry_run:
        print(f"[dry-run] would open '{args.round}' at {rd}")
        print(f"[dry-run] dispatch: codex(edit), local(agent,{args.local_timeout}s,inlined,never-skip)")
        print("[dry-run] gemini: delegate-to-gemini --role reviewer --mode plan (headless, read-only)")
        print(f"[dry-run] claude: orchestrator writes {args.round}/claude.md + aggregates")
        return 0
    rd.mkdir(parents=True, exist_ok=True)
    (rd / "README.md").write_text(_readme(args.round, args.task, args.target or ""))
    pf = _write_prompt(rd, args.round, args.task, args.target or "")

    dispatch = {}
    print(f"[aq-collab-round] opened '{args.round}' at {rd.relative_to(REPO)}")
    for agent in PROCESS_AGENTS:
        tid = _dispatch_process(agent, pf, args.local_timeout)
        dispatch[agent] = tid
        print(f"  {agent}: dispatched {tid}")
    print(f"  claude: orchestrator writes {args.round}/claude.md + aggregates")
    (rd / ".round-dispatch.json").write_text(json.dumps(
        {"opened": _now(), "dispatch": dispatch}, indent=2))
    _write_manifest(rd, args.round, args.task, args.target or "")  # F1.5: round.json (best-effort)
    if (rd / "round.json").exists():
        print(f"  round.json: written (state=DISPATCHED)")
    print(f"\n  poll:    aq-collab-round status  --round {args.round}")
    print(f"  collect: aq-collab-round collect --round {args.round}   (auto-extracts local + gemini verdicts)")
    return 0


def _extract_local_verdict(rd: Path) -> str:
    """If local wrote no local.md but its dispatch log has a completed result, record it. Local
    often emits the verdict as TEXT (0 tool calls) — capture it so its contribution is never lost."""
    lf = rd / "local.md"
    if lf.exists():
        return "present"
    try:
        disp = json.loads((rd / ".round-dispatch.json").read_text()).get("dispatch", {})
    except Exception:
        return "no-dispatch-record"
    tid = disp.get("local", "")
    if not tid or tid.startswith(("error", "running")):
        return "local-not-dispatched-or-running"
    log = OUTPUTS / f"{tid}.log"
    if not log.exists():
        return "local-log-missing"
    try:
        d = json.loads(log.read_text())
    except Exception:
        return "local-running-or-unparsed"
    if d.get("status") != "completed":
        return f"local-{d.get('status','running')}"
    result = d.get("result")
    text = result if isinstance(result, str) else json.dumps(result)
    if not text:
        return "local-completed-empty"
    if d.get("success") is False or d.get("incomplete_result") is True:
        return "local-completed-incomplete"
    ok, reason = _validate_review_contribution(rd, text)
    if not ok:
        return f"local-completed-invalid:{reason}"
    lf.write_text(f"# local[Qwen] — round contribution (auto-extracted)\n\n"
                  f"_From dispatch `{tid}` (produced text, {len(d.get('tool_calls') or [])} tool "
                  f"calls; orchestrator recorded)._\n\n{text.strip()}\n")
    return "extracted"


_TERMINAL_DISPOSITIONS = (
    "ACCEPTED", "IMPLEMENTED_FOLLOWUP_REQUIRED", "ACTIVATION_BLOCKED", "REJECTED",
)


def _review_subject(rd: Path) -> str | None:
    """Return the exact hash bound by a review prompt, or None for drafting rounds."""
    prompt = rd / ".round-prompt.txt"
    try:
        text = prompt.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    match = re.search(
        r"(?i)(?:subject(?:\s+hash)?|commit)\s*[: ]\s*`?([0-9a-f]{40})`?", text
    )
    return match.group(1).lower() if match else None


def _validate_review_contribution(rd: Path, text: str) -> tuple[bool, str]:
    """Fail closed for hash-bound review output; drafting rounds remain compatible."""
    subject = _review_subject(rd)
    if subject is None:
        return True, "not-hash-bound"
    if subject not in text.lower():
        return False, "subject-missing"
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    if not lines or lines[-1] not in _TERMINAL_DISPOSITIONS:
        return False, "terminal-disposition-missing"
    dispositions = [line for line in lines if line in _TERMINAL_DISPOSITIONS]
    if dispositions != [lines[-1]]:
        return False, "terminal-disposition-ambiguous"
    return True, "valid"


def _delegation_record(task_id: str) -> dict | None:
    """Read the last registry record for one exact dispatch id."""
    try:
        lines = DELEGATION_REGISTRY.read_text(encoding="utf-8").splitlines()
    except OSError:
        return None
    record = None
    for line in lines:
        try:
            candidate = json.loads(line)
        except json.JSONDecodeError:
            continue
        if candidate.get("id") == task_id:
            record = candidate
    return record


def _import_isolated_contribution(rd: Path, agent: str) -> str:
    """Import only an agent's owned review file from its terminal isolated worktree."""
    target = rd / f"{agent}.md"
    if target.exists():
        return "present"
    try:
        dispatch = json.loads((rd / ".round-dispatch.json").read_text()).get("dispatch", {})
    except Exception:
        return "no-dispatch-record"
    task_id = dispatch.get(agent, "")
    if not isinstance(task_id, str) or not task_id:
        return "not-dispatched"
    record = _delegation_record(task_id)
    expected_agent = "local-agent" if agent == "local" else agent
    if not record or record.get("agent") not in {None, expected_agent}:
        return "registry-agent-mismatch"
    if record.get("status") not in {"done", "completed"}:
        return "not-terminal"
    worktree_raw = record.get("worktree")
    if not isinstance(worktree_raw, str) or not worktree_raw:
        return "no-isolated-worktree"
    worktree = Path(worktree_raw).resolve()
    expected_root = (REPO / ".agents" / "delegation" / "worktrees" / task_id).resolve()
    if worktree != expected_root or record.get("worktree_branch") not in {
        None, f"delegate/{task_id}"
    }:
        return "worktree-identity-mismatch"
    try:
        rel_round = rd.resolve().relative_to(REPO.resolve())
        candidate = worktree / rel_round / f"{agent}.md"
        if candidate.is_symlink():
            return "owned-file-unsafe"
        source = candidate.resolve(strict=True)
        source.relative_to(worktree)
    except (OSError, ValueError):
        return "owned-file-missing-or-unsafe"
    if not source.is_file() or source.stat().st_size > 1_048_576:
        return "owned-file-unsafe"
    try:
        text = source.read_text(encoding="utf-8", errors="strict")
    except (OSError, UnicodeError):
        return "owned-file-unreadable"
    ok, reason = _validate_review_contribution(rd, text)
    if not ok:
        return f"owned-file-invalid:{reason}"
    patch_raw = record.get("patch_file")
    patch_digest = None
    if isinstance(patch_raw, str) and patch_raw:
        patch_path = Path(patch_raw)
        if not patch_path.is_absolute():
            patch_path = REPO / patch_path
        try:
            patch_bytes = patch_path.read_bytes()
        except OSError:
            return "patch-receipt-missing"
        expected_header = f"b/{rel_round.as_posix()}/{agent}.md".encode()
        if expected_header not in patch_bytes:
            return "patch-owned-path-missing"
        patch_digest = hashlib.sha256(patch_bytes).hexdigest()
    target.write_text(text, encoding="utf-8")
    digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
    receipt = {
        "schema_version": "1.0",
        "agent": agent,
        "dispatch_id": task_id,
        "source_kind": "isolated-worktree-owned-file",
        "sha256": digest,
        "patch_sha256": patch_digest,
        "imported_at": _now(),
    }
    (rd / f".{agent}.import.json").write_text(
        json.dumps(receipt, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    return "imported"


def _legacy_round_alias(name: str) -> str | None:
    return LEGACY_ROUND_ALIASES.get(name)


_GEMINI_NOISE_RE = re.compile(
    r"^Warning:|^YOLO mode|^Attempt [0-9]+ failed|An unexpected critical|FetchError|ETIMED|EAI_AGAIN|"
    r"ENOTFOUND|retrying with backoff|^\s+at |node_modules|googleapis\.com|GaxiosError|AbortSignal|"
    r"errorRedactor|paramsSerializer|validateStatus|Symbol\(|response: undefined|^SUNSET_ERROR|"
    r"^\[delegate-to-gemini\]|^Loaded cached credentials|^Data collection is disabled")


def _extract_gemini_contribution(rd: Path) -> str:
    """Record the headless Gemini lane's final reply as gemini.md (plan mode is read-only)."""
    target = rd / "gemini.md"
    if target.exists():
        return "present"
    try:
        dispatch = json.loads((rd / ".round-dispatch.json").read_text()).get("dispatch", {})
    except Exception:
        return "no-dispatch-record"
    task_id = dispatch.get("gemini", "")
    if not isinstance(task_id, str) or not task_id or task_id.startswith("error"):
        return "not-dispatched"
    record = _delegation_record(task_id)
    if not record:
        return "registry-missing"
    if record.get("status") not in {"done", "completed"}:
        return f"not-terminal:{record.get('status', '?')}"
    log = OUTPUTS / f"{task_id}.log"
    try:
        raw = log.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return "log-missing"
    text = "\n".join(l for l in raw.splitlines() if not _GEMINI_NOISE_RE.search(l)).strip()
    if not text:
        return "completed-empty"
    ok, reason = _validate_review_contribution(rd, text)
    if not ok:
        return f"completed-invalid:{reason}"
    target.write_text(f"# gemini — round contribution (recorded from headless dispatch)\n\n"
                      f"_From dispatch `{task_id}` (delegate-to-gemini, plan mode)._\n\n{text}\n",
                      encoding="utf-8")
    receipt = {"schema_version": "1.0", "agent": "gemini", "dispatch_id": task_id,
               "source_kind": "headless-dispatch-log",
               "sha256": hashlib.sha256(text.encode("utf-8")).hexdigest(), "imported_at": _now()}
    (rd / ".gemini.import.json").write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n",
                                            encoding="utf-8")
    return "recorded"


def _validate_seat_contribution(rd: Path, agent: str) -> list[str]:
    """Return non-fatal review warnings for known proposal mistakes in a seat's file."""
    path = rd / f"{agent}.md"
    if not path.exists():
        return []
    text = path.read_text(encoding="utf-8", errors="replace")
    warnings = []
    
    is_parity = "parity" in rd.name.lower() or "usability" in rd.name.lower()

    if is_parity:
        required = [
            "# Verdict",
            "# Evidence Read",
            "# Expert-Team Findings",
            "# Ranked Parity Gaps",
            "# Proposed UX Architecture",
            "# Slice Plan",
            "# Validation Matrix",
            "# Risk Register",
            "# First Slice Recommendation",
            "# Open Questions",
        ]
        missing = [h for h in required if h not in text]
        if missing:
            warnings.append(f"{agent}-missing-headings:" + ",".join(missing))

    stale_path_lines = [
        line for line in text.splitlines()
        if ".agents/plans/usability-parity/" in line
        and ("write" in line.lower() or "output" in line.lower())
    ]
    if stale_path_lines:
        warnings.append(f"{agent}-mentions-superseded-output-path")
    forbidden = ["Google AI Studio", "active billing quota", "SOPS secret keys"]
    if any(term in text for term in forbidden):
        warnings.append(f"{agent}-provider-language-needs-no-key-review")

    if is_parity:
        gap_section = text.split("# Ranked Parity Gaps", 1)[-1].split("# Proposed UX Architecture", 1)[0]
        ranked_rows = 0
        for line in gap_section.splitlines():
            cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
            if cells and cells[0].isdigit():
                ranked_rows += 1
        numbered = sum(
            1
            for line in gap_section.splitlines()
            if any(line.lstrip().startswith(f"{i}.") for i in range(1, 11))
        )
        if max(ranked_rows, numbered) < 10:
            warnings.append(f"{agent}-ranked-gaps-fewer-than-10")
    return warnings


def cmd_status(args, do_extract: bool = False) -> int:
    rd = _round_dir(args.round)
    if not rd.exists():
        print(f"no round '{args.round}' at {rd}", file=sys.stderr)
        return 1
    if do_extract:
        for agent in [a for a in PROCESS_AGENTS if a != "gemini"]:
            imported = _import_isolated_contribution(rd, agent)
            if imported != "present":
                print(f"[collect] {agent} isolated contribution: {imported}")
        r = _extract_local_verdict(rd)
        print(f"[collect] local verdict: {r}")
        gr = _extract_gemini_contribution(rd)
        if gr != "present":
            print(f"[collect] gemini contribution: {gr}")
    print(f"[aq-collab-round] {args.round}")
    for agent in _round_agents(rd):
        f = rd / f"{agent}.md"
        print(f"  {agent:12} " + (f"✅ {f.stat().st_size}B" if f.exists() else "⏳ pending"))
    try:
        out = subprocess.run(["pgrep", "-af", "delegate-to|aq-agent-loop|codex exec"],
                             capture_output=True, text=True, timeout=5).stdout
        print(f"  active dispatch procs: {sum(1 for l in out.splitlines() if 'aq-collab-round' not in l and 'pgrep' not in l)}")
    except Exception:
        pass
    have = [a for a in _round_agents(rd) if (rd / f"{a}.md").exists()]
    print(f"  landed: {len(have)}/4 — {', '.join(have) or 'none'}")
    if do_extract:  # F1.5: collect/aggregate print the typed consensus (additive; None-safe)
        for seat in _round_agents(rd):
            for warning in _validate_seat_contribution(rd, seat):
                print(f"  warning: {warning}")
        tc = _typed_consensus(rd, args.round)
        if tc:
            print(f"  {tc}")
    return 0


def cmd_audit(args) -> int:
    """Print bounded, read-only round evidence; never treats legacy consensus as authorization."""
    path = _round_dir(args.round) / "round.json"
    if not _LIB_OK or not path.exists():
        print("audit unavailable: typed round manifest missing", file=sys.stderr)
        return 2
    manifest = _rstate.load(path)
    print(json.dumps({
        "round_id": manifest.round_id,
        "schema_version": manifest.schema_version,
        "state": manifest.state.value,
        "manifest_hash": _rstate.raw_artifact_hash(path.read_bytes()),
        "assignment_authorized": False,
        "authorization_reason": "LEGACY_STATE_NOT_AUTHORIZATION",
        "history": [entry.model_dump(mode="json") for entry in manifest.history[-128:]],
    }, sort_keys=True))
    return 0


def cmd_abort(args) -> int:
    path = _round_dir(args.round) / "round.json"
    if not _LIB_OK or not path.exists():
        print("abort unavailable: typed round manifest missing", file=sys.stderr)
        return 2
    manifest = _rstate.load(path)
    if manifest.state in {_rstate.RoundState.CLOSED, _rstate.RoundState.ABORTED}:
        print(f"abort refused: terminal state {manifest.state.value}", file=sys.stderr)
        return 2
    aborted = _rstate.transition(
        manifest, _rstate.RoundState.ABORTED, f"{args.actor}:abort:{args.reason}"
    )
    prior = _rstate.raw_artifact_hash(path.read_bytes())
    _rstate.commit_manifest_cas(aborted, path, prior)
    print(f"aborted {args.round}; reason={args.reason}")
    return 0


def cmd_reopen(args) -> int:
    """Create a new linked revision; immutable aborted evidence is never reopened in place."""
    old_path = _round_dir(args.round) / "round.json"
    new_dir = _round_dir(args.new_round)
    new_path = new_dir / "round.json"
    if not _LIB_OK or not old_path.exists():
        print("reopen unavailable: typed predecessor missing", file=sys.stderr)
        return 2
    predecessor = _rstate.load(old_path)
    if predecessor.state != _rstate.RoundState.ABORTED:
        print("reopen refused: predecessor must be ABORTED", file=sys.stderr)
        return 2
    if new_path.exists():
        print("reopen refused: new round already exists", file=sys.stderr)
        return 2
    new_dir.mkdir(parents=True, exist_ok=False)
    reopened = predecessor.model_copy(update={
        "round_id": args.new_round,
        "state": _rstate.RoundState.CREATED,
        "opened_at": _rstate.utc_iso(),
        "lanes": [], "contributions": {}, "conflicts": [],
        "consensus_hash": None, "aggregate_path": None, "aggregate_hash": None,
        "locked_at": None, "history": [], "predecessor_round_id": predecessor.round_id,
    })
    _rstate.commit_manifest_cas(reopened, new_path, None)
    print(f"reopened {args.round} as new revision {args.new_round}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="aq-collab-round", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)
    o = sub.add_parser("open", help="fan a task out to all agents")
    o.add_argument("--round", required=True); o.add_argument("--task", required=True)
    o.add_argument("--target"); o.add_argument("--local-timeout", type=int, default=5400)
    o.add_argument("--allow-uncommitted-inputs", action="store_true")
    o.add_argument("--dry-run", action="store_true"); o.set_defaults(fn=cmd_open)
    s = sub.add_parser("status", help="poll contributions"); s.add_argument("--round", required=True)
    s.set_defaults(fn=lambda a: cmd_status(a, do_extract=False))
    c = sub.add_parser("collect", help="poll + auto-extract local's verdict from its log")
    c.add_argument("--round", required=True); c.set_defaults(fn=lambda a: cmd_status(a, do_extract=True))
    g = sub.add_parser("aggregate", help="F1.5: typed aggregation over round.json (read-only on <agent>.md)")
    g.add_argument("--round", required=True); g.set_defaults(fn=lambda a: cmd_status(a, do_extract=True))
    au = sub.add_parser("audit", help="read-only typed evidence audit; never authorizes assignment")
    au.add_argument("--round", required=True); au.set_defaults(fn=cmd_audit)
    ab = sub.add_parser("abort", help="atomically abort a nonterminal typed round")
    ab.add_argument("--round", required=True); ab.add_argument("--actor", required=True)
    ab.add_argument("--reason", required=True); ab.set_defaults(fn=cmd_abort)
    reop = sub.add_parser("reopen", help="create a new revision linked to an aborted round")
    reop.add_argument("--round", required=True); reop.add_argument("--new-round", required=True)
    reop.set_defaults(fn=cmd_reopen)
    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
