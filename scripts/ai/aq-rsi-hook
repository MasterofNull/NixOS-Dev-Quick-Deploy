#!/usr/bin/env python3
"""Observe the installed hook without weakening its decision or replaying a tool."""
import json
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from rsi_lifecycle import failure


def run(command, payload, timeout=12):
    try:
        result = subprocess.run(command, input=payload, capture_output=True, timeout=timeout)
        code, stdout, stderr = result.returncode, result.stdout, result.stderr
    except subprocess.TimeoutExpired:
        code, stdout, stderr = 2, b"", b"RSI: upstream hook timed out; command blocked.\n"
    except OSError:
        code, stdout, stderr = 2, b"", b"RSI: upstream hook unavailable; command blocked.\n"
    denied = code != 0
    decision = {}
    try:
        decision = json.loads(stdout)
        denied |= decision.get("decision") == "block" or decision.get("hookSpecificOutput", {}).get("permissionDecision") == "deny"
    except (ValueError, AttributeError):
        pass
    if denied:
        # Never persist raw tool input or recommendations containing user commands.
        if b"Command should run via lean-ctx" in stderr + stdout:
            # Routing a raw shell command to lean-ctx is the policy working as designed, not a failure:
            # recording it opened a permanent incident (count 21) that no fix could ever close.
            return code, stdout, stderr
        try:
            hook_out = decision.get("hookSpecificOutput", {}) if isinstance(decision, dict) else {}
            reason = hook_out.get("permissionDecisionReason") or (decision.get("reason") if isinstance(decision, dict) else None)
            err_text = stderr.decode(errors="replace")
            combined = f"{reason or ''} {err_text}".lower()

            if any(k in combined for k in ("cve", "vulnerability", "security", "exploit")):
                failure("codex", "pre-tool-security", "security-policy", "hook/pre-tool-security",
                        "security-gate", reason or "upstream security hook denied tool execution",
                        severity="high",
                        root_fix="Remediate detected vulnerability or remove insecure package before re-executing")
            else:
                failure("codex", "pre-tool", "lean-ctx-pretooluse", "hook/codex-pretooluse",
                        "installed pre-tool policy", reason or "upstream hook denied or failed",
                        root_fix="Diagnose hook routing and caller contract; preserve command semantics and policy")
        except Exception as exc:
            stderr += f"RSI recording failed: {type(exc).__name__}; original hook decision preserved.\n".encode()
    return code, stdout, stderr


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "osi":
        if len(sys.argv) < 4:
            print("Usage: aq-rsi-hook osi <layer> <error_description>", file=sys.stderr)
            sys.exit(2)
        layer = sys.argv[2]
        error_msg = " ".join(sys.argv[3:])
        try:
            slug = failure(
                agent="osi-monitor",
                subject=f"osi:layer:{layer}",
                producer="osi-layer-hook",
                path=f"osi:layer:{layer}",
                authority="osi-hook",
                os_error=f"OSI layer {layer} failure: {error_msg}",
                severity="high",
                root_fix=f"Diagnose and recover OSI layer {layer} components",
            )
            print(f"RSI incident recorded for OSI layer {layer}: rsi-{slug}")
            sys.exit(0)
        except Exception as exc:
            print(f"Failed to record OSI layer incident: {exc}", file=sys.stderr)
            sys.exit(1)

    code, stdout, stderr = run(["/run/current-system/sw/bin/lean-ctx", "hook", "codex-pretooluse"], sys.stdin.buffer.read())
    sys.stdout.buffer.write(stdout)
    sys.stderr.buffer.write(stderr)
    raise SystemExit(code if code >= 0 else 2)
