#!/usr/bin/env python3
"""
aq-agent-window — Dedicated interactive terminal window for a single agent/model lane.

Lanes:
  • local   — Qwen3-35B on Local APU (llama.cpp :8080 / coordinator :8003)
  • claude  — Claude 3.7 / Fable-5 (switchboard :8085 / anthropic)
  • codex   — OpenAI Codex / GPT-4o (coordinator :8003 / openai)
  • gemini  — Google Gemini 2.5 / Antigravity (switchboard :8085 / google)

Can run standalone in its own Zellij pane or terminal window, receiving direct prompts
from the operator or broadcast dispatches from the central coordinator.
"""

import argparse
import asyncio
import json
import os
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

import httpx
from prompt_toolkit import PromptSession, HTML
from prompt_toolkit.history import FileHistory
from prompt_toolkit.styles import Style
from rich.console import Console
from rich.panel import Panel
from rich.syntax import Syntax
from rich.table import Table
from rich.text import Text

REPO_ROOT = Path(__file__).resolve().parent.parent.parent

HYBRID_URL = os.getenv("HYBRID_URL", "http://127.0.0.1:8003")
SWITCHBOARD_URL = os.getenv("SWITCHBOARD_URL", "http://127.0.0.1:8085")
LLAMA_URL = os.getenv("LLAMA_URL", "http://127.0.0.1:8080")

console = Console()

LANES = {
    "local": {
        "title": "󰚩 Qwen3-35B (Local APU)",
        "color": "#00d9ff",
        "backend": "Local APU :8080",
        "url": f"{HYBRID_URL}/v1/chat/completions",
        "model": "qwen3-35b",
        "prompt_symbol": "qwen",
    },
    "claude": {
        "title": "󰚩 Claude 3.7 / Fable-5",
        "color": "#ff79c6",
        "backend": "Switchboard :8085 (Anthropic)",
        "url": f"{SWITCHBOARD_URL}/v1/chat/completions",
        "model": "claude-fable-5",
        "prompt_symbol": "claude",
    },
    "codex": {
        "title": "󰚩 OpenAI Codex / GPT-4o",
        "color": "#50fa7b",
        "backend": "Coordinator :8003 (OpenAI)",
        "url": f"{HYBRID_URL}/v1/chat/completions",
        "model": "openai-codex",
        "prompt_symbol": "codex",
    },
    "gemini": {
        "title": "󰚩 Google Gemini 2.5",
        "color": "#bd93f9",
        "backend": "Switchboard :8085 (Google)",
        "url": f"{SWITCHBOARD_URL}/v1/chat/completions",
        "model": "gemini-2.5",
        "prompt_symbol": "gemini",
    },
}


class AgentWindow:
    def __init__(self, lane_key: str):
        self.lane_key = lane_key.lower().strip()
        self.lane = LANES.get(self.lane_key, LANES["local"])
        self.messages = []
        self.system_prompt = (
            f"You are the dedicated {self.lane['title']} agent in the AQ-OS workspace. "
            "Respond concisely, with working code, precise technical answers, and clear evidence."
        )
        self.history_file = Path.home() / f".aq_agent_{self.lane_key}_history"

    def render_header(self):
        txt = (
            f"[bold {self.lane['color']}]{self.lane['title']}[/bold {self.lane['color']}] · "
            f"[dim]{self.lane['backend']}[/dim]\n"
            "[dim]Direct prompt REPL for this model. Type /clear to reset, Ctrl+C to exit.[/dim]"
        )
        console.print(Panel(txt, border_style=self.lane["color"], padding=(0, 1)))

    async def stream_reply(self, prompt: str):
        messages = [{"role": "system", "content": self.system_prompt}] + self.messages + [{"role": "user", "content": prompt}]
        payload = {
            "model": self.lane["model"],
            "messages": messages,
            "temperature": 0.3,
            "stream": True,
        }

        t0 = time.monotonic()
        collected = []
        console.print(f"\n[bold {self.lane['color']}]{self.lane['prompt_symbol']}[/bold {self.lane['color']}] ───")

        try:
            async with httpx.AsyncClient(timeout=120.0) as client:
                async with client.stream("POST", self.lane["url"], json=payload) as resp:
                    if resp.status_code != 200:
                        body = await resp.aread()
                        console.print(f"[bold red]API Error {resp.status_code}: {body.decode('utf-8', errors='replace')}[/bold red]")
                        return

                    async for line in resp.aiter_lines():
                        if not line or not line.startswith("data: "):
                            continue
                        data = line[6:].strip()
                        if data == "[DONE]":
                            break
                        try:
                            chunk = json.loads(data)
                            choices = chunk.get("choices") or []
                            if choices:
                                delta = choices[0].get("delta", {}).get("content", "")
                                if delta:
                                    sys.stdout.write(delta)
                                    sys.stdout.flush()
                                    collected.append(delta)
                        except json.JSONDecodeError:
                            continue

            print()
            full_text = "".join(collected)
            elapsed = time.monotonic() - t0
            toks = len(collected)
            tok_s = (toks / elapsed) if elapsed > 0 else 0.0

            self.messages.append({"role": "user", "content": prompt})
            self.messages.append({"role": "assistant", "content": full_text})

            console.print(f"[dim]── [{elapsed:.2f}s · ~{toks} tokens · {tok_s:.1f} tok/s][/dim]\n")

        except httpx.ConnectError:
            console.print(f"[bold red]Connection to {self.lane['backend']} failed. Ensure service is active.[/bold red]")
        except Exception as e:
            console.print(f"[bold red]Error: {e}[/bold red]")

    async def run(self):
        self.render_header()
        pt_style = Style.from_dict({
            "prompt": f"{self.lane['color']} bold",
        })
        pt_session = PromptSession(
            history=FileHistory(str(self.history_file)),
            style=pt_style,
        )

        while True:
            try:
                prompt_html = HTML(f"<prompt>{self.lane['prompt_symbol']}</prompt> ❯ ")
                user_input = await pt_session.prompt_async(prompt_html)
                text = user_input.strip()
            except (KeyboardInterrupt, EOFError):
                break

            if not text:
                continue

            if text in ("/clear", "clear"):
                os.system("clear")
                self.render_header()
                continue
            if text in ("/exit", "/quit", "quit"):
                break

            await self.stream_reply(text)


def main():
    parser = argparse.ArgumentParser(description="AQ-OS Dedicated Agent Window")
    parser.add_argument("--lane", default="local", choices=["local", "claude", "codex", "gemini"], help="Agent lane")
    parser.add_argument("--prompt", help="Execute single prompt and exit")
    args = parser.parse_args()

    win = AgentWindow(args.lane)

    if args.prompt:
        asyncio.run(win.stream_reply(args.prompt))
        return

    try:
        asyncio.run(win.run())
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
