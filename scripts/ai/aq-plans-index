def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("mode", nargs="?", default="json", choices=["json", "render", "html"])
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--html", metavar="OUT")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--baseline", metavar="JSON")
    args = ap.parse_args(argv)

    data = index()

    if args.check:
        if not args.baseline:
            print("--check requires --baseline", file=sys.stderr)
            return 2
        try:
            base = json.loads(Path(args.baseline).read_text())
        except Exception as exc:
            print(f"baseline unreadable: {exc}", file=sys.stderr)
            return 2
        a = {k: v for k, v in data.items() if k != "generated"}
        b = {k: v for k, v in base.items() if k != "generated"}
        if a != b:
            print("DRIFT detected: plans index differs from baseline", file=sys.stderr)
            return 1
        return 0

    if args.html:
        Path(args.html).write_text(render_html(data), encoding="utf-8")
        print(f"wrote {args.html} ({data['total']} plans)")
        return 0

    if args.json or args.mode == "json":
        print(json.dumps(data, indent=2))
        return 0

    # render
    print(f"AQ-OS Master Plans Dashboard — {data['total']} plans "
          f"({data['untracked_count']} untracked), generated {data['generated']}")
    for p in data["plans"]:
        print(f"  {p['status']:9} {p['last_activity'] or '—':12} "
              f"{'T' if p['has_tracker'] else ' '} {p['id']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
