#!/usr/bin/env python3
"""aq-plans-index — master SSOT dashboard of every plan under .agents/plans/.

Projects each plan's status from GROUND TRUTH (a per-plan tracker.json rollup when
present, else git-last-activity + doc markers) so the owner has ONE entry point and
never has to search for a plan doc. Apex of the PM-tracker system
(.agents/plans/pm-tracker-standard/DESIGN.md §"Three scopes").

Usage:
  aq-plans-index --json            # the projected index (data)
  aq-plans-index render            # terminal table
  aq-plans-index --html <out>      # write the self-contained dashboard HTML
  aq-plans-index --check --baseline <json>   # exit 1 on drift (ignores 'generated')

Read-only w.r.t. git/plans. git is called via subprocess (the shell wrapper truncates
`git log`; subprocess sees full history). Never raises on a missing dir/doc.
"""
from __future__ import annotations

import argparse
import datetime
import html as _html
import json
import os
import re
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
PLANS_DIR = REPO / ".agents" / "plans"

DOC_PRIORITY = ("DESIGN.md", "SPEC.md", "PLAN.md", "README.md")
OPEN_MARKERS = ("FROZEN", "PREPARED_ONLY", "REQUEST_REVISION", "REVISE", "BLOCKED",
                "awaiting", "PENDING", "NOT AUTHORIZED", "NOT STARTED")
DONE_MARKERS = ("ACCEPTED", "COMPLETE", "COMPLETED", "SHIPPED", "DONE", "PASS")
ACTIVE_DAYS = 21
DORMANT_DAYS = 90

STATUS_ORDER = {"blocked": 0, "active": 1, "untracked": 2, "dormant": 3,
                "done": 4, "complete": 4, "superseded": 5, "retired": 6}
# Lifecycle statuses declared explicitly in a plan's .plan-lifecycle.json override
# every projected/heuristic status (an owner/orchestrator retirement decision wins).
LIFECYCLE_STATUSES = ("active", "complete", "superseded", "retired")


def _today() -> str:
    return datetime.date.today().isoformat()


def _git_last_date(rel: str) -> str:
    try:
        out = subprocess.run(
            ["git", "-C", str(REPO), "log", "-1", "--format=%cs", "--", rel],
            capture_output=True, text=True, timeout=20,
        ).stdout.strip()
        return out
    except Exception:
        return ""


def _days_since(datestr: str) -> int | None:
    if not datestr:
        return None
    try:
        d = datetime.date.fromisoformat(datestr)
    except ValueError:
        return None
    return (datetime.date.today() - d).days


def _primary_doc(plan_path: Path) -> Path | None:
    mds = [p for p in plan_path.iterdir() if p.is_file() and p.suffix == ".md"]
    if not mds:
        return None
    for name in DOC_PRIORITY:
        for p in mds:
            if p.name == name:
                return p
    return sorted(mds)[0]


def _title(doc: Path | None, fallback: str) -> str:
    if doc is not None:
        try:
            for line in doc.read_text(encoding="utf-8", errors="ignore").splitlines():
                s = line.strip()
                if s.startswith("# "):
                    return s[2:].strip()
        except OSError:
            pass
    return fallback.replace("-", " ").replace("_", " ").title()


def _rollup_tracker(tracker: Path) -> str | None:
    """Roll a per-plan tracker.json up to a single status, if present + parseable."""
    try:
        data = json.loads(tracker.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    items = data.get("items") or data.get("tracks") or []
    statuses = {str(i.get("status", "")).lower() for i in items if isinstance(i, dict)}
    if not statuses:
        return None
    if "blocked" in statuses:
        return "blocked"
    if statuses & {"active", "frozen", "in_progress", "in-progress"}:
        return "active"
    if statuses and statuses <= {"done", "shipped", "activated", "complete", "completed"}:
        return "done"
    return "active"


def _doc_markers(plan_path: Path) -> tuple[bool, bool]:
    """Scan docs for (has_open_marker, has_done_marker) — bounded read."""
    has_open = has_done = False
    for p in plan_path.iterdir():
        if not (p.is_file() and p.suffix == ".md"):
            continue
        try:
            txt = p.read_text(encoding="utf-8", errors="ignore")[:8000]
        except OSError:
            continue
        if any(m in txt for m in OPEN_MARKERS):
            has_open = True
        if any(m in txt for m in DONE_MARKERS):
            has_done = True
    return has_open, has_done


def _read_lifecycle(plan_path: Path) -> dict | None:
    """A .plan-lifecycle.json declares an explicit retirement/completion decision:
    {"lifecycle":"superseded|retired|complete|active","superseded_by":"<id/doc>",
     "date":"YYYY-MM-DD","reason":"..."}. It OVERRIDES projected status."""
    f = plan_path / ".plan-lifecycle.json"
    if not f.is_file():
        return None
    try:
        d = json.loads(f.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if str(d.get("lifecycle", "")).lower() not in LIFECYCLE_STATUSES:
        return None
    return d


def _plan_record(plan_path: Path) -> dict:
    pid = plan_path.name
    rel = f".agents/plans/{pid}"
    doc = _primary_doc(plan_path)
    tracker = plan_path / "tracker.json"
    has_tracker = tracker.is_file()
    last = _git_last_date(rel)
    days = _days_since(last)
    has_open, has_done = _doc_markers(plan_path)

    lifecycle = _read_lifecycle(plan_path)
    if lifecycle is not None:
        status = str(lifecycle["lifecycle"]).lower()
        rec_extra = {"superseded_by": lifecycle.get("superseded_by", ""),
                     "lifecycle_reason": lifecycle.get("reason", "")}
        doc_count = sum(1 for p in plan_path.iterdir() if p.is_file() and p.suffix == ".md")
        return {
            "id": pid, "title": _title(doc, pid), "status": status,
            "untracked": not has_tracker, "has_tracker": has_tracker,
            "primary_doc": (f"{rel}/{doc.name}" if doc else ""),
            "doc_count": doc_count, "last_activity": last, **rec_extra,
        }

    if has_tracker:
        # A per-plan tracker.json gives a ground-truth rollup (blocked/active/done).
        status = _rollup_tracker(tracker) or "active"
        untracked = False
    else:
        # No tracker yet → we cannot reliably infer a FINE status (done/blocked)
        # from doc text (design docs mention FROZEN/REVISE/PENDING in passing, which
        # false-flags them). Be honest: drive off git RECENCY only. `untracked` is
        # surfaced separately so the dashboard nudges PM-tracker adoption.
        untracked = True
        if days is None:
            status = "dormant"
        elif days <= DORMANT_DAYS:
            status = "active"
        else:
            status = "dormant"

    doc_count = sum(1 for p in plan_path.iterdir() if p.is_file() and p.suffix == ".md")
    return {
        "id": pid,
        "title": _title(doc, pid),
        "status": status,
        "untracked": untracked,
        "has_tracker": has_tracker,
        "primary_doc": (f"{rel}/{doc.name}" if doc else ""),
        "doc_count": doc_count,
        "last_activity": last,
    }


def index() -> dict:
    plans = []
    if PLANS_DIR.is_dir():
        for entry in sorted(PLANS_DIR.iterdir()):
            if entry.is_dir():
                try:
                    plans.append(_plan_record(entry))
                except Exception:
                    plans.append({"id": entry.name, "title": entry.name,
                                  "status": "dormant", "untracked": True,
                                  "has_tracker": False, "primary_doc": "",
                                  "doc_count": 0, "last_activity": ""})
    plans.sort(key=lambda p: (STATUS_ORDER.get(p["status"], 9),
                              _neg_date(p["last_activity"]), p["id"]))
    by_status: dict[str, int] = {}
    for p in plans:
        by_status[p["status"]] = by_status.get(p["status"], 0) + 1
    return {
        "generated": _today(),
        "total": len(plans),
        "by_status": by_status,
        "untracked_count": sum(1 for p in plans if p["untracked"]),
        "plans": plans,
    }


def _neg_date(datestr: str) -> str:
    # sort most-recent first: invert the ISO date so plain string sort is desc
    if not datestr:
        return "0000-00-00"
    return "".join(str(9 - int(c)) if c.isdigit() else c for c in datestr)


# ---- rendering ----------------------------------------------------------

_STATUS_META = {
    "done": ("Done", "--good"),
    "complete": ("Complete", "--good"),
    "active": ("Active", "--active"),
    "blocked": ("Blocked", "--blocked"),
    "dormant": ("Dormant", "--notstarted"),
    "untracked": ("Untracked", "--accent"),
    "superseded": ("Superseded", "--notstarted"),
    "retired": ("Retired", "--notstarted"),
}


def _viz_html(data: dict) -> str:
    """Self-contained CSS visualizations: a status-distribution bar + an
    activity-by-month histogram. No external libs (artifact CSP)."""
    total = max(1, data["total"])
    by = data["by_status"]
    # status distribution stacked bar (active/superseded/dormant + untracked overlay)
    segs = []
    for s in ("active", "dormant", "superseded", "complete"):
        n = by.get(s, 0)
        if n:
            _, var = _STATUS_META.get(s, ("", "--notstarted"))
            pct = n / total * 100
            segs.append(
                f'<span class="seg" style="width:{pct:.1f}%;background:var({var})" '
                f'title="{_STATUS_META.get(s,(s,))[0]}: {n}"></span>'
            )
    dist = "".join(segs)
    tracked = data["total"] - data["untracked_count"]
    tracked_pct = tracked / total * 100

    # activity histogram: plans per YYYY-MM of last commit (last 8 buckets)
    from collections import Counter
    months = Counter()
    for p in data["plans"]:
        la = p.get("last_activity") or ""
        if len(la) >= 7:
            months[la[:7]] += 1
    keys = sorted(months)[-8:]
    mx = max([months[k] for k in keys], default=1)
    bars = "".join(
        f'<span class="hbar-col" title="{k}: {months[k]} plans">'
        f'<span class="hbar" style="height:{max(6, months[k]/mx*100):.0f}%"></span>'
        f'<span class="hlab">{k[5:]}</span></span>'
        for k in keys
    )
    return (
        '<section class="viz">'
        '<div class="viz-card"><div class="viz-t">Lifecycle distribution</div>'
        f'<div class="distbar">{dist}</div>'
        '<div class="viz-legend">'
        f'<span><i style="background:var(--active)"></i>Active {by.get("active",0)}</span>'
        f'<span><i style="background:var(--notstarted)"></i>Superseded {by.get("superseded",0)}</span>'
        f'<span><i style="background:var(--notstarted);opacity:.5"></i>Dormant {by.get("dormant",0)}</span>'
        '</div></div>'
        '<div class="viz-card"><div class="viz-t">Tracker adoption</div>'
        f'<div class="pbar"><span class="pbar-fill" style="width:{tracked_pct:.1f}%"></span>'
        f'<span class="pbar-lab">{tracked}/{data["total"]} plans have a tracker.json</span></div>'
        '<div class="viz-sub">PM-tracker rollout target: 100%</div></div>'
        '<div class="viz-card"><div class="viz-t">Activity by month</div>'
        f'<div class="hist">{bars}</div></div>'
        '</section>'
    )


def render_html(data: dict) -> str:
    rows = []
    for p in data["plans"]:
        label, var = _STATUS_META.get(p["status"], ("?", "--notstarted"))
        doc = _html.escape(p["primary_doc"])
        title = _html.escape(p["title"])
        pid = _html.escape(p["id"])
        tracker_badge = "●" if p["has_tracker"] else "<span class='no-tracker'>no tracker</span>"
        sub = ""
        if p["status"] in ("superseded", "retired") and p.get("superseded_by"):
            sub = f'<span class="supby">→ {_html.escape(str(p["superseded_by"]))}</span>'
        # honest progress: completion % from a tracker rollup when present; settled
        # (done/complete/superseded/retired) reads full; open+untracked has no % yet.
        pv = p.get("progress")
        if pv is None:
            if p["status"] in ("done", "complete", "superseded", "retired"):
                pv = 100
        if pv is None:
            prog = '<span class="prog"><span class="prog-track"></span></span>'
        else:
            pcol = "--good" if p["status"] in ("done", "complete") else (
                "--notstarted" if p["status"] in ("superseded", "retired") else "--active")
            prog = (f'<span class="prog"><span class="prog-track">'
                    f'<span class="prog-fill" style="width:{pv}%;background:var({pcol})"></span>'
                    f'</span></span>')
        rows.append(
            f'<tr data-status="{p["status"]}" data-search="{pid.lower()} {title.lower()}">'
            f'<td><span class="dot" style="background:var({var})"></span>'
            f'<span class="st">{label}</span></td>'
            f'<td class="name"><a href="../../{doc}" title="{doc}">{title}</a>'
            f'<span class="pid">{pid}</span>{sub}</td>'
            f'<td class="prog-td">{prog}</td>'
            f'<td class="act">{_html.escape(p["last_activity"] or "—")}</td>'
            f'<td class="trk">{tracker_badge}</td>'
            f'<td class="dc">{p["doc_count"]}</td></tr>'
        )
    by = data["by_status"]

    def _count(s: str) -> int:
        # 'untracked' is a cross-cutting flag, not a status bucket — use the real count.
        return data["untracked_count"] if s == "untracked" else by.get(s, 0)

    stat_cards = "".join(
        f'<div class="stat"><span class="stat-num" style="color:var({_STATUS_META.get(s,("", "--ink"))[1]})">{_count(s)}</span>'
        f'<span class="stat-label">{_STATUS_META.get(s,(s,""))[0]}</span></div>'
        for s in ("active", "dormant", "superseded", "complete", "untracked")
    )
    return _TEMPLATE.replace("__GENERATED__", _html.escape(data["generated"])) \
        .replace("__TOTAL__", str(data["total"])) \
        .replace("__UNTRACKED__", str(data["untracked_count"])) \
        .replace("__STATCARDS__", stat_cards) \
        .replace("__VIZ__", _viz_html(data)) \
        .replace("__ROWS__", "\n".join(rows))


