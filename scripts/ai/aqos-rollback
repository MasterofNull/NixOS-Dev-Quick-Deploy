#!/usr/bin/env python3
"""Capture NixOS generation state or request an ACP-gated recovery action."""

from __future__ import annotations

import argparse
import json
import sys
import uuid
from pathlib import Path

_HERE = Path(__file__).resolve().parent
_REPO_ROOT = _HERE.parent.parent
_LIB = _HERE / "lib"
if str(_LIB) not in sys.path:
    sys.path.insert(0, str(_LIB))

import approval_request as AR  # noqa: E402
import aqos_rollback as rollback  # noqa: E402  (registers aqos-rollback)

_DEFAULT_REQUEST_DIR = _REPO_ROOT / ".agents" / "state" / "approval-control-plane" / "requests"


def _write_request(record: dict, request_dir: Path) -> Path:
    request_dir.mkdir(parents=True, exist_ok=True)
    path = request_dir / f"{record['request_id']}.json"
    temporary = path.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temporary.replace(path)
    return path


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--profile-path", type=Path, default=rollback.DEFAULT_SYSTEM_PROFILE)
    parser.add_argument("--state-path", type=Path, default=rollback.DEFAULT_STATE_PATH)
    subparsers = parser.add_subparsers(dest="operation", required=True)

    subparsers.add_parser("capture", help="save the generation before an installer-driven switch")

    back = subparsers.add_parser("back", help="request rollback to the captured earlier generation")
    back.add_argument("--target-generation", type=int, required=True)

    forward = subparsers.add_parser("forward", help="request re-application of a known-good resolved lock")
    forward.add_argument("--resolved-lock", type=Path, required=True)

    for child in (back, forward):
        child.add_argument("--created-by", default="aqos-rollback")
        child.add_argument("--request-id", default=None)
        child.add_argument("--request-dir", type=Path, default=_DEFAULT_REQUEST_DIR)
    return parser


def _load_lock(path: Path) -> dict:
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise ValueError("resolved lock must be a JSON object")
    return value


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        current_generation = rollback.capture_generation(args.profile_path)
        if args.operation == "capture":
            state_path = rollback.write_rollback_state(
                current_generation, current_generation, args.state_path
            )
            print(f"Captured generation {current_generation} before installation.")
            print(f"Rollback state saved for the deployment dashboard: {state_path}")
            return 0

        if args.operation == "back":
            plan = rollback.plan_rollback(current_generation, args.target_generation)
            target_files: list[str] = []
            captured_generation = args.target_generation
        else:
            resolved_lock = _load_lock(args.resolved_lock)
            plan = rollback.plan_roll_forward(resolved_lock)
            target_files = [str(args.resolved_lock)]
            captured_generation = current_generation

        state_path = rollback.write_rollback_state(
            current_generation, captured_generation, args.state_path
        )
        record = AR.create_request(
            request_id=args.request_id or uuid.uuid4().hex,
            created_by=args.created_by,
            runbook=rollback.RUNBOOK_NAME,
            params=rollback.request_params(plan, current_generation=current_generation),
            target_files=target_files,
            grant_subject="system-recovery",
        )
        request_path = _write_request(record, args.request_dir)
    except (AR.ApprovalValidationError, json.JSONDecodeError, OSError, ValueError) as exc:
        print(f"error: could not prepare rollback request: {exc}", file=sys.stderr)
        return 1

    print(plan.description)
    print(f"Approval request emitted: {record['request_id']}")
    print(f"Rollback state: {state_path}")
    print(f"Request saved to: {request_path}")
    print()
    print("Nothing has been applied. Approve or reject it through the Approval Control Plane:")
    print(f"  aq-approve-headless approve {record['request_id']}")
    print(f"  aq-approve-headless deny {record['request_id']}")
    print("At P0 the approved runbook effect remains inert (executable: false).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
