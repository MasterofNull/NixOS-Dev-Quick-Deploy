#!/usr/bin/env python3
"""aq-frontier — frontier-evidence backlog CLI (FA-1 of the Frontier Autopilot).

  aq-frontier add --technique T --source URL --claim C --verdict adopt|monitor|drop|corrected \
                  --mapping M --slice S --acceptance A [--id ID]
  aq-frontier list [--status new|approved|deferred|dropped|scheduled]
  aq-frontier digest
  aq-frontier approve|defer|drop|schedule <id>
  aq-frontier seed        # load this cycle's verified FE-1..FE-8 candidates if empty

Store: .agents/plans/frontier-evidence-intake/BACKLOG.jsonl (append-only, deduped).
This is the human/agent entrypoint; the scan (FA-4) and digest card (FA-2) build on it.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import frontier_backlog as fb  # noqa: E402
import frontier_sources as fs  # noqa: E402
import frontier_relevance as fr  # noqa: E402
import frontier_context as fc  # noqa: E402
import frontier_fold as ff  # noqa: E402

REPO = Path(__file__).resolve().parents[2]
STORE = str(REPO / fb.DEFAULT_STORE)
CATALOG = str(REPO / fs.DEFAULT_CATALOG)
CONCEPTS = str(REPO / fr.DEFAULT_CONCEPTS)

# This cycle's verified candidates (see DESIGN.md §2). Seed data only.
SEED = [
    {"source_ids": ["arxiv-cs-ai", "awesome-prm"], "id": "FE-1", "technique": "Test-time compute + Process Reward Models",
     "source": "arXiv:2510.14232; AgentPRM (ACM WebConf 2026); GenPRM 2504.00891",
     "claim": "Step-wise process rewards + execution verification lift agent reliability; >8x compute-efficiency (AgentPRM).",
     "verdict": "adopt", "aqos_mapping": "aq-qa / edit-verify / behavioral-verify already score local-agent steps",
     "proposed_slice": "use aq-qa/behavioral-verify as a PRM signal so the local loop prefers a verified branch pre-commit",
     "acceptance_goal": "measured pass-rate lift on the dogfood set, no APU latency blow-up", "status": "approved"},
    {"source_ids": ["dspy", "gepa"], "id": "FE-2", "technique": "DSPy / GEPA prompt compilation",
     "source": "dspy.ai GEPA (ICLR 2026); gepa-ai/gepa; Microsoft MAI Qwen3-30B judge",
     "claim": "GEPA: gradient-free reflective prompt optimizer, +20% vs GRPO with 35x fewer rollouts; offline compile step.",
     "verdict": "adopt", "aqos_mapping": "aq-qa execution verifier + local Qwen judge + shared/llm_config.py prompt SSOT",
     "proposed_slice": "FE-2a functional eval metric first (baseline was a ceilinged self-probe), then FE-2b GEPA build-time compile gated by aq-qa",
     "acceptance_goal": "a compiled local-agent prompt beating the FE-2a functional baseline + tier0", "status": "scheduled"},
    {"source_ids": ["mcp-spec", "a2a-spec"], "id": "FE-3", "technique": "MCP + A2A interop standards",
     "source": "MCP spec 2025-11-25 (97M SDK dl/mo); A2A v1.0 Apr 2026 (Linux Foundation); arXiv:2606.31498",
     "claim": "MCP=tools layer, A2A=inter-agent layer, both de-facto standards; protocols cannot express key governance.",
     "verdict": "monitor", "aqos_mapping": "we run MCP (coordinator/lean-ctx) + home-grown signed-A2A (F3) + capability leases",
     "proposed_slice": "gap-check signed-A2A vs A2A v1.0 envelope; keep our capability-lease governance (we're ahead)",
     "acceptance_goal": "interop gap doc + no governance regression", "status": "deferred"},
    {"source_ids": ["llama-cpp", "arxiv-cs-lg"], "id": "FE-4", "technique": "Speculative decoding",
     "source": "ggml-org/llama.cpp #10466 + docs/speculative.md; community bench on Qwen3.6-35B-A3B",
     "claim": "tens-of-% to ~2x at best; NEGATIVE on some configs; NO mode faster than baseline on our Qwen3.6-35B-A3B MoE.",
     "verdict": "drop", "aqos_mapping": "our model IS Qwen3.6-35B-A3B on an APU; tok/s measured",
     "proposed_slice": "do NOT schedule for the current MoE model; re-test only on a dense-model switch",
     "acceptance_goal": "n/a (dropped; recorded null-candidate)", "status": "dropped"},
    {"source_ids": ["bitnet"], "id": "FE-5", "technique": "BitNet / 1.58-bit ternary",
     "source": "microsoft/bitnet-b1.58-2B-4T (HF); arXiv:2504.12285",
     "claim": "Native-trained only (no post-hoc ternary quant); largest open native 1-bit models far below 30B; 4-bit still wins for capability.",
     "verdict": "monitor", "aqos_mapping": "we run Qwen3.6-35B Q5_K_S; ceiling is RAM/VRAM not bit-width",
     "proposed_slice": "monitor native 1-bit scaling; keep Q4/Q5/IQ path (matches owner decision, no lighter model)",
     "acceptance_goal": "n/a until a native 1-bit model competitive at our size exists", "status": "deferred"},
    {"source_ids": ["landlock", "ebpf"], "id": "FE-8", "technique": "Zero-trust sandbox egress (Landlock/eBPF/cgroup v2)",
     "source": "Landlock LSM + eBPF/cilium (mature 2026); arXiv:2606.31498 governance gaps",
     "claim": "Runtime LSM/eBPF egress + cgroup limits pin untrusted tools (e.g. MCP server to loopback-only).",
     "verdict": "adopt", "aqos_mapping": "we run bwrap cells + AppArmor + capability leases + C6 epoch-fence",
     "proposed_slice": "add a Landlock/eBPF egress pin for untrusted MCP servers (loopback-only)",
     "acceptance_goal": "deny-closed egress proof + no tool regression; attach to Foundation-C activation evidence",
     "status": "approved"},
]


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="Frontier-evidence backlog CLI (FA-1).")
    sub = ap.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("add")
    for flag in ("technique", "source", "claim", "verdict", "mapping", "slice", "acceptance"):
        a.add_argument(f"--{flag}", required=True)
    a.add_argument("--id", default=None)
    ls = sub.add_parser("list"); ls.add_argument("--status", default=None); ls.add_argument("--json", action="store_true")
    sub.add_parser("digest")
    for verb in ("approve", "defer", "drop", "schedule"):
        s = sub.add_parser(verb); s.add_argument("id")
    sub.add_parser("seed")
    sc = sub.add_parser("sources"); sc.add_argument("--json", action="store_true")
    sm = sub.add_parser("source-metrics"); sm.add_argument("--json", action="store_true")
    cp = sub.add_parser("concepts"); cp.add_argument("--json", action="store_true")
    rv = sub.add_parser("relevance"); rv.add_argument("text"); rv.add_argument("--semantic", action="store_true"); rv.add_argument("--json", action="store_true")
    cv = sub.add_parser("coverage"); cv.add_argument("--json", action="store_true")
    cx = sub.add_parser("context"); cx.add_argument("topic"); cx.add_argument("--stale-days", type=int, default=30); cx.add_argument("--json", action="store_true")
    fd = sub.add_parser("fold"); fd.add_argument("id"); fd.add_argument("--plan", required=True, help="target plan dir with tracker.json"); fd.add_argument("--phase", default=None)
    st = sub.add_parser("scan-topic"); st.add_argument("topic")
    pa = sub.add_parser("parity"); pa.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)

    if args.cmd == "add":
        res = fb.add(STORE, {"id": args.id, "technique": args.technique, "source": args.source,
                             "claim": args.claim, "verdict": args.verdict, "aqos_mapping": args.mapping,
                             "proposed_slice": args.slice, "acceptance_goal": args.acceptance})
        print(json.dumps(res)); return 0 if res.get("added") or res.get("duplicate") else 1

    if args.cmd == "list":
        items = fb.list_items(STORE, status=args.status)
        if args.json:
            print(json.dumps(items, indent=2))
        elif not items:
            print("(backlog empty)")
        else:
            for r in items:
                print(f"[{r['id']}] {r.get('status'):9} {r['verdict']:9} {r['technique']}")
        return 0

    if args.cmd == "digest":
        d = fb.digest(STORE)
        print(f"Frontier backlog: {d['total']} items  by_status={d['by_status']}  by_verdict={d['by_verdict']}")
        if d["new_lines"]:
            print(f"\n{d['new_count']} NEW awaiting owner decision:")
            for line in d["new_lines"]:
                print(f"  {line}")
        else:
            print("(no NEW items awaiting decision)")
        return 0

    if args.cmd in ("approve", "defer", "drop", "schedule"):
        status = {"approve": "approved", "defer": "deferred", "drop": "dropped", "schedule": "scheduled"}[args.cmd]
        res = fb.set_status(STORE, args.id, status)
        print(json.dumps(res)); return 0 if res.get("ok") else 1

    if args.cmd == "seed":
        added = 0
        for rec in SEED:
            if fb.add(STORE, rec).get("added"):
                added += 1
        print(f"seeded {added} new candidate(s); {len(SEED) - added} already present")
        return 0

    if args.cmd == "sources":
        cat = fs.load_catalog(CATALOG)
        issues = fs.validate(cat)
        cov = fs.coverage(cat)
        if args.json:
            print(json.dumps({"coverage": cov, "issues": issues}, indent=2))
            return 0 if not issues else 1
        print(f"Source catalog: {cov['total']} sources  trust={cov['by_trust']}")
        for pillar, row in sorted(cov["by_pillar"].items()):
            print(f"  {pillar:20} {row['total']:2} sources ({row['primary']} primary)")
        if cov["pillars_without_primary"]:
            print(f"  COVERAGE RISK — pillars with no primary source: {cov['pillars_without_primary']}")
        if issues:
            print("  ISSUES:")
            for i in issues:
                print(f"    - {i}")
            return 1
        return 0

    if args.cmd == "source-metrics":
        cat = fs.load_catalog(CATALOG)
        rows = fs.source_signal(cat, fb.load(STORE))
        if args.json:
            print(json.dumps(rows, indent=2))
            return 0
        print(f"{'source':16} {'pillar':20} {'surfaced':8} {'adopted':7} {'adopt_rate'}")
        for r in rows:
            rate = "-" if r["adopt_rate"] is None else f"{r['adopt_rate']:.2f}"
            print(f"{r['source_id']:16} {str(r['pillar']):20} {r['surfaced']:>8} {r['adopted']:>7} {rate:>10}")
        return 0

    if args.cmd == "concepts":
        cat = fr.load_concepts(CONCEPTS)
        issues = fr.validate(cat)
        if args.json:
            print(json.dumps({"concepts": cat.get("concepts"), "issues": issues}, indent=2))
            return 0 if not issues else 1
        for c in cat.get("concepts", []):
            print(f"  {c.get('tier'):11} {c['id']:26} ({len(c.get('keywords', []))} keywords)")
        if issues:
            print("  ISSUES:"); [print(f"    - {i}") for i in issues]; return 1
        return 0

    if args.cmd == "relevance":
        cat = fr.load_concepts(CONCEPTS)
        res = fr.score_text(cat, args.text)
        sem = fr.semantic_score(args.text) if args.semantic else None
        if args.json:
            print(json.dumps({"keyword": res, "semantic": sem}, indent=2)); return 0
        print(f"relevance={res['relevance']}  top={res['top_concept']}  core_matched={res['core_matched']}")
        for m in res["matched_concepts"]:
            print(f"  {m['tier']:11} {m['concept']:26} hits={m['hits']} weighted={m['weighted']}")
        if args.semantic:
            print(f"  semantic (vector DB): {'unavailable' if sem is None else 'top corpus matches returned'}")
        return 0

    if args.cmd == "coverage":
        cat = fr.load_concepts(CONCEPTS)
        srcs = (fs.load_catalog(CATALOG).get("sources") or [])
        cov = fr.concept_coverage(cat, srcs, fb.load(STORE))
        if args.json:
            print(json.dumps(cov, indent=2)); return 0
        print(f"{'concept':26} {'tier':11} {'sources':7} {'candidates':10} gap")
        for r in cov["concepts"]:
            print(f"{r['concept']:26} {str(r['tier']):11} {r['sources_tracking']:>7} {r['candidates_found']:>10} {'GAP' if r['gap'] else ''}")
        print(f"\n{cov['gap_count']} coverage gap(s): {cov['gaps'] or 'none'}")
        return 0

    if args.cmd == "context":
        cat = fr.load_concepts(CONCEPTS)
        ctx = fc.context_for_topic(args.topic, cat, fb.load(STORE), stale_days=args.stale_days)
        if args.json:
            print(json.dumps(ctx, indent=2)); return 0
        print(fc.render(ctx))
        return 0

    if args.cmd == "fold":  # FA-3
        cand = next((b for b in fb.load(STORE) if b.get("id") == args.id), None)
        if not cand:
            print(f"no such backlog id: {args.id}", file=sys.stderr); return 1
        plan_dir = args.plan if Path(args.plan).is_absolute() else str(REPO / args.plan)
        try:
            tracker = ff.load_tracker(plan_dir)
        except OSError:
            print(f"no tracker.json under {args.plan}", file=sys.stderr); return 1
        tracker, added, msg = ff.fold_candidate(tracker, cand, phase_id=args.phase)
        if added:
            ff.write_tracker(plan_dir, tracker)
        print(msg)
        return 0 if (added or "already folded" in msg) else 1

    if args.cmd == "scan-topic":  # FA-4 — targeted, need-driven refresh (not a timer)
        cat = fr.load_concepts(CONCEPTS)
        ctx = fc.context_for_topic(args.topic, cat, fb.load(STORE))
        stale = ctx["stale_concepts"] or ctx["relevant_concepts"] or ["(no matched concept)"]
        ts = __import__("time").strftime("%Y-%m-%dT%H:%M:%SZ", __import__("time").gmtime())
        req = {"requested_at": ts, "topic": args.topic, "stale_concepts": ctx["stale_concepts"]}
        log = REPO / ".agents/plans/frontier-evidence-intake/scan-requests.jsonl"
        log.parent.mkdir(parents=True, exist_ok=True)
        with open(log, "a", encoding="utf-8") as f:
            f.write(json.dumps(req, sort_keys=True) + "\n")
        print(f"SCAN-TOPIC (need-driven refresh) — topic: {args.topic!r}")
        print(f"  concepts to refresh: {stale}")
        print("  Run this bounded intake task on a web-capable lane, then `aq-frontier add ...`:")
        print(f"    1. Find current (2026) PRIMARY sources on: {args.topic}")
        print("    2. Verify claims; correct overclaims; map to an AQ-OS measurement/gate")
        print("    3. aq-frontier relevance \"<title+abstract>\"  (rank value to us)")
        print("    4. aq-frontier add --technique .. --source .. --claim .. --verdict .. "
              "--mapping .. --slice .. --acceptance ..")
        print(f"  (request logged -> {log.relative_to(REPO)})")
        return 0

    if args.cmd == "parity":  # FA-5 — whole-taxonomy backstop sweep (on-demand, not a timer)
        cat = fr.load_concepts(CONCEPTS)
        srcs = (fs.load_catalog(CATALOG).get("sources") or [])
        cov = fr.concept_coverage(cat, srcs, fb.load(STORE))
        if args.json:
            print(json.dumps(cov, indent=2)); return 0
        print(f"Frontier parity sweep — {cov['gap_count']} gap(s) across the taxonomy:")
        for r in cov["concepts"]:
            if r["gap"]:
                print(f"  GAP [{r['tier']}] {r['concept']}  (sources={r['sources_tracking']} candidates={r['candidates_found']})")
                print(f"       -> aq-frontier scan-topic {r['concept']!r}")
        if not cov["gaps"]:
            print("  no gaps — every core/supporting concept has a source and a candidate")
        return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
