def markdown_to_html(md_text: str) -> str:
    """Minimal, robust markdown-to-HTML parser for local rendering."""
    lines = md_text.splitlines()
    html_lines = []
    in_code_block = False
    in_table = False
    in_list = False

    for line in lines:
        if line.strip().startswith("```"):
            if in_code_block:
                html_lines.append("</code></pre>")
                in_code_block = False
            else:
                html_lines.append("<pre><code>")
                in_code_block = True
            continue

        if in_code_block:
            safe = line.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            html_lines.append(safe)
            continue

        # Tables
        if "|" in line:
            parts = [p.strip() for p in line.split("|")[1:-1]]
            if not in_table:
                html_lines.append("<table><thead><tr>")
                for p in parts:
                    html_lines.append(f"<th>{p}</th>")
                html_lines.append("</tr></thead><tbody>")
                in_table = True
            elif all(set(p).issubset({"-", ":", " "}) for p in parts):
                continue
            else:
                html_lines.append("<tr>")
                for p in parts:
                    html_lines.append(f"<td>{p}</td>")
                html_lines.append("</tr>")
            continue
        elif in_table:
            html_lines.append("</tbody></table>")
            in_table = False

        # Lists
        if re.match(r"^[-*]\s+", line):
            if not in_list:
                html_lines.append("<ul>")
                in_list = True
            content = re.sub(r"^[-*]\s+", "", line)
            content = re.sub(r"`([^`]+)`", r"<code>\1</code>", content)
            content = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", content)
            html_lines.append(f"<li>{content}</li>")
            continue
        elif in_list and line.strip() == "":
            html_lines.append("</ul>")
            in_list = False

        # Headings
        if line.startswith("# "):
            html_lines.append(f"<h1>{line[2:]}</h1>")
        elif line.startswith("## "):
            html_lines.append(f"<h2>{line[3:]}</h2>")
        elif line.startswith("### "):
            html_lines.append(f"<h3>{line[4:]}</h3>")
        elif line.startswith("> "):
            html_lines.append(f"<blockquote>{line[2:]}</blockquote>")
        elif line.strip() != "":
            content = line
            content = re.sub(r"`([^`]+)`", r"<code>\1</code>", content)
            content = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", content)
            content = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r'<a href="\2" target="_blank" style="color: #38bdf8;">\1</a>', content)
            html_lines.append(f"<p>{content}</p>")

    if in_code_block:
        html_lines.append("</code></pre>")
    if in_table:
        html_lines.append("</tbody></table>")
    if in_list:
        html_lines.append("</ul>")

    return "\n".join(html_lines)


class HelpHandler(http.server.BaseHTTPRequestHandler):
    DOC_MAP = {
        "sota-manual": {
            "title": "AQ-OS SOTA User Manual",
            "path": USER_GUIDES_DIR / "AQ-OS-SOTA-USER-MANUAL.md",
        },
        "quick-start": {
            "title": "Quick Start Guide",
            "path": USER_GUIDES_DIR / "quick-start.md",
        },
        "shortcuts": {
            "title": "Keyboard Shortcuts",
            "path": USER_GUIDES_DIR / "keyboard-shortcuts.md",
        },
        "history-browser": {
            "title": "Execution History Browser",
            "path": USER_GUIDES_DIR / "execution-history-browser.md",
        },
        "workspace-operator": {
            "title": "Workspace Swarm Operator Manual",
            "path": OPERATIONS_DIR / "AQ-WORKSPACE-OPERATOR-MANUAL.md",
        },
        "workflow-canon": {
            "title": "8-Step Canonical Workflow",
            "path": CANON_DIR / "WORKFLOW-CANON.md",
        },
        "definition-of-done": {
            "title": "Definition of Done (DoD)",
            "path": CANON_DIR / "DEFINITION-OF-DONE.md",
        },
        "role-contracts": {
            "title": "Role Contracts Matrix",
            "path": CANON_DIR / "skills" / "role-contracts" / "SKILL.md",
        },
    }

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(HELP_HTML_TEMPLATE.encode("utf-8"))
            return

        if self.path.startswith("/api/doc"):
            doc_id = "sota-manual"
            if "?id=" in self.path:
                doc_id = self.path.split("?id=")[1].split("&")[0]

            item = self.DOC_MAP.get(doc_id, self.DOC_MAP["sota-manual"])
            file_path = item["path"]
            if file_path.is_file():
                raw = file_path.read_text(encoding="utf-8")
                html = markdown_to_html(raw)
            else:
                html = f"<p>Document not found at: {file_path}</p>"

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"id": doc_id, "title": item["title"], "html": html}).encode("utf-8"))
            return

        self.send_response(404)
        self.end_headers()

    def log_message(self, format, *args):
        # Quiet standard output
        pass


def run_server(port: int = 8890, open_browser: bool = True):
    server = socketserver.TCPServer(("127.0.0.1", port), HelpHandler)
    url = f"http://localhost:{port}"
    print(f"🚀 AQ-OS Help Center & Training Manual running at: {url}")
    if open_browser:
        try:
            subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopping Help Center server.")
        server.server_close()


def main():
    parser = argparse.ArgumentParser(description="AQ-OS Help Center & Training Manual")
    parser.add_argument("--port", type=int, default=8890, help="Port to serve help center on (default: 8890)")
    parser.add_argument("--no-open", action="store_true", help="Do not auto-open browser")
    parser.add_argument("--search", type=str, help="Search documents from terminal")
    args = parser.parse_args()

    if args.search:
        q = args.search.lower()
        print(f"Searching docs for: '{q}'\n")
        hits = 0
        for doc_id, doc in HelpHandler.DOC_MAP.items():
            p = doc["path"]
            if p.is_file():
                lines = p.read_text(encoding="utf-8").splitlines()
                matching = [line for line in lines if q in line.lower()]
                if matching:
                    hits += 1
                    print(f"📄 [{doc['title']}] ({p.name})")
                    for m in matching[:3]:
                        print(f"   • {m.strip()}")
                    print()
        if not hits:
            print("No matches found.")
        return 0

    run_server(port=args.port, open_browser=not args.no_open)
    return 0


if __name__ == "__main__":
    sys.exit(main())
