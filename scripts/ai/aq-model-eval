#!/usr/bin/env python3
"""
aq-model-eval — Probe the loaded llama.cpp model and write a model-profile.json.

Run this after loading a new model (or after nixos-rebuild) to generate
hardware-accurate token budgets and detect model capabilities without any
hardcoded model names.

Usage:
    aq-model-eval                     # probe current model, print profile
    aq-model-eval --url http://...    # override llama.cpp URL
    aq-model-eval --force             # re-probe even if cache exists
    aq-model-eval --json              # output profile JSON only

The profile is cached at $AI_MODEL_PROFILE_PATH (default: config/model-profile.json).
The hybrid-coordinator reads this profile at startup to set token budgets.
"""
try:  # aq-usage-hook
    import importlib.util as _aqu, os as _aqo
    _aqs = _aqu.spec_from_file_location("aq_usage", _aqo.path.join(_aqo.path.dirname(_aqo.path.realpath(__file__)), "lib", "aq_usage.py"))
    _aqm = _aqu.module_from_spec(_aqs); _aqs.loader.exec_module(_aqm); _aqm.record(__file__, __name__)
except Exception:
    pass

import argparse
import asyncio
import json
import os
import sys
from pathlib import Path

# Add coordinator directory to path so we can import model_probe directly
_COORD = Path(__file__).resolve().parent.parent.parent / "ai-stack" / "mcp-servers" / "hybrid-coordinator"
sys.path.insert(0, str(_COORD))

import model_probe
from extensions.model_probe import _is_cache_fresh


def _status(profile_path: Path) -> dict:
    import yaml

    root = Path(__file__).resolve().parents[2]
    catalog = yaml.safe_load((root / "config/model-catalog.yaml").read_text())
    coordinator = json.loads((root / "config/model-coordinator.json").read_text())
    models_dir = Path(os.environ.get("LLAMA_MODELS_DIR", "/var/lib/llama-cpp/models"))
    declared = {entry["file"] for group in ("chat_models", "embedding_models")
                for entry in catalog.get(group, {}).values()}
    active_names = {"active.gguf", "active-embed.gguf"}

    def target(name):
        link = models_dir / name
        return str(link.resolve()) if link.is_symlink() else None

    return {
        "domain": "llm",
        "active_profile": json.loads(profile_path.read_text()) if profile_path.exists() else None,
        "profile_fresh": bool(_is_cache_fresh(profile_path)),
        "catalog_chat_models": sorted(catalog.get("chat_models", {})),
        "catalog_embedding_models": sorted(catalog.get("embedding_models", {})),
        "coordinator_tiers": coordinator.get("tiers", {}),
        "models_dir": {
            "path": str(models_dir),
            "active_gguf_target": target("active.gguf"),
            "active_embed_gguf_target": target("active-embed.gguf"),
            "declared_files_present": sorted(name for name in declared if (models_dir / name).is_file()),
            "untracked_or_temp_files": sorted(
                entry.name for entry in models_dir.iterdir()
                if entry.name not in declared | active_names and (entry.is_file() or entry.is_symlink())
            ) if models_dir.is_dir() else [],
        },
    }


async def _run(args: argparse.Namespace) -> None:
    llama_url = args.url or os.getenv("LLAMA_CPP_URL", "http://127.0.0.1:8080")
    profile_path = (
        Path(args.profile_path)
        if args.profile_path
        else model_probe._default_profile_path()
    )

    if args.status:
        status = await asyncio.to_thread(_status, profile_path)
        if args.json_only:
            print(json.dumps(status, indent=2))
        else:
            print("LLM domain status")
            print(f"  Profile: {profile_path} (fresh: {status['profile_fresh']})")
            print(f"  Chat models: {', '.join(status['catalog_chat_models'])}")
            print(f"  Embedding models: {', '.join(status['catalog_embedding_models'])}")
            print(f"  Coordinator tiers: {json.dumps(status['coordinator_tiers'])}")
            print(f"  Models: {json.dumps(status['models_dir'])}")
        return

    if not args.json_only:
        print(f"Probing {llama_url} ...", file=sys.stderr)

    profile = await model_probe.probe(llama_url, profile_path, force=args.force)
    d = profile.to_dict()

    if args.json_only:
        print(json.dumps(d, indent=2))
        return

    print()
    print("=" * 62)
    print("  MODEL PROFILE")
    print("=" * 62)
    print(f"  Model ID        : {d['model_id']}")
    print(f"  Context length  : {d['context_length']:,} tokens")
    print(f"  Output speed    : {d['measured_tps_output']:.1f} t/s")
    print(f"  Thinking mode   : {d['has_thinking_mode']}")
    print(f"  Disable thinking: {d['can_disable_thinking']}")
    print(f"  Tool calling    : {d['supports_tools']}")
    print(f"  EOS token       : {repr(d['eos_token'])}")
    print()
    print("  TOKEN BUDGETS (computed from speed × timeout):")
    print(f"    interactive  : {d['budget_interactive']:>5}  (direct, {180}s window)")
    print(f"    lookup       : {d['budget_lookup']:>5}  (no-think fast path)")
    print(f"    reasoning    : {d['budget_reasoning']:>5}  (switchboard, synthesis window)")
    print(f"    synthesis    : {d['budget_synthesis']:>5}  (switchboard, {900}s window)")
    print(f"    heavy        : {d['budget_heavy']:>5}  (switchboard, max generation)")
    print()
    print("  CONTEXT BUDGETS (retrieved content fed to LLM):")
    print(f"    lookup       : {d['ctx_budget_lookup']:>5}")
    print(f"    reasoning    : {d['ctx_budget_reasoning']:>5}")
    print(f"    synthesis    : {d['ctx_budget_synthesis']:>5}")
    print()
    print(f"  Cached at: {profile_path}")
    print("=" * 62)
    print()
    print("  Coordinator reads this profile at startup.")
    print("  Run 'sudo nixos-rebuild switch' to apply a new model.")
    print()


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--url", help="llama.cpp base URL (default: $LLAMA_CPP_URL or http://127.0.0.1:8080)")
    p.add_argument("--force", action="store_true", help="Re-probe even if a cached profile exists")
    p.add_argument("--profile-path", metavar="PATH", help="Output path for model-profile.json")
    p.add_argument("--json", dest="json_only", action="store_true", help="Print raw JSON only")
    p.add_argument("--status", action="store_true", help="Report LLM domain status (active GGUF links, catalog/profile freshness, coordinator tiers, and on-disk GGUF inventory) without probing :8080")
    args = p.parse_args()
    asyncio.run(_run(args))


if __name__ == "__main__":
    main()
