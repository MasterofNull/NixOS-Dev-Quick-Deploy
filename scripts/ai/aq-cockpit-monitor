def probe_http(port: int, path: str = "/health", timeout: float = 0.8) -> Tuple[str, float]:
    """Probe an HTTP endpoint and return (state, latency_ms)."""
    url = f"http://127.0.0.1:{port}{path}"
    t0 = time.monotonic()
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "aq-cockpit/1.0"})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            elapsed_ms = (time.monotonic() - t0) * 1000.0
            if resp.status == 200:
                return "ok", elapsed_ms
            return f"http-{resp.status}", elapsed_ms
    except Exception:
        return "unreachable", (time.monotonic() - t0) * 1000.0


def probe_tcp(port: int, timeout: float = 0.5) -> Tuple[str, float]:
    """Probe a raw TCP socket (e.g. Redis)."""
    t0 = time.monotonic()
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=timeout):
            elapsed_ms = (time.monotonic() - t0) * 1000.0
            return "ok", elapsed_ms
    except Exception:
        return "unreachable", (time.monotonic() - t0) * 1000.0


def get_services_status() -> List[Dict[str, Any]]:
    """Gather live service status across the harness stack."""
    services = [
        {"name": "Switchboard", "port": int(os.getenv("SWITCHBOARD_PORT", "8085")), "type": "http", "path": "/health"},
        {"name": "Coordinator", "port": int(os.getenv("HYBRID_COORDINATOR_PORT", "8003")), "type": "http", "path": "/health"},
        {"name": "Llama.cpp", "port": int(os.getenv("LLAMA_CPP_PORT", "8080")), "type": "http", "path": "/health"},
        {"name": "AIDB", "port": int(os.getenv("AIDB_PORT", "8002")), "type": "http", "path": "/health"},
        {"name": "Qdrant", "port": int(os.getenv("QDRANT_PORT", "6333")), "type": "http", "path": "/"},
        {"name": "Redis", "port": int(os.getenv("REDIS_PORT", "6379")), "type": "tcp", "path": ""},
    ]

    results = []
    for svc in services:
        if svc["type"] == "http":
            state, lat = probe_http(svc["port"], svc["path"])
        else:
            state, lat = probe_tcp(svc["port"])
        results.append({
            "name": svc["name"],
            "port": svc["port"],
            "state": state,
            "latency": lat,
        })
    return results


def get_model_context() -> Dict[str, Any]:
    """Read local model profile and context estimation."""
    info = {
        "model_id": "Qwen3-35B-Q4_K_M",
        "context_window": 32768,
        "context_used": 0,
        "context_pct": 0.0,
        "speed_tok_s": 0.0,
        "vram_gb": 4.0,
        "ram_gb": 27.0,
    }
    if MODEL_PROFILE.is_file():
        try:
            data = json.loads(MODEL_PROFILE.read_text(encoding="utf-8"))
            if "model_name" in data:
                info["model_id"] = data["model_name"]
            elif "id" in data:
                info["model_id"] = data["id"]
            if "measured_tok_per_s" in data:
                info["speed_tok_s"] = float(data["measured_tok_per_s"])
            if "context_length" in data:
                info["context_window"] = int(data["context_length"])
        except Exception:
            pass

    # Estimate active context window utilization if llama.cpp is online
    try:
        req = urllib.request.Request("http://127.0.0.1:8080/props", headers={"User-Agent": "aq-cockpit/1.0"})
        with urllib.request.urlopen(req, timeout=0.6) as resp:
            props = json.loads(resp.read().decode("utf-8"))
            if "default_generation_settings" in props:
                n_ctx = props["default_generation_settings"].get("n_ctx")
                if n_ctx:
                    info["context_window"] = int(n_ctx)
    except Exception:
        pass

    return info


def read_pulse_tail(limit: int = 4) -> List[str]:
    """Read last non-empty lines from PULSE.log."""
    if not PULSE_LOG.is_file():
        return ["[dim]No pulse activity logged yet[/dim]"]
    try:
        lines = [line.strip() for line in PULSE_LOG.read_text(encoding="utf-8", errors="replace").splitlines() if line.strip()]
        return lines[-limit:] if lines else ["[dim]No recent activity[/dim]"]
    except Exception as e:
        return [f"[red]Error reading PULSE.log: {e}[/red]"]


def read_a2a_audit_tail(limit: int = 3) -> List[Tuple[str, str, str, str]]:
    """Read recent A2A audit events (timestamp, lane, decision, summary)."""
    if not A2A_AUDIT.is_file():
        return []
    results = []
    try:
        lines = [line.strip() for line in A2A_AUDIT.read_text(encoding="utf-8", errors="replace").splitlines() if line.strip()]
        for line in lines[-limit:]:
            parts = line.split(" ", 3)
            if len(parts) >= 4:
                results.append((parts[0], parts[1], parts[2], parts[3]))
            elif len(parts) == 3:
                results.append((parts[0], parts[1], parts[2], ""))
    except Exception:
        pass
    return results


def get_sweeper_telemetry() -> Dict[str, Any]:
    """Read durable evidence sweeper state."""
    telemetry = {
        "status": "offline",
        "sweeps": 0,
        "ingested": 0,
        "facts": 0,
        "signals": 0,
        "last_tick": "—"
    }
    if SWEEPER_STATE.is_file():
        try:
            data = json.loads(SWEEPER_STATE.read_text(encoding="utf-8"))
            telemetry["status"] = data.get("status", "unknown")
            metrics = data.get("metrics", {})
            telemetry["sweeps"] = metrics.get("total_sweeps", 0)
            telemetry["ingested"] = metrics.get("items_ingested", 0)
            telemetry["facts"] = metrics.get("facts_count", 0)
            telemetry["signals"] = metrics.get("signal_count", 0)
            last = data.get("last_tick_utc", "")
            if last and "T" in last:
                telemetry["last_tick"] = last.split("T")[1][:8] + "Z"
        except Exception:
            pass
    return telemetry


def get_system1_telemetry() -> Dict[str, Any]:
    """Read System 1 shadow decision evaluation stream."""
    telemetry = {
        "total": 0,
        "shadow": 0,
        "agreement_rate": 0.0,
        "top_answer": "—"
    }
    if DECISIONS_LOG.is_file():
        total = 0
        shadow_count = 0
        agree_count = 0
        by_answer: Dict[str, int] = {}
        try:
            for line in DECISIONS_LOG.read_text(encoding="utf-8").splitlines():
                if not line.strip():
                    continue
                row = json.loads(line)
                if row.get("question") == "task_profile":
                    total += 1
                    ans = row.get("answer")
                    if ans:
                        by_answer[ans] = by_answer.get(ans, 0) + 1
                    sh = row.get("shadow")
                    if sh:
                        shadow_count += 1
                        if ans and sh.get("answer") == ans:
                            agree_count += 1
            telemetry["total"] = total
            telemetry["shadow"] = shadow_count
            if shadow_count > 0:
                telemetry["agreement_rate"] = (agree_count / shadow_count) * 100.0
            if by_answer:
                top = max(by_answer.items(), key=lambda kv: kv[1])
                telemetry["top_answer"] = f"{top[0]} ({top[1]})"
        except Exception:
            pass
    return telemetry


def get_intervention_telemetry() -> Dict[str, Any]:
    """Retrieve active intervention dock control status."""
    info = {"status": "READY", "active_signals": 0, "last_action": "None", "last_ts": "—"}
    if not CONTROL_DIR.is_dir():
        return info
    total_signals = 0
    last_rec = None
    try:
        for f in CONTROL_DIR.glob("*.jsonl"):
            lines = [l.strip() for l in f.read_text(encoding="utf-8").splitlines() if l.strip()]
            total_signals += len(lines)
            if lines:
                candidate = json.loads(lines[-1])
                if not last_rec or candidate.get("ts", "") > last_rec.get("ts", ""):
                    last_rec = candidate
        info["active_signals"] = total_signals
        if last_rec:
            info["status"] = "PENDING" if last_rec.get("kind") in ("pause", "edit_intent") else "ACTIVE"
            info["last_action"] = f"{last_rec.get('kind', '').upper()}"
            ts = last_rec.get("ts", "")
            if "T" in ts:
                info["last_ts"] = ts.split("T")[1][:8] + "Z"
            else:
                info["last_ts"] = ts[:8]
    except Exception:
        pass
    return info


def render_cockpit() -> Panel:
    """Build the cockpit panel."""
    # 1. Services Table
    svc_table = Table(box=None, padding=(0, 1), show_header=True, header_style="bold cyan")
    svc_table.add_column("Service", style="bold white", width=12)
    svc_table.add_column("Port", justify="right", width=5)
    svc_table.add_column("Status", width=13)
    svc_table.add_column("Latency", justify="right", width=8)

    services = get_services_status()
    all_ok = True
    for svc in services:
        if svc["state"] == "ok":
            status_text = Text("● ONLINE", style="bold green")
            lat_str = f"{svc['latency']:.1f}ms"
        else:
            all_ok = False
            status_text = Text("× DOWN", style="bold red")
            lat_str = "—"
        svc_table.add_row(svc["name"], str(svc["port"]), status_text, lat_str)

    # 2. Resources & Model Card
    model_info = get_model_context()
    res_table = Table(box=None, padding=(0, 1), show_header=False)
    res_table.add_column("Key", style="dim cyan", width=12)
    res_table.add_column("Value", style="bold white")

    res_table.add_row("Model", f"[bold #00d9ff]{model_info['model_id']}[/bold #00d9ff]")
    res_table.add_row("Throughput", f"[yellow]{model_info['speed_tok_s']:.1f} tok/s[/yellow] (live bench)")
    res_table.add_row("VRAM / RAM", f"[magenta]{model_info['vram_gb']:.1f}GB APU[/magenta] / [dim]{model_info['ram_gb']:.0f}GB sys[/dim]")
    res_table.add_row("Context Win", f"[bold green]{model_info['context_window']:,} tokens[/bold green]")

    # 3. Durable Sweeper Card
    sweeper_info = get_sweeper_telemetry()
    sw_table = Table(box=None, padding=(0, 1), show_header=False)
    sw_table.add_column("Key", style="dim cyan", width=12)
    sw_table.add_column("Value", style="bold white")

    sw_status = Text(sweeper_info["status"].upper(), style="bold green" if sweeper_info["status"] in ("idle", "running") else "dim yellow")
    sw_table.add_row("Status", sw_status)
    sw_table.add_row("Total Sweeps", f"[bold cyan]{sweeper_info['sweeps']}[/bold cyan]")
    sw_table.add_row("Ingested", f"[bold white]{sweeper_info['ingested']}[/bold white] items")
    sw_table.add_row("Facts/Signals", f"[green]{sweeper_info['facts']} facts[/green] / [magenta]{sweeper_info['signals']} signals[/magenta]")
    sw_table.add_row("Last Tick", f"[dim]{sweeper_info['last_tick']}[/dim]")

    # 4. System 1 Shadow Decision Card
    sys1_info = get_system1_telemetry()
    s1_table = Table(box=None, padding=(0, 1), show_header=False)
    s1_table.add_column("Key", style="dim cyan", width=12)
    s1_table.add_column("Value", style="bold white")

    s1_table.add_row("Decisions", f"[bold white]{sys1_info['total']}[/bold white] total")
    s1_table.add_row("Shadow Evals", f"[bold magenta]{sys1_info['shadow']}[/bold magenta] runs")
    s1_table.add_row("Agreement", f"[bold yellow]{sys1_info['agreement_rate']:.1f}%[/bold yellow]")
    s1_table.add_row("Top Profile", f"[cyan]{sys1_info['top_answer']}[/cyan]")

    # 5. Human Intervention Dock Card
    hitl_info = get_intervention_telemetry()
    hitl_table = Table(box=None, padding=(0, 1), show_header=False)
    hitl_table.add_column("Key", style="dim cyan", width=12)
    hitl_table.add_column("Value", style="bold white")

    hitl_table.add_row("Dock Status", f"[bold green]{hitl_info['status']}[/bold green]" if hitl_info['status'] == "READY" else f"[bold yellow]{hitl_info['status']}[/bold yellow]")
    hitl_table.add_row("Signals Sent", f"[bold white]{hitl_info['active_signals']}[/bold white]")
    hitl_table.add_row("Last Action", f"[cyan]{hitl_info['last_action']}[/cyan]")
    hitl_table.add_row("Timestamp", f"[dim]{hitl_info['last_ts']}[/dim]")

    # 6. Pulse Ops Ticker
    pulse_entries = read_pulse_tail(3)
    pulse_text = Text()
    for entry in pulse_entries:
        # Strip timestamp prefix if clean
        clean = re.sub(r"^\[\d{4}-\d{2}-\d{2}T[^\]]+\]\s*", "", entry)
        pulse_text.append("▸ ", style="bold cyan")
        pulse_text.append(clean[:75] + ("…" if len(clean) > 75 else "") + "\n", style="white")

    # Combine in mini layout
    cockpit_table = Table.grid(padding=1)
    cockpit_table.add_column()
    cockpit_table.add_column()

    header_status = "[bold green]✓ NOMINAL[/bold green]" if all_ok else "[bold red]⚠ ISSUES[/bold red]"
    
    body_table = Table.grid(padding=(0, 2))
    body_table.add_column()
    body_table.add_column()
    body_table.add_row(
        Panel(svc_table, title="[bold]AI Services[/bold]", border_style="cyan", padding=(0, 0)),
        Panel(res_table, title="[bold]Local Inference Engine[/bold]", border_style="magenta", padding=(0, 0)),
    )

    ops_table = Table.grid(padding=(0, 2))
    ops_table.add_column()
    ops_table.add_column()
    ops_table.add_column()
    ops_table.add_row(
        Panel(sw_table, title="[bold]Durable Sweeper[/bold]", border_style="green", padding=(0, 0)),
        Panel(s1_table, title="[bold]System 1 (Shadow)[/bold]", border_style="yellow", padding=(0, 0)),
        Panel(hitl_table, title="[bold]Intervention Dock[/bold]", border_style="cyan", padding=(0, 0)),
    )

    pulse_panel = Panel(pulse_text, title="[bold]Ops Pulse Ticker (PULSE.log)[/bold]", border_style="blue", padding=(0, 1))

    main_grid = Table.grid(padding=0)
    main_grid.add_row(body_table)
    main_grid.add_row(ops_table)
    main_grid.add_row(pulse_panel)

    now = datetime.now(timezone.utc).strftime("%H:%M:%S UTC")
    return Panel(
        main_grid,
        title=f"[bold #00d9ff]󰒋 AQ-OS Telemetry Cockpit[/bold #00d9ff] · {header_status} · [dim]{now}[/dim]",
        border_style="#00d9ff",
        padding=(0, 1),
    )


def main():
    parser = argparse.ArgumentParser(description="AQ-OS Cockpit Monitor")
    parser.add_argument("--once", action="store_true", help="Render a single frame and exit")
    parser.add_argument("--interval", type=float, default=2.0, help="Refresh interval in seconds (default: 2.0)")
    args = parser.parse_args()

    if args.once or not sys.stdout.isatty():
        console.print(render_cockpit())
        return

    with Live(render_cockpit(), refresh_per_second=2, console=console) as live:
        try:
            while True:
                time.sleep(args.interval)
                live.update(render_cockpit())
        except KeyboardInterrupt:
            pass


if __name__ == "__main__":
    main()
