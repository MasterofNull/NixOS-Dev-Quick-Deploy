    ap.add_argument("--author-lane", default="claude")
    ap.add_argument("--lanes", default=os.environ.get("AQ_LAND_LANES", "gemini,codex,local"))
    ap.add_argument("--allow-docs-only", action="store_true")
    ap.add_argument("--optional-check", action="append", default=[])
    a = ap.parse_args()
    stage = "start"
    try:
        land = Land(a)
        return land.go()
    except Stop as e:
        print(f"aq-land: STOP {e.stage}: {e}", file=sys.stderr)
    except Exception as e:  # one line, no traceback
        print(f"aq-land: STOP {stage}: unexpected {e.__class__.__name__}: {str(e)[:200]}", file=sys.stderr)
    return 1


