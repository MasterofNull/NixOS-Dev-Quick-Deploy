# ── Safe executor dispatch table ─────────────────────────────────────────────
# executor field in the alert must match a KEY here. Free-form shell strings
# are NOT executed. This prevents arbitrary code execution via alert injection.

def _print_apparmor_rules(alert: dict) -> None:
    """Render the exact rule text the owner is approving (repr exposes hidden chars)."""
    if alert.get("executor") != "apparmor_fix":
        return
    from apparmor_rules import rule_error
    payload = alert.get("payload", {})
    rules = payload.get("rules_proposed", []) or []
    print(f"\n  AppArmor profile: {payload.get('profile')!r}   rules to insert: {len(rules)}")
    for i, rule in enumerate(rules, 1):
        err = rule_error(rule)
        print(f"    {i}. {str(rule).strip()}" + (f"    [REJECTED: {err}]" if err else ""))
        if err:
            print(f"       raw: {rule!r}")


def _handle_apparmor_fix(alert: dict) -> bool:
    """Apply staged AppArmor rules and commit via apparmor-fix-agent."""
    payload = alert.get("payload", {})
    profile = payload.get("profile", "")
    rules = payload.get("rules_proposed", [])
    if not rules:
        print("  No rules in payload — nothing to apply.", file=sys.stderr)
        return False
    from apparmor_rules import rule_error
    bad = [r for r in rules if rule_error(r)]
    if bad:
        print(f"  Refusing: {len(bad)} rule(s) fail validation: {bad!r}", file=sys.stderr)
        return False
    print(f"  Applying {len(rules)} AppArmor rule(s) to profile {profile!r}...")
    # Delegate the actual commit back to apparmor-fix-agent in commit-only mode
    repo_root = _HERE.parent.parent
    fix_agent = repo_root / "scripts" / "automation" / "apparmor-fix-agent.py"
    if fix_agent.exists():
        result = subprocess.run(
            [sys.executable, str(fix_agent), "--commit-staged", "--alert-id", alert["id"]],
            cwd=str(repo_root), capture_output=True, text=True, timeout=60,
        )
        if result.returncode == 0:
            print("  AppArmor rules applied to the profile file (NOT committed; use the PR workflow).")
            return True
        print(f"  apparmor-fix-agent --commit-staged failed:\n{result.stderr}", file=sys.stderr)
        return False
    print("  apparmor-fix-agent not found — apply rules manually.", file=sys.stderr)
    return False


def _handle_nixos_rebuild_hint(alert: dict) -> bool:
    """Print the exact nixos-rebuild command — does NOT run it (rebuild requires sudo)."""
    print()
    print("  This action requires a NixOS rebuild. Run the following command:")
    print()
    print("    sudo nixos-rebuild switch --flake .#hyperd-ai-dev")
    print()
    print("  Then verify with: aq-qa 0")
    return True


def _handle_drop_dispatch(alert: dict) -> bool:
    """Dispatch a gated agent drop."""
    payload = alert.get("payload", {})
    drop_path_str = payload.get("drop_path")
    if not drop_path_str:
        print("  No drop_path in payload.", file=sys.stderr)
        return False
    
    drop_path = Path(drop_path_str)
    if not drop_path.exists():
        print(f"  Drop file not found: {drop_path}", file=sys.stderr)
        return False

    print(f"  Dispatching approved drop: {drop_path.name}...")
    
    # Setup TaskConfig (mimic aq-drop-daemon defaults)
    import os
    config = TaskConfig.from_args(
        mode=payload.get("mode", "agent"),
        role=payload.get("role", "generalist"),
        timeout_secs=int(os.environ.get("DROP_DAEMON_TIMEOUT", "300")),
        llama_url=os.environ.get("LLAMA_URL",  "http://127.0.0.1:8080"),
        hybrid_url=os.environ.get("HYBRID_URL", "http://127.0.0.1:8003"),
        ralph_url=os.environ.get("RALPH_URL",  "http://127.0.0.1:8004"),
    )
    
    registry = TaskRegistry(_REPO_ROOT / ".agents" / "delegation", _REPO_ROOT)
    task_id = f"drop-{alert['id'][5:]}" # use alert id suffix
    output_file = _REPO_ROOT / ".agents" / "delegation" / "outputs" / f"{task_id}.log"
    output_file.parent.mkdir(parents=True, exist_ok=True)

    success = dispatch_task(
        config=config,
        prompt=payload.get("prompt", ""),
        task_id=task_id,
        output_file=output_file,
        registry=registry,
        script_dir=_HERE,
    )

    if success:
        # Archive the drop file
        archive_dir = drop_path.parent / "archive"
        archive_dir.mkdir(parents=True, exist_ok=True)
        os.rename(drop_path, archive_dir / drop_path.name)
        print(f"  Dispatch successful. Task logged to {output_file.name}")
        return True
    
    print("  Dispatch failed.", file=sys.stderr)
    return False


_EXECUTOR_TABLE = {
    "apparmor_fix":      _handle_apparmor_fix,
    "nixos_rebuild_hint": _handle_nixos_rebuild_hint,
    "drop_dispatch":     _handle_drop_dispatch,
}


def _nix_scan(text: str):
    """Lex Nix just enough to separate real code from comments and strings.

    Returns (code_mask, ind_spans): code_mask[i] is True when text[i] is top-level
    code (not in a comment or string); ind_spans lists (start, end) of top-level
    '' strings (content only). Returns None on malformed input so callers fail safe.
    """
    n = len(text)
    mask = [False] * n
    spans = []
    stack = [["code", 0]]  # ["code", brace_depth] | ["ind", start] | ["dq"]
    i = 0
    while i < n:
        mode = stack[-1][0]
        c = text[i]
        if mode == "code":
            if text.startswith("/*", i):
                j = text.find("*/", i + 2)
                if j == -1:
                    return None
                i = j + 2
                continue
            if c == "#":
                j = text.find("\n", i)
                i = n if j == -1 else j
                continue
            if text.startswith("''", i):
                stack.append(["ind", i + 2])
                i += 2
                continue
            if c == '"':
                stack.append(["dq"])
                i += 1
                continue
            if c == "{":
                stack[-1][1] += 1
            elif c == "}":
                if stack[-1][1] == 0:
                    if len(stack) == 1:
                        return None
                    stack.pop()
                    i += 1
                    continue
                stack[-1][1] -= 1
            if len(stack) == 1:
                mask[i] = True
            i += 1
        elif mode == "ind":
            if text.startswith("${", i):
                stack.append(["code", 0])
                i += 2
            elif text.startswith("''\\", i):
                i += 4  # ''\<char> escape is 4 chars; the escaped char must not pair with a following quote
            elif text.startswith("'''", i) or text.startswith("''$", i):
                i += 3
            elif text.startswith("''", i):
                if len(stack) == 2:
                    spans.append((stack[-1][1], i))
                stack.pop()
                i += 2
            else:
                i += 1
        else:  # dq
            if c == "\\":
                i += 2
            elif text.startswith("${", i):
                stack.append(["code", 0])
                i += 2
            elif c == '"':
                stack.pop()
                i += 1
            else:
                i += 1
    return (mask, spans) if len(stack) == 1 else None


def _apparmor_rules_already_present(profile: str, rules: list) -> bool:
    """True only when every rule is an effective line in the real profile body.

    Fails safe (False, so the executor runs and validates) unless the header
    security.apparmor.policies."<profile>" occurs exactly once as real code
    (not in a comment/string), starts its line, and is followed by a real
    `profile = ''...''` string before any other policies header.
    """
    if not profile or not rules:
        return False
    nix_file = _REPO_ROOT / "nix" / "modules" / "services" / "mcp-servers.nix"
    try:
        text = nix_file.read_text(encoding="utf-8")
    except OSError:
        return False
    scan = _nix_scan(text)
    if scan is None:
        return False
    mask, spans = scan
    prefix = "security.apparmor.policies."
    code_hits = [m.start() for m in re.finditer(re.escape(prefix), text) if mask[m.start()]]
    header = f'{prefix}"{profile}"'
    hits = [h for h in code_hits if text.startswith(header, h)]
    if len(hits) != 1:
        return False
    start = hits[0]
    line_start = text.rfind("\n", 0, start) + 1
    if text[line_start:start].strip():
        return False
    nxt = min([h for h in code_hits if h > start] or [len(text)])
    body = None
    for s_, e_ in spans:
        if start < s_ < nxt:
            before = text[:s_ - 2].rstrip()
            if re.search(r"(?:^|[\s;{])profile\s*=$", before):
                body = text[s_:e_]
                break
    if body is None:
        return False
    effective = set()
    for ln in body.splitlines():
        ln = ln.strip()
        if ln and not ln.startswith("#"):
            effective.add(ln.split("  #", 1)[0].strip())
    return all(str(rule).strip() in effective for rule in rules)


def _resolve_actor(label: str = "") -> str:
    """OS identity of the approver (never a hardcoded string), plus optional label."""
    import os
    import pwd
    try:
        user = pwd.getpwuid(os.getuid()).pw_name
    except KeyError:
        user = f"uid:{os.getuid()}"
    return f"{user}:{label}" if label else user


def approve_alert(alert_id: str, actor: str) -> int:
    """Approve one attention alert: claim, run its executor, finalize."""
    alert = get_by_id(alert_id)

    if not alert:
        print(f"Alert {alert_id!r} not found.", file=sys.stderr)
        return 1

    if alert.get("status") != "pending":
        print(f"Alert {alert_id} is already {alert.get('status')!r} — nothing to approve.")
        return 0

    # Atomic single-use claim BEFORE any side effect: only the winner executes.
    claimed, reason, alert = claim_for_execution(alert_id, actor)
    if not claimed:
        print(f"Alert {alert_id} already claimed/resolved ({reason}) — nothing executed.")
        return 0

    boundary = alert.get("autonomy_boundary", "")
    print(f"\n  Approving: {alert.get('title', alert_id)}")
    print(f"  Boundary:  {boundary}")
    _print_apparmor_rules(alert)

    executor_key = alert.get("executor")
    ok, err = True, ""
    try:
        if executor_key:
            if executor_key == "apparmor_fix":
                from apparmor_rules import rule_error
                bad = [r for r in alert.get("payload", {}).get("rules_proposed", []) or [] if rule_error(r)]
                if bad:
                    print(f"  Refusing: {len(bad)} rule(s) fail validation: {bad!r}", file=sys.stderr)
                    ok, err = False, "rule validation failed"
                    executor_key = None
            if (
                ok
                and executor_key == "apparmor_fix"
                and _apparmor_rules_already_present(
                    alert.get("payload", {}).get("profile", ""),
                    alert.get("payload", {}).get("rules_proposed", []),
                )
            ):
                print("  Proposed AppArmor rule(s) already present in mcp-servers.nix.")
                executor_key = None
            handler = _EXECUTOR_TABLE.get(executor_key)
            if executor_key is None:
                pass
            elif not handler:
                print(f"  Unknown executor key {executor_key!r} — approval recorded but no action taken.", file=sys.stderr)
            else:
                ok = bool(handler(alert))
                if not ok:
                    err = "executor returned failure"
    except Exception as exc:  # noqa: BLE001 — record terminal failure, never re-run
        ok, err = False, f"{type(exc).__name__}: {exc}"

    if not finalize_claim(alert_id, ok, actor=actor, error=err):
        print("  finalize failed — claimed alert state changed unexpectedly.", file=sys.stderr)
        return 1
    if not ok:
        print(f"  Executor failed ({err}). Alert marked FAILED (terminal; not re-run). "
              "Push a new alert to retry.", file=sys.stderr)
        return 1
    print("  Approved. Alert archived.")
    return 0


def show_alert(alert_id: str) -> int:
    """Print one alert's full detail (read-only)."""
    from attention_queue import dashboard_link, is_snoozed
    a = get_by_id(alert_id)
    if not a:
        print(f"Alert {alert_id!r} not found (resolved or expired?). Try: aq-approve list", file=sys.stderr)
        return 1
    print(f"\n  {a.get('title')}")
    print(f"  id: {a['id']}   status: {a.get('status')}   severity: {a.get('severity')}   source: {a.get('source')}")
    for label, key in (("What", "detail"), ("Why", "why"), ("Next", "next_step"), ("Proposed", "proposed_action")):
        if a.get(key):
            print(f"\n  {label}: {a[key]}")
    if a.get("command"):
        print(f"\n  Command: {a['command']}")
    _print_apparmor_rules(a)
    if a.get("executor"):
        print(f"\n  Approving runs executor: {a['executor']}  (review with: aq-approve review {a['id']})")
    print(f"\n  Details: {a.get('link') or dashboard_link(a['id'])}")
    if is_snoozed(a):
        print("  (notifications snoozed)")
    return 0


def review_alert(alert_id: str) -> int:
    """Show the alert, then PROMPT. Never approves without an interactive yes."""
    rc = show_alert(alert_id)
    if rc or not get_by_id(alert_id) or get_by_id(alert_id).get("status") != "pending":
        return rc
    if not sys.stdin.isatty():
        print("  review needs an interactive terminal; nothing approved.", file=sys.stderr)
        return 2
    try:
        answer = input("\n  Approve this action? [y/N] ").strip().lower()
    except EOFError:
        answer = ""
    if answer not in ("y", "yes"):
        print("  Not approved. Alert left pending.")
        return 0
    return approve_alert(alert_id, _resolve_actor("owner"))


def main(argv=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if len(argv) == 2 and argv[0] in ("show", "review") and argv[1].startswith("attn-"):
        return (show_alert if argv[0] == "show" else review_alert)(argv[1])
    from approval_inbox import inbox_cli
    return inbox_cli(argv, approve_alert, _resolve_actor)


if __name__ == "__main__":
    sys.exit(main())
