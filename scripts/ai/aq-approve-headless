def _print_details(record: Mapping[str, Any], *, out) -> None:
    summary = record["summary"]
    trail = record["technical_trail"]
    print(f"     request_id:  {record['request_id']}", file=out)
    print(f"     status:      {record['status']}", file=out)
    print(f"     created_at:  {record['created_at']}", file=out)
    print(f"     what:        {summary['what']}", file=out)
    print(f"     why:         {summary['why']}", file=out)
    print(f"     impact:      {summary['impact']}", file=out)
    print(f"     reversible:  {summary['reversible']}", file=out)
    print(f"     runbook:     {record['action_manifest']['runbook']}", file=out)
    print(f"     target_files:{trail['target_files']}", file=out)
    print(f"     design_hash: {trail['design_sha256']}", file=out)
    print(f"     canonical_hash: {record['binding']['canonical_hash']}", file=out)


def cmd_list(store: ApprovalStore, *, details: bool = False, out=sys.stdout) -> int:
    pending = store.list_pending()
    print(PREP_COPY["list_header"], file=out)
    if not pending:
        print("  (none)", file=out)
        return 0
    for n, record in enumerate(pending, start=1):
        title = record["summary"]["title"]
        print("  " + PREP_COPY["request_line_format"].format(n=n, title=title), file=out)
        if details:
            _print_details(record, out=out)
    return 0


def cmd_deny(store: ApprovalStore, request_id: str, *, actor: str = "owner", out=sys.stdout) -> int:
    record = store.get(request_id)
    if record is None:
        print(f"Request not found: {request_id}", file=out)
        return 1
    if record["status"] != AR.STATUS_PENDING:
        print(_ALREADY_DONE_MESSAGE, file=out)
        return 1
    try:
        store.transition(request_id, AR.STATUS_DENIED, actor=actor)
    except (AR.ApprovalStateError, ApprovalStoreError):
        print(_ALREADY_DONE_MESSAGE, file=out)
        return 1
    print(PREP_COPY["denied_message"], file=out)
    return 0


def cmd_approve(
    store: ApprovalStore,
    signer: AS.ApprovalSigner,
    owner_key: bytes,
    request_id: str,
    *,
    get_assertion: Callable[..., Optional[w.AuthenticationResponse]],
    rp_id: str,
    credential_ids: Sequence[bytes],
    out=sys.stdout,
) -> int:
    """The whole headless approve ceremony. `get_assertion` is the ONLY
    injection seam for the human-factor step (production: `main()` wires
    `HidrawFido2Client().get_assertion`; tests: a software authenticator's
    `get_assertion`, TEST-ONLY, imported nowhere near this module). Every
    other step calls the SAME `ApprovalSigner` instance a browser-driven P2
    approval would call — reusing the identical signer path is the whole
    point of P4 (design "same guarantees")."""
    record = store.get(request_id)
    if record is None:
        print(f"Request not found: {request_id}", file=out)
        return 1
    if record["status"] != AR.STATUS_PENDING:
        print(_ALREADY_DONE_MESSAGE, file=out)
        return 1
    if not credential_ids:
        # No point starting a signing session (and burning a rate-limit
        # slot) when there is nothing registered to approve with.
        print(PREP_COPY["no_key_message"], file=out)
        return 1

    cv = signer.begin_challenge(request_id, load_record=store.get)
    if not cv.ok:
        print(_plain_deny_message(cv.reason), file=out)
        return 1

    print(PREP_COPY["approve_prompt"], file=out)
    try:
        assertion = get_assertion(
            challenge=cv.challenge,
            rp_id=rp_id,
            credential_ids=list(credential_ids),
            user_verification="required",
        )
    except Exception:  # noqa: BLE001 - any ceremony fault -> no signature, fail closed
        assertion = None
    if assertion is None:
        print(PREP_COPY["no_key_message"], file=out)
        return 1

    sv = signer.sign_request(request_id, assertion, load_record=store.get, owner_key=owner_key)
    if not sv.ok:
        print(_plain_deny_message(sv.reason), file=out)
        return 1

    try:
        store.transition(request_id, AR.STATUS_APPROVED, actor="owner-webauthn")
    except (AR.ApprovalStateError, ApprovalStoreError):
        # The signature is genuine (sv.ok) but the store's own state moved
        # out from under us between sign and transition -- surface plainly
        # rather than claiming success for a state change that didn't land.
        print(
            "Approved by signature, but the request could not be marked approved "
            "-- it may have changed state. Contact your admin.",
            file=out,
        )
        return 1

    print(PREP_COPY["success_message"], file=out)
    return 0


# --------------------------------------------------------------------------
# main() — production wiring. Everything storage/key/hardware-related is a
# thin adapter around the injectable core functions above.
# --------------------------------------------------------------------------

_DEFAULT_ALLOWLIST_PATH = _REPO_ROOT / "config" / "aqos" / "approval-signer-credentials.json"
_DEFAULT_STATE_DIR = _REPO_ROOT / ".agents" / "state" / "approval-control-plane"
_DEFAULT_RP_ID = "aq-approve.local"


def _build_signer(*, allowlist_path: str, state_dir: str, rp_id: str) -> AS.ApprovalSigner:
    base = Path(state_dir)
    return AS.ApprovalSigner(
        credential_allowlist_path=allowlist_path,
        challenge_store_dir=base / "pending",
        challenge_ledger_dir=base / "challenge-ledger",
        executed_ledger_dir=base / "executed-ledger",
        rp_id=rp_id,
    )


def _load_owner_key(path: Optional[str]) -> Optional[bytes]:
    """Reads the service's raw 32-byte Ed25519 signing key. NOT the
    human-factor authorization -- see module docstring. There is no live
    provisioning for this key yet (P1b/deployment scope); until a confined
    service exists to hold it, this CLI's caller must point
    `--owner-key-path` at wherever it lives. Fails closed (`None`) on
    anything but exactly 32 bytes -- `main()` refuses to proceed without it,
    rather than passing a malformed key into `sign_request`."""
    if not path:
        return None
    try:
        raw = Path(path).read_bytes()
    except OSError:
        return None
    return raw if len(raw) == 32 else None


def _active_credential_ids(allowlist_path: str) -> List[bytes]:
    allowlist = AS.load_credential_allowlist(allowlist_path)
    if not allowlist:
        return []
    return [
        bytes.fromhex(cred_id)
        for cred_id, entry in allowlist.items()
        if entry.get("status") == AS.CREDENTIAL_STATUS_ACTIVE
    ]


def build_arg_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="aq-approve-headless",
        description="Approval Control Plane P4 -- headless/rescue FIDO2 authorization, no browser required.",
    )
    parser.add_argument(
        "--allowlist-path",
        default=os.environ.get("AQ_APPROVAL_CREDENTIAL_ALLOWLIST", str(_DEFAULT_ALLOWLIST_PATH)),
        help="Path to the FIDO2 credential allowlist (same file approval_signer.py reads).",
    )
    parser.add_argument(
        "--state-dir",
        default=os.environ.get("AQ_APPROVAL_STATE_DIR", str(_DEFAULT_STATE_DIR)),
        help="Directory for the signer's pending-challenge + single-use ledgers.",
    )
    parser.add_argument(
        "--owner-key-path",
        default=os.environ.get("AQ_APPROVAL_OWNER_KEY_PATH"),
        help="Path to the service's raw 32-byte Ed25519 signing key (deployment-layer secret; "
        "not the human-factor authorization -- see module docstring). Required for `approve`.",
    )
    parser.add_argument(
        "--rp-id",
        default=os.environ.get("AQ_APPROVAL_RP_ID", _DEFAULT_RP_ID),
        help="WebAuthn relying-party id bound into the challenge (must match registration).",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_list = sub.add_parser("list", help="List pending approval requests (plain language).")
    p_list.add_argument("--details", action="store_true", help="Also show the Layer-3 drill-in.")

    p_approve = sub.add_parser("approve", help="Approve a pending request via a local FIDO2 tap.")
    p_approve.add_argument("request_id")

    p_deny = sub.add_parser("deny", help="Deny a pending request. No hardware ceremony.")
    p_deny.add_argument("request_id")
    p_deny.add_argument("--actor", default="owner")

    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = build_arg_parser().parse_args(argv)

    # No live request store yet (scope fence) -- FixtureApprovalStore is the
    # documented offline placeholder a real deployment replaces.
    store: ApprovalStore = FixtureApprovalStore()

    if args.command == "list":
        return cmd_list(store, details=args.details)

    if args.command == "deny":
        return cmd_deny(store, args.request_id, actor=args.actor)

    if args.command == "approve":
        owner_key = _load_owner_key(args.owner_key_path)
        if owner_key is None:
            print(
                "No owner signing key configured (--owner-key-path / AQ_APPROVAL_OWNER_KEY_PATH "
                "must point at a 32-byte Ed25519 key). This build ships no live key provisioning "
                "-- see .agents/plans/approval-control-plane/ACP-P4-BUILD-20260817.md.",
                file=sys.stderr,
            )
            return 1
        signer = _build_signer(
            allowlist_path=args.allowlist_path, state_dir=args.state_dir, rp_id=args.rp_id
        )
        credential_ids = _active_credential_ids(args.allowlist_path)
        client = HidrawFido2Client()
        return cmd_approve(
            store,
            signer,
            owner_key,
            args.request_id,
            get_assertion=client.get_assertion,
            rp_id=args.rp_id,
            credential_ids=credential_ids,
        )

    return 1  # pragma: no cover - argparse `required=True` makes this unreachable


if __name__ == "__main__":
    sys.exit(main())
