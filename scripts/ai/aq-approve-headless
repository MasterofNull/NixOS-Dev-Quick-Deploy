class _CliUserInteraction(UserInteraction):
    """Local console human-factor prompts for the real python-fido2 ceremony.

    `request_pin` prompts for a CTAP2 clientPIN when the connected
    authenticator requires PIN-based user verification instead of (or in
    addition to) an on-device biometric/touch check. This is the WebAuthn/
    CTAP2 standard's OWN user-verification mechanism, scoped to unlocking
    THIS physical device's own signing operation — it is not a substitute
    for the hardware ceremony PRD R2 forbids downgrading to: without the
    authenticator physically present, no PIN (correct or not) produces a
    valid assertion, so this is not an "agent-forceable" path either — an
    agent with no console/TTY gets `getpass` failing closed (`None`,
    handled as ceremony-cancelled) rather than a fabricated PIN.
    """

    def prompt_up(self) -> None:  # pragma: no cover - device-driven callback
        return None

    def request_pin(self, permissions, rp_id):  # noqa: ANN001 - fido2 lib types
        try:
            return getpass.getpass("FIDO2 PIN: ")
        except (EOFError, KeyboardInterrupt, OSError):
            return None

    def request_uv(self, permissions, rp_id) -> bool:  # noqa: ANN001 - fido2 lib types
        return True


class HidrawFido2Client:
    """Production FIDO2 hidraw authenticator client — enumerates real USB
    HID FIDO2 devices (`fido2.hid.CtapHidDevice.list_devices()`) and drives
    python-fido2's REAL GetAssertion ceremony (`fido2.client.Fido2Client`).
    No browser/RP-origin round trip exists here (design "P4 FIDO2 headless
    reference" gotcha): this CLI IS the WebAuthn client, so `get_assertion`
    is called with the SAME request-bound challenge
    `ApprovalSigner.begin_challenge` derived, and the resulting
    `AuthenticationResponse` is handed straight to
    `ApprovalSigner.sign_request` unmodified.

    DECLARATIVE FOLLOW-UP (documented per design "Rescue-console note" +
    scope fence "no declarative udev" — NOT shipped by this build): reading
    a USB hidraw FIDO2 device node requires the invoking user to have
    kernel-level access to it. A live deployment must add a NixOS
    `services.udev.extraRules` entry declaratively (Rule 13 — NixOS
    declarative-only; no runtime `chmod`/`udevadm trigger` workaround),
    granting a dedicated group access to the FIDO2 HID usage page, e.g.:
        SUBSYSTEM=="hidraw", KERNEL=="hidraw*", \\
          ATTRS{idVendor}=="<vid>", ATTRS{idProduct}=="<pid>", \\
          TAG+="uaccess", GROUP="approval-operators", MODE="0660"
    (or the vendor-neutral FIDO_ALLOWED-usage-page udev snippet upstream
    python-fido2/libfido2 ship). Until that rule exists, `list_devices()`
    below legitimately returns nothing for a non-privileged user — this
    fails closed into `no_key_message`, never a crash.
    """

    def __init__(self) -> None:
        self._interaction = _CliUserInteraction()

    def get_assertion(
        self,
        *,
        challenge: bytes,
        rp_id: str,
        credential_ids: Sequence[bytes],
        user_verification: str = "required",
    ) -> Optional[w.AuthenticationResponse]:
        try:
            devices = list(CtapHidDevice.list_devices())
        except Exception:  # noqa: BLE001 - any enumeration fault -> no key found
            return None
        if not devices:
            return None

        origin = f"https://{rp_id}"
        collector = DefaultClientDataCollector(origin=origin)
        descriptors = [
            w.PublicKeyCredentialDescriptor(type=w.PublicKeyCredentialType.PUBLIC_KEY, id=cid)
            for cid in credential_ids
        ]
        options = w.PublicKeyCredentialRequestOptions(
            challenge=challenge,
            rp_id=rp_id,
            allow_credentials=descriptors or None,
            user_verification=w.UserVerificationRequirement(user_verification),
        )
        for device in devices:
            try:
                client = Fido2Client(device, collector, user_interaction=self._interaction)
                selection = client.get_assertion(options)
            except Exception:  # noqa: BLE001 - this device could not complete it, try the next
                continue
            assertions = selection.get_assertions()
            if assertions:
                return selection.get_response(0)
        return None


