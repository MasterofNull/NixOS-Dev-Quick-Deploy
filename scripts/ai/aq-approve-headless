PREP_COPY: Dict[str, str] = {
    "list_header": "Pending Approvals",
    "request_line_format": "{n}. {title}",
    "approve_prompt": "Please touch the metal button on your security key when it lights up.",
    "success_message": "Approved successfully.",
    "denied_message": "Request denied.",
    "no_key_message": "No security key detected. Please plug one in and try again.",
}

_ALREADY_DONE_MESSAGE = "This request was already approved and carried out."

# `ApprovalSigner`/`sign_request` denial reasons that mean "there was no
# usable hardware credential to complete this with" -> the prep no_key
# message reads truer than the generic denied message for these.
_NO_KEY_REASONS = frozenset(
    {
        AS.DENY_ASSERTION_MISSING,
        AS.DENY_UNKNOWN_CREDENTIAL,
        AS.DENY_CREDENTIAL_NOT_ACTIVE,
        AS.DENY_ALLOWLIST_UNAVAILABLE,
    }
)
_ALREADY_DONE_REASONS = frozenset({AS.DENY_EXECUTED_REPLAY, AS.DENY_CHALLENGE_REPLAY})


def _plain_deny_message(reason: str) -> str:
    """Map a typed `approval_signer` denial reason to plain language. Every
    `DENY_*`/`CHALLENGE_*` reason is a safe, hand-picked lowercase-hyphen
    token (see `approval_signer.py`'s vocabulary) — never a hash, path, or
    key id — so surfacing it as a parenthetical fallback for the reasons not
    explicitly mapped below is still within the "no hex/path in the default
    view" privacy boundary; it is not the primary message."""
    if reason in _NO_KEY_REASONS:
        return PREP_COPY["no_key_message"]
    if reason in _ALREADY_DONE_REASONS:
        return _ALREADY_DONE_MESSAGE
    return f"{PREP_COPY['denied_message']} ({reason})"


# --------------------------------------------------------------------------
# ApprovalStore — injected record source (design "no live request store").
# Same Protocol shape `dashboard/backend/api/routes/approvals.py`'s P2 build
# already established (mirrored here, not imported — this file must not
# depend on `dashboard/`, which another lane may be actively changing). A
# real deployment supplies a real `ApprovalStore` implementation; this CLI
# ships `FixtureApprovalStore` as its offline default, exactly as P2 does.
# --------------------------------------------------------------------------


class ApprovalStoreError(Exception):
    def __init__(self, reason: str) -> None:
        super().__init__(reason)
        self.reason = reason


class ApprovalStore(Protocol):
    def list_pending(self) -> List[dict]: ...

    def get(self, request_id: str) -> Optional[dict]: ...

    def transition(self, request_id: str, new_status: str, *, actor: str) -> dict: ...


def _default_fixture_records() -> List[dict]:
    return [
        AR.create_request(
            request_id="01J8K9M2N3P4Q5R6S7T8U9V0A1",
            created_by="fixture-seed",
            runbook="restart-service",
            params={"service": "hybrid-coordinator"},
        ),
        AR.create_request(
            request_id="01J8K9M2N3P4Q5R6S7T8U9V0B2",
            created_by="fixture-seed",
