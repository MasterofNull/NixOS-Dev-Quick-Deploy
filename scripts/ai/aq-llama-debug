#!/usr/bin/env bash
. "${BASH_SOURCE[0]%/*}/lib/aq-shim.sh" 2>/dev/null || true  # aq-usage-hook
# Compatibility wrapper around the generic runtime diagnosis loop.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "${SCRIPT_DIR}/aq-runtime-diagnose" --preset llama-cpp "$@"
