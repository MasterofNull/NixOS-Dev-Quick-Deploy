#!/usr/bin/env bash
. "${BASH_SOURCE[0]%/*}/lib/aq-shim.sh" 2>/dev/null || true  # aq-usage-hook
# aq-agent-launcher — Direct CLI agent launcher for aq-workspace tiled panes
#
# Provides direct, native access to full agent CLI tools within Zellij panes:
#   • Claude Code (claude --resume / claude)
#   • OpenAI Codex (codex resume / codex)
#   • Local Qwen3-35B (aq-resume + aq-chat)
#   • Google Gemini (gemini --resume / gemini / aq-agent-window)
#   • Coordinator REPL (aq-coordinator-repl)
#
# Features:
#   • Direct interactive CLI access with full tool calling & execution
#   • Instant session resume support (default 3s timeout or immediate Enter)
#   • Persistent pane loop — never abruptly closes Zellij panes on agent exit
#   • Full terminal color and TTY passthrough

set -eo pipefail

AGENT="${1:-local}"
MODE="${2:-${AQ_WORKSPACE_MODE:-prompt}}"

# 1. Resolve repository root
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Ensure all agent tool paths are exported
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$SCRIPT_DIR:$REPO_ROOT/scripts/ai:$REPO_ROOT/scripts/governance:$PATH"
export PYTHONPATH="${REPO_ROOT}:${REPO_ROOT}/ai-stack:${REPO_ROOT}/ai-stack/mcp-servers:${REPO_ROOT}/scripts/ai:${PYTHONPATH:-}"

export TERM="${TERM:-xterm-256color}"
if [ "$TERM" = "dumb" ]; then
  export TERM="xterm-256color"
fi

cd "$REPO_ROOT"

# Resolve agent binary and presentation details
AGENT_TITLE=""
AGENT_COLOR=""
AGENT_BIN=""

case "$AGENT" in
  claude)
    AGENT_TITLE="Claude 3.7 / Fable-5 (Claude Code CLI)"
    AGENT_COLOR="\033[1;35m" # Magenta
    AGENT_BIN="$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")"
    if [ -x "$AGENT_BIN" ]; then
      RESUME_CMD=("$AGENT_BIN" "--resume")
      NEW_CMD=("$AGENT_BIN")
    else
      AGENT_BIN="$SCRIPT_DIR/aq-agent-window"
      RESUME_CMD=("python3" "$SCRIPT_DIR/aq-agent-window" "--lane" "claude")
      NEW_CMD=("python3" "$SCRIPT_DIR/aq-agent-window" "--lane" "claude")
    fi
    ;;
  codex)
    AGENT_TITLE="OpenAI Codex / GPT-6 Astra (Codex CLI)"
    AGENT_COLOR="\033[1;32m" # Green
    AGENT_BIN="$(command -v codex 2>/dev/null || echo "$HOME/.npm-global/bin/codex")"
    if [ -x "$AGENT_BIN" ]; then
      RESUME_CMD=("$AGENT_BIN" "resume")
      NEW_CMD=("$AGENT_BIN")
    else
      AGENT_BIN="$SCRIPT_DIR/aq-agent-window"
      RESUME_CMD=("python3" "$SCRIPT_DIR/aq-agent-window" "--lane" "codex")
      NEW_CMD=("python3" "$SCRIPT_DIR/aq-agent-window" "--lane" "codex")
    fi
    ;;
  local|qwen)
    AGENT_TITLE="Local Qwen3-35B APU (aq-chat Tool Calling)"
    AGENT_COLOR="\033[1;36m" # Cyan
    AGENT_BIN="$(command -v aq-chat 2>/dev/null || echo "$SCRIPT_DIR/aq-chat")"
    if [ -x "$AGENT_BIN" ]; then
      RESUME_CMD=("$AGENT_BIN")
      NEW_CMD=("$AGENT_BIN")
    else
      AGENT_BIN="$SCRIPT_DIR/aq-agent-window"
      RESUME_CMD=("python3" "$SCRIPT_DIR/aq-agent-window" "--lane" "local")
      NEW_CMD=("python3" "$SCRIPT_DIR/aq-agent-window" "--lane" "local")
    fi
    ;;
  gemini|antigravity)
    AGENT_TITLE="Google Antigravity / Gemini 3.8-Flash (Switchboard :8085)"
    AGENT_COLOR="\033[1;34m" # Blue/Purple
    AGENT_BIN="$SCRIPT_DIR/aq-agent-window"
    RESUME_CMD=("python3" "$SCRIPT_DIR/aq-agent-window" "--lane" "gemini")
    NEW_CMD=("python3" "$SCRIPT_DIR/aq-agent-window" "--lane" "gemini")
    ;;
  coordinator|repl)
    AGENT_TITLE="Central Steering Coordinator REPL"
    AGENT_COLOR="\033[1;33m" # Yellow
    AGENT_BIN="$SCRIPT_DIR/aq-coordinator-repl"
    RESUME_CMD=("python3" "$SCRIPT_DIR/aq-coordinator-repl")
    NEW_CMD=("python3" "$SCRIPT_DIR/aq-coordinator-repl")
    ;;
  *)
    AGENT_TITLE="Agent Lane: $AGENT"
    AGENT_COLOR="\033[1;36m"
    AGENT_BIN="$SCRIPT_DIR/aq-agent-window"
    RESUME_CMD=("python3" "$SCRIPT_DIR/aq-agent-window" "--lane" "$AGENT")
    NEW_CMD=("python3" "$SCRIPT_DIR/aq-agent-window" "--lane" "$AGENT")
    ;;
esac

# Append extra arguments if passed
if [ "$#" -gt 2 ]; then
  EXTRA_ARGS=("${@:3}")
  NEW_CMD+=("${EXTRA_ARGS[@]}")
  RESUME_CMD+=("${EXTRA_ARGS[@]}")
fi

NC="\033[0m"
DIM="\033[2m"
BOLD="\033[1m"

get_auth_status() {
  case "$AGENT" in
    claude)
      if command -v claude >/dev/null 2>&1; then
        local st
        st="$(claude auth status 2>/dev/null || true)"
        if echo "$st" | grep -Eq '"loggedIn":\s*true'; then
          local sub
          sub="$(echo "$st" | grep -o '"subscriptionType":\s*"[^"]*"' | cut -d'"' -f4 || echo "active")"
          echo -e "\033[1;32m✓ Logged in (${sub})\033[0m"
          return
        fi
      fi
      echo -e "\033[1;33m! Not logged in (select [4] to sign in)\033[0m"
      ;;
    codex)
      if command -v codex >/dev/null 2>&1; then
        local st
        st="$(codex login status 2>&1 || true)"
        if echo "$st" | grep -qi "logged in"; then
          echo -e "\033[1;32m✓ Logged in (ChatGPT)\033[0m"
          return
        fi
      fi
      echo -e "\033[1;33m! Not logged in (select [4] to sign in)\033[0m"
      ;;
    local|qwen)
      echo -e "\033[1;32m✓ Local APU (Zero login required)\033[0m"
      ;;
    gemini|antigravity)
      echo -e "\033[1;32m✓ Antigravity IDE OAuth / Session Active\033[0m"
      ;;
    *)
      echo -e "\033[2mLocal / Environment Auth\033[0m"
      ;;
  esac
}

check_session_token_safety() {
  local target_agent="$1"

  if [ "$target_agent" = "claude" ]; then
    local encoded_pwd
    encoded_pwd="$(echo "$REPO_ROOT" | sed 's|/|-|g')"
    local project_dir="$HOME/.claude/projects/$encoded_pwd"
    if [ -d "$project_dir" ]; then
      local latest_session
      latest_session="$(ls -t "$project_dir"/*.jsonl 2>/dev/null | grep -v "/archive/" | head -1 || true)"
      if [ -n "$latest_session" ] && [ -f "$latest_session" ]; then
        local size_bytes
        size_bytes="$(stat -c%s "$latest_session" 2>/dev/null || echo 0)"
        local size_mb=$((size_bytes / 1024 / 1024))
        local lines
        lines="$(wc -l < "$latest_session" 2>/dev/null || echo 0)"
        local session_id
        session_id="$(basename "$latest_session" .jsonl)"

        # Transcript size is a diagnostic trigger, not a measurement of model context.
        if [ "$size_mb" -gt 3 ] || [ "$lines" -gt 1500 ]; then
          echo ""
          echo -e "\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
          echo -e "  \033[1;31m⚠️  CLAUDE TOKEN BUDGET SAFETY WARNING\033[0m"
          echo -e "  Latest recorded session is \033[1;33m${size_mb} MB (${lines} lines)\033[0m: ${session_id}"
          echo -e "  Transcript size does not measure current input tokens or compaction state."
          echo -e "  Check provider usage before choosing a session to resume."
          echo -e "\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
          echo -e "  \033[1m[1]\033[0m Start Clean Session \033[1;32m(loads configured startup context)\033[0m \033[1;32m[DEFAULT]\033[0m"
          echo -e "  \033[1m[2]\033[0m Inspect Sessions & Start Fresh \033[1;36m(read-only diagnostic)\033[0m"
          echo -e "  \033[1m[3]\033[0m Force Resume Anyway \033[1;31m(usage not measured)\033[0m"
          echo -e "\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
          echo -ne "  \033[1mSelect [1-3] or press Enter to start clean: \033[0m"
          local safety_choice=""
          read -n 1 safety_choice || true
          echo ""
          case "$safety_choice" in
            2|c|C)
              if [ -x "$SCRIPT_DIR/aq-session-compact" ] && python3 "$SCRIPT_DIR/aq-session-compact" --agent claude; then
                echo "  Read-only scan complete; no session was compacted or handoff saved."
              else
                echo "  Session scan unavailable or failed; no compaction or handoff verified." >&2
              fi
              echo "  Starting fresh. Save a handoff first if prior session state is needed."
              return 1  # start clean
              ;;
            3)
              echo -e "  \033[1;33m! Proceeding with force resume (monitor token usage!)...\033[0m"
              return 0  # proceed with resume
              ;;
            *)
              echo -e "  \033[1;32m✓ Starting fresh clean session (token-efficient)...\033[0m"
              return 1  # start clean
              ;;
          esac
        fi
      fi
    fi
  elif [ "$target_agent" = "codex" ]; then
    local codex_db="$HOME/.codex/state_5.sqlite"
    if [ -f "$codex_db" ] && command -v sqlite3 >/dev/null 2>&1; then
      local latest_rollout
      latest_rollout="$(sqlite3 "$codex_db" "SELECT rollout_path FROM threads ORDER BY updated_at DESC LIMIT 1;" 2>/dev/null || true)"
      if [ -n "$latest_rollout" ] && [ -f "$latest_rollout" ]; then
        local size_bytes
        size_bytes="$(stat -c%s "$latest_rollout" 2>/dev/null || echo 0)"
        local size_mb=$((size_bytes / 1024 / 1024))
        local lines
        lines="$(wc -l < "$latest_rollout" 2>/dev/null || echo 0)"
        local thread_id
        thread_id="$(basename "$latest_rollout" .jsonl | sed 's/.*rollout-[0-9T-]*-\?//')"

        # Transcript size does not establish current context or remaining provider budget.
        if [ "$size_mb" -gt 2 ] || [ "$lines" -gt 500 ]; then
          echo ""
          echo -e "\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
          echo -e "  \033[1;31m⚠️  CODEX TOKEN BUDGET SAFETY WARNING\033[0m"
          echo -e "  Latest recorded thread is \033[1;33m${size_mb} MB (${lines} lines)\033[0m: ${thread_id}"
          echo -e "  Transcript size does not measure current input tokens or compaction state."
          echo -e "  Check provider usage before choosing a session to resume."
          echo -e "\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
          echo -e "  \033[1m[1]\033[0m Start Clean Session \033[1;32m(loads configured startup context)\033[0m \033[1;32m[DEFAULT]\033[0m"
          echo -e "  \033[1m[2]\033[0m Inspect Sessions & Start Fresh \033[1;36m(read-only diagnostic)\033[0m"
          echo -e "  \033[1m[3]\033[0m Force Resume Anyway \033[1;31m(usage not measured)\033[0m"
          echo -e "\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
          echo -ne "  \033[1mSelect [1-3] or press Enter to start clean: \033[0m"
          local safety_choice=""
          read -n 1 safety_choice || true
          echo ""
          case "$safety_choice" in
            2|c|C)
              if [ -x "$SCRIPT_DIR/aq-session-compact" ] && python3 "$SCRIPT_DIR/aq-session-compact" --agent codex; then
                echo "  Read-only scan complete; no session was compacted or handoff saved."
              else
                echo "  Session scan unavailable or failed; no compaction or handoff verified." >&2
              fi
              echo "  Starting fresh. Save a handoff first if prior session state is needed."
              return 1  # start clean
              ;;
            3)
              echo -e "  \033[1;33m! Proceeding with force resume (monitor token usage!)...\033[0m"
              return 0  # proceed with resume
              ;;
            *)
              echo -e "  \033[1;32m✓ Starting fresh clean Codex session (token-efficient)...\033[0m"
              return 1  # start clean
              ;;
          esac
        fi
      fi
    fi
  fi
  return 0
}

launch_agent() {
  local action="$1"

  echo -e "\n${BOLD}${AGENT_COLOR}▶ Starting ${AGENT_TITLE}...${NC}\n"
  
  # Hydrate context from aq-resume for agents to preserve state without token bloat
  if [ -x "$SCRIPT_DIR/aq-resume" ]; then
    echo -e "${DIM}Hydrating context via aq-resume...${NC}"
    "$SCRIPT_DIR/aq-resume" || true
    echo ""
  fi

  if [ "$action" = "resume" ]; then
    if ! check_session_token_safety "$AGENT"; then
      "${NEW_CMD[@]}" || {
        local ec=$?
        echo -e "\n${DIM}Session exited with code $ec.${NC}"
      }
      return
    fi
    "${RESUME_CMD[@]}" || {
      local ec=$?
      echo -e "\n${DIM}Resume exited with code $ec. Falling back to fresh session option...${NC}"
    }
  elif [ "$action" = "new" ]; then
    "${NEW_CMD[@]}" || {
      local ec=$?
      echo -e "\n${DIM}Session exited with code $ec.${NC}"
    }
  elif [ "$action" = "login" ]; then
    echo -e "${BOLD}${AGENT_COLOR}▶ Initiating sign-in / authentication for ${AGENT_TITLE}...${NC}\n"
    case "$AGENT" in
      claude)
        claude auth login || true
        ;;
      codex)
        codex login || true
        ;;
      gemini)
        gemini || true
        ;;
      local|qwen)
        echo -e "${DIM}Local Qwen runs directly on the local APU (:8080 / :8003). No external sign-in required!${NC}"
        sleep 2
        ;;
      *)
        echo -e "${DIM}No dedicated sign-in command for ${AGENT}.${NC}"
        sleep 2
        ;;
    esac
  elif [ "$action" = "shell" ]; then
    echo -e "${DIM}Spawning dev shell in workspace ($PWD)... Type 'exit' to return.${NC}"
    "${SHELL:-bash}"
  fi
}

# Main interactive supervisor loop (preserves Zellij pane)
while true; do
  if [ "$MODE" = "direct" ]; then
    launch_agent "new"
  elif [ "$MODE" = "resume" ]; then
    launch_agent "resume"
  elif [ "$MODE" = "new" ]; then
    launch_agent "new"
  elif [ "$MODE" = "prompt" ]; then
    clear 2>/dev/null || true
    echo -e "${BOLD}${AGENT_COLOR}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  󰚩 ${BOLD}${AGENT_TITLE}${NC}"
    echo -e "  ${DIM}Direct Native CLI Access · AQ-OS Tiled Workspace${NC}"
    echo -e "  Auth Status: $(get_auth_status)"
    echo -e "${BOLD}${AGENT_COLOR}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${BOLD}[1]${NC} Start Clean Session        ${DIM}(fresh interactive prompt — token efficient)${NC} ${BOLD}${AGENT_COLOR}[DEFAULT]${NC}"
    echo -e "  ${BOLD}[2]${NC} Resume Previous Session    ${DIM}(safety-checked against context bloat)${NC}"
    echo -e "  ${BOLD}[3]${NC} Open Workspace Shell       ${DIM}(bash inside repo root)${NC}"
    echo -e "  ${BOLD}[4]${NC} Sign In / Re-authenticate   ${DIM}(auth login)${NC}"
    echo -e "  ${BOLD}[q]${NC} Close Pane"
    echo -e "${BOLD}${AGENT_COLOR}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

    # Check if binary is present
    if [ ! -x "$AGENT_BIN" ] && ! command -v "${RESUME_CMD[0]}" >/dev/null 2>&1; then
      echo -e "\033[1;31mWarning: Binary not found at $AGENT_BIN\033[0m"
      echo -e "${DIM}Check if package is installed or path is in ~/.local/bin or ~/.npm-global/bin${NC}"
    fi

    echo -ne "  ${BOLD}Select [1-4] or press Enter to launch: ${NC}"

    CHOICE=""
    if ! read -r -n 1 raw_key; then
      echo "Input closed; exiting pane."
      exit 0
    fi
    echo ""
    CHOICE="$raw_key"

    case "$CHOICE" in
      1|n|N|"")
        launch_agent "new"
        ;;
      2|r|R)
        launch_agent "resume"
        ;;
      3|s|S)
        launch_agent "shell"
        ;;
      4|l|L)
        launch_agent "login"
        ;;
      q|Q)
        echo -e "\n${DIM}Exiting pane.${NC}"
        exit 0
        ;;
      *)
        launch_agent "new"
        ;;
    esac
  fi

  echo ""
  echo -e "${BOLD}─────────────────────────────────────────────────────────────────────${NC}"
  echo -e "  ${DIM}${AGENT_TITLE} exited.${NC}"
  echo -ne "  ${BOLD}[Enter]${NC} Restart  ${BOLD}[s]${NC} Shell  ${BOLD}[m]${NC} Menu  ${BOLD}[q]${NC} Exit pane: "
  if ! read -r -n 1 post_choice; then
    echo "Input closed; exiting pane."
    exit 0
  fi
  echo ""

  case "$post_choice" in
    s|S)
      "${SHELL:-bash}"
      ;;
    m|M)
      MODE="prompt"
      ;;
    q|Q)
      exit 0
      ;;
    *)
      MODE="direct"
      ;;
  esac
done
