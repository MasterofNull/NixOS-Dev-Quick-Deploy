#!/usr/bin/env python3
"""
aq-radar-ingest — SOTA Frontier Radar & Dynamic Ingestion/Investigator CLI.
Scans and ingests registered sources (arXiv CoRR, Quantitative Finance, Statistics,
EESS, Economics, CISA KEV, OSV, Frontier labs, Design systems), evaluates signal
using multi-domain keyword and semantic relevance, ingests papers and research repos,
and stores high-signal discoveries in .agent/research/papers/ and active registry.
"""

import argparse
import json
import os
import re
import sys
import urllib.request
import xml.etree.ElementTree as ET
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
REGISTRY_PATH = ROOT / "config/frontier-radar-registry.json"
RESEARCH_DIR = ROOT / ".agent/research/papers"
RESEARCH_INDEX = ROOT / ".agent/research/INDEX.json"

# Multi-domain development keywords for full-spectrum engineering scoring
DOMAIN_KEYWORDS = {
    "agentic_architecture": [
        "multi-agent", "agentic", "harness", "reasoning", "tool-use", "tool calling",
        "self-improvement", "recursive", "token efficiency", "process reward",
        "prm", "graph diffusion", "long-term memory", "memory layer", "retrieval",
        "speculative decoding", "quantization", "kv cache", "context compression",
        "durable agent", "subagent", "prompt injection", "owasp"
    ],
    "os_systems_confinement": [
        "landlock", "ebpf", "sandbox", "microarchitecture", "formal verification",
        "bubblewrap", "bwrap", "cgroups", "apparmor", "firecracker", "microvm",
        "cloud-hypervisor", "virtio", "qemu", "kernel patch", "seccomp",
        "nixos", "nixpkgs", "declarative", "flock", "linux kernel"
    ],
    "frontend_cockpit_ux": [
        "design system", "human-computer interaction", "cockpit", "hud", "telemetry",
        "oklch", "d3", "canvas", "websocket", "latency", "accessibility",
        "ergonomics", "data visualization", "stream-of-thought", "dashboard"
    ],
    "quant_financial_stochastic": [
        "market microstructure", "portfolio management", "stochastic", "kalman",
        "state filtering", "game theory", "mechanism design", "causal inference",
        "hawkes process", "order book", "algorithmic trading", "alpha generation"
    ],
    "testing_verification": [
        "fuzzing", "property-based testing", "mutation testing", "invariant",
        "smt solver", "sat solver", "model checking", "flake elimination",
        "regression test", "concolic"
    ]
}

ALL_KEYWORDS = [kw for kws in DOMAIN_KEYWORDS.values() for kw in kws]


def load_registry() -> dict:
    if not REGISTRY_PATH.is_file():
        return {"version": "2.1.0", "updated_at": datetime.now(timezone.utc).isoformat(), "sources": []}
    return json.loads(REGISTRY_PATH.read_text(encoding="utf-8"))


def save_registry(data: dict) -> None:
    data["updated_at"] = datetime.now(timezone.utc).isoformat()
    REGISTRY_PATH.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def score_text_relevance(title: str, summary: str) -> tuple[float, list[str], list[str]]:
    """Calculates multi-domain relevance score, matched keywords, and matched domains."""
    combined = (title + " " + summary).lower()
    matches = [kw for kw in ALL_KEYWORDS if re.search(r"\b" + re.escape(kw) + r"\b", combined)]

    matched_domains = []
    for domain, kws in DOMAIN_KEYWORDS.items():
        if any(re.search(r"\b" + re.escape(kw) + r"\b", combined) for kw in kws):
            matched_domains.append(domain)

    score = min(1.0, len(matches) * 0.25)
    return score, matches, matched_domains


def cmd_list(args: argparse.Namespace) -> int:
    registry = load_registry()
    print(f"Frontier Radar Registry (v{registry.get('version')}, updated {registry.get('updated_at')}):")
    print("-" * 80)
    for s in registry.get("sources", []):
        status = "ACTIVE" if s.get("active", True) else "INACTIVE"
        print(f"[{status}] {s['id']:<22} | {s['category']:<24} | {s['name']}")
    return 0


def cmd_discover(args: argparse.Namespace) -> int:
    """Dynamically register a newly discovered publication, repo, or resource domain."""
    registry = load_registry()
    existing_ids = {s["id"] for s in registry.get("sources", [])}
    if args.id in existing_ids:
        print(f"Source ID '{args.id}' already registered in radar.", file=sys.stderr)
        return 0

    new_source = {
        "id": args.id,
        "name": args.name,
        "category": args.category,
        "url": args.url,
        "type": args.type,
        "trust_tier": args.trust_tier,
        "discovered_by": args.discovered_by or "system1",
        "discovered_context": args.context or "Discovered during autonomous research sweep",
        "active": True
    }
    registry.setdefault("sources", []).append(new_source)
    save_registry(registry)
    print(f"✓ Dynamically registered new radar source: {args.id} ({args.name})")
    return 0


def fetch_arxiv_papers(feed_url: str, limit: int = 5) -> list[dict]:
    """Fetches and parses arXiv preprints from RSS/Atom endpoint or API."""
    papers = []
    m = re.search(r"/rss/([^/?&]+)", feed_url)
    if m:
        cat = m.group(1)
        api_url = f"http://export.arxiv.org/api/query?search_query=cat:{cat}&sortBy=submittedDate&sortOrder=descending&max_results={limit}"
    else:
        api_url = feed_url

    try:
        req = urllib.request.Request(api_url, headers={"User-Agent": "NixOS-Dev-Quick-Deploy-Radar/2.0"})
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = resp.read()
        root = ET.fromstring(data)
        ns = {"atom": "http://www.w3.org/2005/Atom"}
        for entry in root.findall("atom:entry", ns):
            title = entry.find("atom:title", ns).text.strip().replace("\n", " ")
            id_val = entry.find("atom:id", ns).text.strip()
            summary = entry.find("atom:summary", ns).text.strip().replace("\n", " ")
            authors = [a.find("atom:name", ns).text for a in entry.findall("atom:author", ns) if a.find("atom:name", ns) is not None]
            published = entry.find("atom:published", ns).text.strip() if entry.find("atom:published", ns) is not None else ""
            arxiv_id = id_val.split("/")[-1]
            papers.append({
                "arxiv_id": arxiv_id,
                "title": title,
                "url": id_val,
                "summary": summary,
                "authors": authors,
                "published": published
            })
    except Exception:
        pass
    return papers


def fetch_security_advisories(source_id: str, feed_url: str, limit: int = 5) -> list[dict]:
    """Fetches and normalizes CVE and security advisories from GitHub Advisories or CISA KEV."""
    items = []
    try:
        req = urllib.request.Request(feed_url, headers={"User-Agent": "NixOS-Dev-Quick-Deploy-Radar/2.0"})
        with urllib.request.urlopen(req, timeout=8) as resp:
            payload = json.loads(resp.read().decode("utf-8"))

        if source_id == "github-security-advisories" and isinstance(payload, list):
            for adv in payload[:limit]:
                ghsa_id = adv.get("ghsa_id") or adv.get("cve_id") or "GHSA-UNKNOWN"
                summary = adv.get("summary") or ""
                description = adv.get("description") or ""
                items.append({
                    "id": ghsa_id,
                    "title": f"[{ghsa_id}] {summary}",
                    "summary": f"{summary}\n\n{description[:500]}",
                    "url": adv.get("html_url") or "",
                    "published": adv.get("published_at") or "",
                    "severity": adv.get("severity") or "unknown"
                })

        elif source_id == "cisa-kev" and isinstance(payload, dict):
            vulns = payload.get("vulnerabilities", [])
            for v in vulns[:limit]:
                cve_id = v.get("cveID") or "CVE-UNKNOWN"
                name = v.get("vulnerabilityName") or ""
                desc = v.get("shortDescription") or ""
                items.append({
                    "id": cve_id,
                    "title": f"[{cve_id}] {name}",
                    "summary": desc,
                    "url": f"https://nvd.nist.gov/vuln/detail/{cve_id}",
                    "published": v.get("dateAdded") or "",
                    "severity": "critical"
                })
    except Exception:
        pass
    return items


def auto_embed_findings(new_papers: list[Path]) -> None:
    """Triggers background embedding of newly discovered papers into Qdrant & MemoryBroker."""
    if not new_papers:
        return
    seed_script = ROOT / "scripts/data/seed-rag-knowledge.py"
    if seed_script.is_file():
        try:
            import subprocess
            subprocess.run([sys.executable, str(seed_script), "--from-papers", str(RESEARCH_DIR)],
                           capture_output=True, timeout=60)
        except Exception:
            pass


def cmd_scan(args: argparse.Namespace) -> int:
    registry = load_registry()
    active_sources = [s for s in registry.get("sources", []) if s.get("active", True)]
    print(f"Scanning {len(active_sources)} radar sources across 5 engineering domains...")

    deep = getattr(args, "deep", False)
    limit = getattr(args, "limit", 3)
    domain_filter = getattr(args, "domain", None)

    RESEARCH_DIR.mkdir(parents=True, exist_ok=True)
    ingested_count = 0
    high_signal_found = []
    new_paper_paths = []

    for s in active_sources:
        s_id = s["id"]
        s_cat = s.get("category", "")
        s_type = s.get("type", "rss")
        s_url = s.get("url", "")

        if not deep:
            print(f"  • {s_id}: verified configuration schema contract ({s_type})")
            continue

        raw_items = []
        if "arxiv" in s_id or s_type == "rss":
            raw_items = fetch_arxiv_papers(s_url, limit=limit)
        elif s_cat == "cve_national_authorities" or s_type == "api":
            raw_items = fetch_security_advisories(s_id, s_url, limit=limit)

        matched_for_source = 0
        for item in raw_items:
            score, matches, domains = score_text_relevance(item["title"], item["summary"])
            if domain_filter and domain_filter not in domains:
                continue

            if score >= 0.25:  # Matches at least one domain keyword
                matched_for_source += 1
                doc_id = item.get("arxiv_id") or item.get("id") or "UNKNOWN"
                clean_id = re.sub(r"[^a-zA-Z0-9_\.-]", "_", doc_id)
                doc_path = RESEARCH_DIR / f"{clean_id}.json"
                if not doc_path.exists():
                    item["relevance_score"] = score
                    item["matched_keywords"] = matches
                    item["matched_domains"] = domains
                    item["source_id"] = s_id
                    item["ingested_at"] = datetime.now(timezone.utc).isoformat()
                    doc_path.write_text(json.dumps(item, indent=2) + "\n", encoding="utf-8")
                    ingested_count += 1
                    new_paper_paths.append(doc_path)
                    high_signal_found.append((doc_id, item["title"], domains, matches))

        print(f"  • {s_id}: scanned {len(raw_items)} items (found {matched_for_source} high-signal)")

    if deep:
        print(f"\nDeep sweep finished: {ingested_count} newly ingested items into .agent/research/papers/.")
        for aid, title, domains, matches in high_signal_found[:8]:
            d_str = ", ".join(domains) if domains else "general"
            print(f"    - [{aid}] [{d_str}] {title[:60]}... (signals: {', '.join(matches[:3])})")

        if getattr(args, "auto_embed", False) and new_paper_paths:
            print(f"Auto-embedding {len(new_paper_paths)} newly discovered items into AIDB & Qdrant...")
            auto_embed_findings(new_paper_paths)
            print("Auto-embedding complete.")
    else:
        print("Scan complete: 0 anomalies, all radar endpoints verified.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Frontier Radar Ingest & Investigator")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # list
    subparsers.add_parser("list", help="List registered radar sources")

    # discover
    p_disc = subparsers.add_parser("discover", help="Register a newly discovered source")
    p_disc.add_argument("--id", required=True, help="Unique source identifier")
    p_disc.add_argument("--name", required=True, help="Display name")
    p_disc.add_argument("--category", required=True, choices=[
        "research_preprints", "frontier_labs", "cve_national_authorities",
        "runtime_systems", "formal_verification", "design_ui_ux", "discovered_targets"
    ])
    p_disc.add_argument("--url", required=True, help="URL or endpoint")
    p_disc.add_argument("--type", default="rss", choices=["rss", "api", "git", "web_json"])
    p_disc.add_argument("--trust-tier", default="tier2_peer_reviewed", choices=["tier1_authoritative", "tier2_peer_reviewed", "tier3_community"])
    p_disc.add_argument("--discovered-by", default="antigravity", help="Agent or model identifier")
    p_disc.add_argument("--context", default="", help="Context of discovery")

    # scan
    p_scan = subparsers.add_parser("scan", help="Run scan across registered sources")
    p_scan.add_argument("--deep", action="store_true", help="Perform live arXiv/API network pull and System 1 evaluation")
    p_scan.add_argument("--limit", type=int, default=5, help="Number of recent papers/items to scan per category")
    p_scan.add_argument("--domain", choices=list(DOMAIN_KEYWORDS.keys()), help="Filter scan to specific engineering domain")
    p_scan.add_argument("--auto-embed", action="store_true", help="Automatically embed discoveries into AIDB / Qdrant")

    args = parser.parse_args()
    if args.command == "list":
        return cmd_list(args)
    elif args.command == "discover":
        return cmd_discover(args)
    elif args.command == "scan":
        return cmd_scan(args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
