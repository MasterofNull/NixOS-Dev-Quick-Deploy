#!/usr/bin/env python3
"""aq-epoch-bump — owner-facing CLI for the C6 revocation-epoch authority
(Foundation C, C6-B1; default-OFF/INERT — nothing invokes this script
automatically).

SECURITY-CRITICAL, two-step OFFLINE-signing workflow:

  1. `aq-epoch-bump build ...` — constructs an UNSIGNED
     `aq.revocation-epoch-bump/1` request and prints the canonical
     domain-separated bytes the owner must sign OFFLINE with their Ed25519
     PRIVATE key. This command never reads, holds, or embeds any private
     key — it has none. The owner signs `bytes_to_sign_hex` with their own
     external tooling and sets the resulting hex signature as the
     request's `signature` field to produce a SIGNED document.
  2. `aq-epoch-bump submit --signed <file> ...` — submits a pre-signed
     document to `revocation_epoch.apply_bump`. Fails closed on any
     malformed/unverifiable/stale/replayed request. NEVER writes the
     epoch file directly — `apply_bump` is the only sanctioned mutation
     path, and this CLI has no other write mechanism.

Without `--socket`, `submit` calls `apply_bump` in-process against explicit
local paths (`--epoch-path`, `--ledger-dir`, `--owner-keys`) supplied by the
operator — this remains valid only for the offline/no-service fixture case
(no state directory is provisioned for it against a live authority; the
running authority's `--epoch-path`/`--ledger-dir` are its own `0700`
StateDirs the owner UID cannot write). No path is resolved from an
environment variable, and `--ledger-dir` has NO default at all in this mode.

  3. `aq-epoch-bump submit --signed <file> --socket <control.sock>` — the
     SANCTIONED owner-delivery path against a RUNNING authority (Foundation
     C, C6c). Delivers the pre-signed document to the running authority over
     the C6-S control-socket owner-bump path (`revocation_epoch_transport
     .send_request`, the identical client call `bump` makes) — reading NO
     private key and performing NO in-process `apply_bump`/ledger write (no
     owner-UID write to the authority's `0700` StateDirectory). The
     authority — not the caller — is the sole writer of its own epoch/ledger
     state. `bump` (below) is retained only for interactive one-shot use
     when an owner deliberately accepts host-key custody
     (age-passphrase-protected, `_load_owner_key`); `submit --signed
     --socket` is preferred because it never puts the owner private key on
     the harness host at all — the signature is produced fully offline.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import uuid
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

_HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(_HERE / "lib"))

import revocation_epoch as re_lib  # noqa: E402

_REPO_ROOT = _HERE.parent.parent
DEFAULT_EPOCH_PATH = _REPO_ROOT / "config" / "capability-lease-epoch"
DEFAULT_OWNER_KEYS_PATH = _REPO_ROOT / "config" / "aqos" / "c6-owner-public-keys.json"


def _iso(dt: datetime) -> str:
    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")


def cmd_build(args: argparse.Namespace) -> int:
    epoch_path = Path(args.epoch_path)
    if args.expected_epoch is not None:
        expected_epoch = args.expected_epoch
    else:
        try:
            expected_epoch = re_lib.read_epoch(epoch_path)
        except re_lib.EpochStoreError as exc:
            print(
                f"aq-epoch-bump: build: cannot resolve current epoch from "
                f"{epoch_path}: {exc.reason} ({exc.detail}) — pass "
                f"--expected-epoch explicitly if that is intentional",
                file=sys.stderr,
            )
            return 1

    now = datetime.now(timezone.utc)
    expires_at = now + timedelta(seconds=args.ttl_seconds)
    request: dict[str, Any] = {
        "schema_version": re_lib.BUMP_SCHEMA_VERSION,
        "request_id": args.request_id or f"epoch-bump::{uuid.uuid4()}",
        "idempotency_key": args.idempotency_key or f"epoch-bump::{uuid.uuid4()}",
        "issued_at": _iso(now),
        "expires_at": _iso(expires_at),
        "actor_key_id": args.actor_key_id,
        "expected_epoch": expected_epoch,
        "reason_code": args.reason_code,
        "scope": re_lib.SCOPE_FLEET,
        "signature": "",
    }
    bytes_to_sign = re_lib.canonical_bump_payload(request)
    out = {
        "request": request,
        "bytes_to_sign_hex": bytes_to_sign.hex(),
        "instructions": (
            "Sign bytes_to_sign_hex OFFLINE with the owner Ed25519 private "
            "key matching actor_key_id in "
            "config/aqos/c6-owner-public-keys.json. Set the resulting hex "
            "signature as request.signature, save the result as a JSON "
            "file, then run: aq-epoch-bump submit --signed <file> "
            "--ledger-dir <dir>"
        ),
    }
    text = json.dumps(out, indent=2, sort_keys=True)
    if args.out:
        Path(args.out).write_text(text + "\n", encoding="utf-8")
        print(f"aq-epoch-bump: wrote {args.out}", file=sys.stderr)
    else:
        print(text)
    return 0


def cmd_submit(args: argparse.Namespace) -> int:
    try:
        signed_doc = json.loads(Path(args.signed).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(
            f"aq-epoch-bump: submit: cannot read --signed {args.signed}: {exc}",
            file=sys.stderr,
        )
        return 1

    # Accept either the raw bump doc, or the {"request": {...}} wrapper
    # that `build` emits (with signature filled in by the owner).
    bump_doc = (
        signed_doc.get("request")
        if isinstance(signed_doc, dict) and "request" in signed_doc
        else signed_doc
    )

    if args.socket:
        # C6c — the sanctioned owner-delivery path: deliver the PRE-SIGNED
        # doc to the RUNNING authority over the C6-S control-socket
        # owner-bump path. No `_load_owner_key` (no host private key), no
        # `DurableReplayLedger`/`apply_bump` in-process call (no owner-UID
        # write to the authority's 0700 StateDirectory) — the authority
        # applies the verified bump itself. `revocation_epoch_transport` is
        # already importable (lib dir on sys.path, module top).
        import revocation_epoch_transport as _t  # noqa: E402  (lazy; sibling module)

        try:
            resp = _t.send_request(args.socket, {"bump": bump_doc})
        except Exception as exc:  # noqa: BLE001
            print(
                f"aq-epoch-bump: submit: delivery to {args.socket} failed: {exc} "
                "(in aq-revocation-epoch-clients?)",
                file=sys.stderr,
            )
            return 2
        if isinstance(resp, dict) and "frame" in resp:
            resp = resp["frame"]
        print(json.dumps(resp, indent=2, sort_keys=True))
        return 0 if isinstance(resp, dict) and resp.get("ok") else 2

    # Landed in-process path — byte-for-byte unchanged when --socket is
    # absent (offline/no-service fixture case only; unusable against a live
    # authority's 0700 StateDirs).
    if not args.ledger_dir:
        print(
            "aq-epoch-bump: submit: --ledger-dir is required when --socket is not given",
            file=sys.stderr,
        )
        return 1

    try:
        owner_keys = json.loads(Path(args.owner_keys).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(
            f"aq-epoch-bump: submit: cannot read --owner-keys {args.owner_keys}: {exc}",
            file=sys.stderr,
        )
        return 1

    ledger = re_lib.DurableReplayLedger(args.ledger_dir)
    result = re_lib.apply_bump(bump_doc, args.epoch_path, ledger, owner_keys)
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if result.get("ok") else 2


def _load_owner_key(key_file: str) -> bytes:
    """Load the owner Ed25519 private seed. If the file is age-encrypted, `age -d` prompts for the
    passphrase on the controlling TTY — that human passphrase is the factor an AUTONOMOUS AGENT cannot
    forge, so automating the workflow does NOT let an agent fire the kill-switch. A plaintext key is
    accepted only with a loud warning (it is agent-readable — not safe for the kill-switch key)."""
    import subprocess
    from pathlib import Path as _P
    raw = _P(key_file).read_bytes()
    if raw[:21] == b"age-encryption.org/v1" or b"BEGIN AGE ENCRYPTED FILE" in raw[:80]:
        if not sys.stdin.isatty() and not os.environ.get("AGE_PASSPHRASE"):
            raise RuntimeError(
                "age-encrypted owner key needs an interactive passphrase (no TTY) — this is the "
                "human-in-the-loop control: an autonomous agent cannot fire the C6 kill-switch")
        r = subprocess.run(["age", "-d", key_file], capture_output=True)
        if r.returncode != 0:
            raise RuntimeError("age decrypt failed (wrong passphrase or no TTY for the prompt)")
        data = r.stdout.strip()
    else:
        print("aq-epoch-bump: WARNING — plaintext owner key file. A fleet kill-switch key SHOULD be "
              "passphrase-encrypted so an autonomous agent cannot use it: `age -p -o owner.key.age owner.key`.",
              file=sys.stderr)
        data = raw.strip()
    try:
        seed = bytes.fromhex(data.decode("ascii").strip())
    except (ValueError, UnicodeDecodeError):
        seed = data if len(data) == 32 else b""
    if len(seed) != 32:
        raise RuntimeError("owner key must be a 64-hex or raw-32-byte Ed25519 seed")
    return seed


def cmd_bump(args: argparse.Namespace) -> int:
    """One-shot owner workflow: build -> sign (with the owner's passphrase-protected key) -> submit to the
    running authority over its UDS. Removes the copy-bytes/offline-sign/paste-back friction WITHOUT
    removing the human-in-the-loop control (the passphrase). The private key is read into memory, used,
    and never printed, logged, or written anywhere.

    DEPRECATED in favor of `submit --signed --socket` (C6c): this command reads and signs with a
    private key file ON THIS HOST (`_load_owner_key`, age-passphrase-protected) before submitting over
    the same control-socket path. `submit --signed --socket` delivers an ALREADY-signed document
    produced fully offline — the owner private key never touches the harness host at all. `bump` is
    retained only for interactive one-shot use when an owner deliberately accepts host-key custody; the
    age-passphrase guard above remains the control if it is still invoked."""
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
    epoch_note = args.expected_epoch
    now = datetime.now(timezone.utc)
    request: dict[str, Any] = {
        "schema_version": re_lib.BUMP_SCHEMA_VERSION,
        "request_id": args.request_id or f"epoch-bump::{uuid.uuid4()}",
        "idempotency_key": args.idempotency_key or f"epoch-bump::{uuid.uuid4()}",
        "issued_at": _iso(now),
        "expires_at": _iso(now + timedelta(seconds=args.ttl_seconds)),
        "actor_key_id": args.actor_key_id,
        "expected_epoch": args.expected_epoch,
        "reason_code": args.reason_code,
        "scope": re_lib.SCOPE_FLEET,
        "signature": "",
    }
    try:
        seed = _load_owner_key(args.key_file)
    except (RuntimeError, OSError) as exc:
        print(f"aq-epoch-bump: bump: {exc}", file=sys.stderr)
        return 1
    try:
        signature = Ed25519PrivateKey.from_private_bytes(seed).sign(re_lib.canonical_bump_payload(request))
    finally:
        del seed
    request["signature"] = signature.hex()
    # submit to the RUNNING authority over its UDS (the CLI's in-process submit targets the 0700
    # StateDirectory the owner cannot write; the authority applies the verified bump itself).
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts/ai/lib"))
    import revocation_epoch_transport as _t
    try:
        resp = _t.send_request(args.socket, {"bump": request})
    except Exception as exc:  # noqa: BLE001
        print(f"aq-epoch-bump: bump: submit to {args.socket} failed: {exc} (in aq-revocation-epoch-clients?)",
              file=sys.stderr)
        return 2
    if isinstance(resp, dict) and "frame" in resp:
        resp = resp["frame"]
    print(json.dumps(resp, indent=2, sort_keys=True))
    return 0 if isinstance(resp, dict) and resp.get("ok") else 2


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="aq-epoch-bump",
        description=(
            "C6 revocation-epoch authority CLI (offline-signed, "
            "default-OFF/INERT — not called by anything else yet)."
        ),
    )
    sub = p.add_subparsers(dest="command", required=True)

    p_build = sub.add_parser(
        "build", help="construct an unsigned bump request + print bytes to sign"
    )
    p_build.add_argument("--actor-key-id", required=True)
    p_build.add_argument("--reason-code", required=True, choices=re_lib.REASON_CODES)
    p_build.add_argument("--expected-epoch", type=int, default=None)
    p_build.add_argument("--epoch-path", default=str(DEFAULT_EPOCH_PATH))
    p_build.add_argument("--ttl-seconds", type=int, default=3600)
    p_build.add_argument("--request-id", default=None)
    p_build.add_argument("--idempotency-key", default=None)
    p_build.add_argument("--out", default=None, help="write result here instead of stdout")
    p_build.set_defaults(func=cmd_build)

    p_submit = sub.add_parser("submit", help="submit a pre-signed bump document")
    p_submit.add_argument("--signed", required=True, help="path to the signed request JSON")
    p_submit.add_argument(
        "--socket",
        default=None,
        help=(
            "C6c — the SANCTIONED owner-delivery path: deliver the pre-signed doc to the "
            "RUNNING authority over its control-socket owner-bump path (no host private "
            "key, no owner-UID 0700 write). When given, --epoch-path/--ledger-dir/"
            "--owner-keys are unused. When omitted, submit keeps its landed in-process "
            "behavior byte-for-byte (offline/no-service fixture case only)."
        ),
    )
    p_submit.add_argument("--epoch-path", default=str(DEFAULT_EPOCH_PATH))
    p_submit.add_argument(
        "--ledger-dir",
        default=None,
        help=(
            "durable replay-ledger directory — REQUIRED only when --socket is not given "
            "(no state directory is provisioned for the in-process path until C6-B2)"
        ),
    )
    p_submit.add_argument("--owner-keys", default=str(DEFAULT_OWNER_KEYS_PATH))
    p_submit.set_defaults(func=cmd_submit)

    # One-shot owner workflow: build -> sign (passphrase-protected key) -> submit over the authority UDS.
    # DEPRECATED in favor of `submit --signed --socket` (C6c) — see cmd_bump's docstring: this path
    # reads a host-custodied private key; `submit --signed --socket` never puts a private key on the
    # harness host. Retained for interactive one-shot use when an owner accepts that trade-off.
    p_bump = sub.add_parser(
        "bump",
        help=(
            "DEPRECATED — one-shot: build+sign+submit to the running authority using a "
            "host-custodied key (owner-run). Prefer `submit --signed --socket`, which never "
            "reads a private key on this host."
        ),
    )
    p_bump.add_argument("--actor-key-id", required=True)
    p_bump.add_argument("--reason-code", required=True, choices=re_lib.REASON_CODES)
    p_bump.add_argument("--expected-epoch", type=int, required=True, help="the current epoch this bump advances from")
    p_bump.add_argument("--key-file", required=True,
                        help="owner Ed25519 private key — an age-passphrase-encrypted file (recommended; the "
                             "passphrase is the human-in-the-loop the agent cannot forge) or plaintext hex (warned)")
    p_bump.add_argument("--socket", default="/run/aq-revocation-epoch-authority/control.sock",
                        help="authority control UDS (must be a member of aq-revocation-epoch-clients)")
    p_bump.add_argument("--ttl-seconds", type=int, default=3600)
    p_bump.add_argument("--request-id", default=None)
    p_bump.add_argument("--idempotency-key", default=None)
    p_bump.set_defaults(func=cmd_bump)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
