#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
# shellcheck source=../../config/service-endpoints.sh
# shellcheck disable=SC1091
source "${REPO_ROOT}/config/service-endpoints.sh"

# Default session directories (repeatable via --session-dir)
declare -a SESSION_DIRS=("${HOME}/.continue/sessions")
DRY_RUN=0
SINCE_HOURS=0  # 0 = all sessions (no time filter)
MAX_SESSIONS=10

while [[ $# -gt 0 ]]; do
  case "$1" in
    --session-dir)
      SESSION_DIRS+=("$2")
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --since-hours)
      SINCE_HOURS="$2"
      shift 2
      ;;
    --max-sessions)
      MAX_SESSIONS="$2"
      shift 2
      ;;
    *)
      printf 'usage: aq-crystallize [--session-dir PATH]... [--since-hours N] [--max-sessions N] [--dry-run]\n' >&2
      exit 2
      ;;
  esac
done

# Collect all session files from all directories
declare -a all_sessions=()
for dir in "${SESSION_DIRS[@]}"; do
  if [[ ! -d "${dir}" ]]; then
    continue
  fi
  # Find both *.json and *.jsonl files
  while IFS= read -r session_path; do
    [[ -n "${session_path}" ]] && all_sessions+=("${session_path}")
  done < <(find "${dir}" -type f \( -name '*.json' -o -name '*.jsonl' \) 2>/dev/null)
done

# Filter by mtime if --since-hours given
if [[ "${SINCE_HOURS}" -gt 0 ]] 2>/dev/null; then
  declare -a filtered_sessions=()
  for session_path in "${all_sessions[@]}"; do
    mtime_min=$(find "${session_path}" -type f -mmin "-$(( SINCE_HOURS * 60 ))" 2>/dev/null | wc -l)
    [[ "${mtime_min}" -gt 0 ]] && filtered_sessions+=("${session_path}")
  done
  all_sessions=("${filtered_sessions[@]}")
fi

# Sort by mtime (newest first) and limit to MAX_SESSIONS
declare -a sorted_sessions=()
while IFS= read -r session_path; do
  [[ -n "${session_path}" ]] && sorted_sessions+=("${session_path}")
done < <(printf '%s\n' "${all_sessions[@]}" | xargs -I{} stat -c '%Y %n' {} 2>/dev/null | sort -rn | cut -d' ' -f2- | head -n "${MAX_SESSIONS}")

# Process each session
for session_path in "${sorted_sessions[@]}"; do
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    printf '%s\n' "${session_path}"
    continue
  fi

  # Build JSON payload safely with Python
  _payload=$(python3 -c "import json, sys; print(json.dumps({'session_path': sys.argv[1]}))" "${session_path}" 2>/dev/null || printf '{}')

  # Add API key header if HYBRID_API_KEY_FILE is readable
  declare -a curl_args=(-sf -X POST "${HYBRID_COORDINATOR_URL}/memory/crystalline/run" -H 'Content-Type: application/json')
  if [[ -r "${HYBRID_API_KEY_FILE:-}" ]]; then
    api_key=$(<"${HYBRID_API_KEY_FILE}")
    curl_args+=(-H "X-API-Key: ${api_key}")
  fi
  curl_args+=(-d "${_payload}")

  curl "${curl_args[@]}" >/dev/null 2>&1 \
    || printf 'WARN: crystallize skipped %s (coordinator unavailable)\n' "${session_path}" >&2
done
