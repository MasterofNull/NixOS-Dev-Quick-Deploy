#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
# shellcheck source=../../config/service-endpoints.sh
# shellcheck disable=SC1091
source "${REPO_ROOT}/config/service-endpoints.sh"

# Default session directories (repeatable via --session-dir)
declare -a SESSION_DIRS=("${HOME}/.continue/sessions")
DRY_RUN=0
SINCE_HOURS=0  # 0 = all sessions (no time filter)
MAX_SESSIONS=10

while [[ $# -gt 0 ]]; do
  case "$1" in
    --session-dir)
      SESSION_DIRS+=("$2")
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --since-hours)
      SINCE_HOURS="$2"
      shift 2
      ;;
    --max-sessions)
      MAX_SESSIONS="$2"
      shift 2
      ;;
    *)
      printf 'usage: aq-crystallize [--session-dir PATH]... [--since-hours N] [--max-sessions N] [--dry-run]\n' >&2
      exit 2
      ;;
  esac
done

# Collect, filter, sort all session files in a single Python pass
# (avoids 650+ subprocess forks for per-file stat checks)
read -r -d '' _PYTHON_DISCOVERY << 'PYEOF' || true
import os
import pathlib
import sys
from datetime import datetime, timedelta, timezone

session_dirs = sys.argv[1:]
since_minutes = int(os.environ.get("SINCE_MINUTES", 0))
max_sessions = int(os.environ.get("MAX_SESSIONS", 10))

cutoff_time = None
if since_minutes > 0:
    cutoff_time = (datetime.now(timezone.utc) - timedelta(minutes=since_minutes)).timestamp()

candidates = []
for session_dir in session_dirs:
    p = pathlib.Path(session_dir)
    if not p.is_dir():
        continue

    # Find *.json and *.jsonl, excluding metadata and index files
    is_projects_dir = "projects" in p.parts

    for item in p.rglob("*"):
        if not item.is_file():
            continue

        # Skip subagent transcripts (parent session already has results)
        if "/subagents/" in str(item):
            continue

        name = item.name
        # Skip metadata and index files
        if name.endswith(".meta.json") or "index" in name:
            continue

        # In projects/ dirs: only accept *.jsonl (Codex) and *.json (Continue, but not metadata)
        if is_projects_dir:
            if not (name.endswith(".jsonl") or (name.endswith(".json") and not name.endswith(".meta.json"))):
                continue
        else:
            # For other dirs: accept *.json and *.jsonl
            if not (name.endswith(".json") or name.endswith(".jsonl")):
                continue

        # Check mtime filter
        mtime = item.stat().st_mtime
        if cutoff_time and mtime < cutoff_time:
            continue

        candidates.append((mtime, str(item)))

# Sort by mtime (newest first), take first MAX_SESSIONS
candidates.sort(reverse=True, key=lambda x: x[0])
for _, path in candidates[:max_sessions]:
    print(path)
PYEOF

export SINCE_MINUTES=$(( SINCE_HOURS * 60 ))
export MAX_SESSIONS

declare -a sorted_sessions=()
while IFS= read -r session_path; do
  [[ -n "${session_path}" ]] && sorted_sessions+=("${session_path}")
done < <(python3 -c "${_PYTHON_DISCOVERY}" "${SESSION_DIRS[@]}")

# Process each session
for session_path in "${sorted_sessions[@]}"; do
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    printf '%s\n' "${session_path}"
    continue
  fi

  # Build JSON payload safely with Python
  _payload=$(python3 -c "import json, sys; print(json.dumps({'session_path': sys.argv[1]}))" "${session_path}" 2>/dev/null || printf '{}')

  # Add API key header if HYBRID_API_KEY_FILE is readable
  declare -a curl_args=(-sf -X POST "${HYBRID_COORDINATOR_URL}/memory/crystalline/run" -H 'Content-Type: application/json')
  if [[ -r "${HYBRID_API_KEY_FILE:-}" ]]; then
    api_key=$(<"${HYBRID_API_KEY_FILE}")
    curl_args+=(-H "X-API-Key: ${api_key}")
  fi
  curl_args+=(-d "${_payload}")

  curl "${curl_args[@]}" >/dev/null 2>&1 \
    || printf 'WARN: crystallize skipped %s (coordinator unavailable)\n' "${session_path}" >&2
done
