#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
# shellcheck source=../../config/service-endpoints.sh
# shellcheck disable=SC1091
source "${REPO_ROOT}/config/service-endpoints.sh"

# Default session directories (repeatable via --session-dir)
declare -a SESSION_DIRS=("${HOME}/.continue/sessions")
DRY_RUN=0
SINCE_HOURS=0  # 0 = all sessions (no time filter)
MAX_SESSIONS=10

while [[ $# -gt 0 ]]; do
  case "$1" in
    --session-dir)
      SESSION_DIRS+=("$2")
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --since-hours)
      SINCE_HOURS="$2"
      shift 2
      ;;
    --max-sessions)
      MAX_SESSIONS="$2"
      shift 2
      ;;
    *)
      printf 'usage: aq-crystallize [--session-dir PATH]... [--since-hours N] [--max-sessions N] [--dry-run]\n' >&2
      exit 2
      ;;
  esac
done

# Collect, filter, sort all session files in a single Python pass
# (avoids 650+ subprocess forks for per-file stat checks)
read -r -d '' _PYTHON_DISCOVERY << 'PYEOF' || true
import os
import pathlib
import sys
from datetime import datetime, timedelta, timezone

session_dirs = sys.argv[1:]
since_minutes = int(os.environ.get("SINCE_MINUTES", 0))
max_sessions = int(os.environ.get("MAX_SESSIONS", 10))

cutoff_time = None
if since_minutes > 0:
    cutoff_time = (datetime.now(timezone.utc) - timedelta(minutes=since_minutes)).timestamp()

candidates = []
for session_dir in session_dirs:
    p = pathlib.Path(session_dir)
    if not p.is_dir():
        continue

    # Find *.json and *.jsonl, excluding metadata and index files
    is_projects_dir = "projects" in p.parts

    for item in p.rglob("*"):
        if not item.is_file():
            continue

        # Skip subagent transcripts (parent session already has results)
        if "/subagents/" in str(item):
            continue

        name = item.name
        # Skip metadata and index files
        if name.endswith(".meta.json") or "index" in name:
            continue

        # In projects/ dirs: only accept *.jsonl (Codex) and *.json (Continue, but not metadata)
        if is_projects_dir:
            if not (name.endswith(".jsonl") or (name.endswith(".json") and not name.endswith(".meta.json"))):
                continue
        else:
            # For other dirs: accept *.json and *.jsonl
            if not (name.endswith(".json") or name.endswith(".jsonl")):
                continue

        # Check mtime filter
        mtime = item.stat().st_mtime
        if cutoff_time and mtime < cutoff_time:
            continue

        candidates.append((mtime, str(item)))

# Sort by mtime (newest first), take first MAX_SESSIONS
candidates.sort(reverse=True, key=lambda x: x[0])
for _, path in candidates[:max_sessions]:
    print(path)
PYEOF

export SINCE_MINUTES=$(( SINCE_HOURS * 60 ))
export MAX_SESSIONS

declare -a sorted_sessions=()
while IFS= read -r session_path; do
  [[ -n "${session_path}" ]] && sorted_sessions+=("${session_path}")
done < <(python3 -c "${_PYTHON_DISCOVERY}" "${SESSION_DIRS[@]}")

# Process each session (client-side extraction + server-side redaction)
read -r -d '' _PYTHON_EXTRACT << 'PYEOF' || true
import hashlib
import json
import sys
from pathlib import Path

# Add module path for session_transcripts
sys.path.insert(0, "/home/hyperd/Documents/NixOS-Dev-Quick-Deploy/ai-stack/mcp-servers/hybrid-coordinator")

from session_transcripts import extract_history

session_path = sys.argv[1]
path = Path(session_path)

if not path.is_file():
    sys.exit(1)

try:
    raw = path.read_bytes()
except (PermissionError, OSError):
    sys.exit(1)

# Compute sha256 of raw bytes
session_hash = hashlib.sha256(raw).hexdigest()

# Extract history
history = extract_history(raw)

# Skip if <4 messages
if len(history) < 4:
    sys.exit(2)  # Skip status

# Output JSON: {"history": [...], "session_hash": str, "session_path": str}
payload = {
    "history": history,
    "session_hash": session_hash,
    "session_path": session_path,
}
print(json.dumps(payload))
PYEOF

selected=0
posted=0
skipped=0

for session_path in "${sorted_sessions[@]}"; do
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    printf '%s\n' "${session_path}"
    selected=$((selected + 1))
    continue
  fi

  # Extract history client-side
  _payload=$(python3 -c "${_PYTHON_EXTRACT}" "${session_path}" 2>/dev/null)
  exit_code=$?

  if [[ $exit_code -eq 1 ]]; then
    # File error (unreadable, etc.)
    skipped=$((skipped + 1))
    continue
  fi
  if [[ $exit_code -eq 2 ]]; then
    # History too short
    skipped=$((skipped + 1))
    continue
  fi

  if [[ -z "${_payload}" ]]; then
    skipped=$((skipped + 1))
    continue
  fi

  selected=$((selected + 1))

  # Add API key header if HYBRID_API_KEY_FILE is readable
  declare -a curl_args=(-sf -X POST "${HYBRID_COORDINATOR_URL}/memory/crystalline/run" -H 'Content-Type: application/json')
  if [[ -r "${HYBRID_API_KEY_FILE:-}" ]]; then
    api_key=$(<"${HYBRID_API_KEY_FILE}")
    curl_args+=(-H "X-API-Key: ${api_key}")
  fi
  curl_args+=(-d "${_payload}")

  if curl "${curl_args[@]}" >/dev/null 2>&1; then
    posted=$((posted + 1))
  else
    skipped=$((skipped + 1))
  fi
done

printf 'selected=%d posted=%d skipped=%d\n' "$selected" "$posted" "$skipped"
