class CoordinatorSession:
    """Manages conversational state, active route, and agent fleet."""

    def __init__(self):
        self.active_route = "local"
        self.messages: List[Dict[str, str]] = []
        self.total_prompts = 0
        self.total_tokens_in = 0
        self.total_tokens_out = 0
        self.session_start = time.time()
        self.system_prompt = (
            "You are the AQ-OS Agentic Coordinator for NixOS-Dev-Quick-Deploy. "
            "You coordinate tasks, write precise code and architectures, inspect system telemetry, "
            "and assist the operator across local models (Qwen-35B) and flagship remote lanes."
        )

    def get_route_info(self) -> Dict[str, Any]:
        """Return display metadata for current route."""
        return ROUTES.get(self.active_route, ROUTES["local"])

    def set_route(self, new_route: str) -> bool:
        """Switch route."""
        new_route = new_route.lower().strip()
        if new_route in ("local", "qwen", "hybrid"):
            self.active_route = "local"
            return True
        elif new_route in ("claude", "anthropic", "fable"):
            self.active_route = "claude"
            return True
        elif new_route in ("codex", "openai", "gpt"):
            self.active_route = "codex"
            return True
        elif new_route in ("gemini", "antigravity", "google"):
            self.active_route = "gemini"
            return True
        return False


