def list_fleet():
    """Display current sub-agent fleet."""
    if not REGISTRY_FILE.is_file():
        console.print("[dim]No delegations found in registry.[/dim]")
        return
    try:
        lines = REGISTRY_FILE.read_text(encoding="utf-8", errors="replace").splitlines()
        records = [json.loads(l) for l in reversed(lines[-15:]) if l.strip()]
        
        table = Table(title="Sub-Agent Fleet Tasks", box=None, padding=(0, 1))
        table.add_column("Task ID", style="bold cyan", width=18)
        table.add_column("Lane/Role", width=16)
        table.add_column("Status", width=11)
        table.add_column("Tokens", width=10)
        table.add_column("Description", style="dim white")

        for r in records:
            tid = r.get("id", "unknown")
            short_id = tid if len(tid) <= 18 else tid[:17] + "…"
            status = r.get("status", "unknown").lower()
            badge = "[bold green]RUNNING[/bold green]" if status in ("running", "active") else (
                "[cyan]DONE[/cyan]" if status == "done" else f"[dim]{status}[/dim]"
            )
            tin = r.get("tokens_in", 0) or 0
            tout = r.get("tokens_out", 0) or 0
            tok_str = f"{tin}+{tout}" if (tin or tout) else "—"
            desc = r.get("description", "").split("\n\n[Auto-suggested")[0].replace("\n", " ").strip()
            if len(desc) > 40:
                desc = desc[:38] + "…"
            table.add_row(short_id, f"{r.get('agent', '')}/{r.get('role', '')}", badge, tok_str, desc)
        console.print(table)
    except Exception as e:
        console.print(f"[red]Error reading fleet registry: {e}[/red]")


def steer_agent(task_id: str, message: str, cancel: bool = False):
    """Send intervention message to agent via control channel."""
    cmd = [str(REPO_ROOT / "scripts" / "ai" / "aq-agent-send"), task_id, message]
    if cancel:
        cmd.append("--cancel")
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, check=False)
        if res.returncode == 0:
            console.print(f"[bold green]✓ Intervention sent to {task_id}:[/bold green] {message}")
        else:
            console.print(f"[bold red]✗ Failed to send intervention: {res.stderr.strip() or res.stdout.strip()}[/bold red]")
    except Exception as e:
        console.print(f"[red]Execution error: {e}[/red]")


def dispatch_subagent(lane: str, prompt: str, role: str = "implementer"):
    """Spawn background sub-agent using delegate scripts."""
    scripts = {
        "local": REPO_ROOT / "scripts" / "ai" / "delegate-to-local",
        "claude": REPO_ROOT / "scripts" / "ai" / "delegate-to-claude",
        "codex": REPO_ROOT / "scripts" / "ai" / "delegate-to-codex",
        "gemini": REPO_ROOT / "scripts" / "ai" / "delegate-to-antigravity",
    }
    script = scripts.get(lane.lower(), scripts["local"])
    if not script.is_file():
        console.print(f"[red]Error: Dispatch script not found: {script}[/red]")
        return

    cmd = [str(script), "--role", role, "--prompt", prompt]
    console.print(f"[bold cyan]⚡ Spawning background sub-agent ({lane}/{role})...[/bold cyan]")
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        console.print(f"[bold green]✓ Sub-agent process launched (PID {proc.pid}).[/bold green]")
        console.print("  Watch live stream in Fleet Matrix pane or type [bold cyan]/fleet[/bold cyan].")
    except Exception as e:
        console.print(f"[bold red]Failed to dispatch sub-agent: {e}[/bold red]")


async def stream_chat(prompt: str, route_key: Optional[str] = None):
    """Send prompt to active backend (or route_key override) and stream response."""
    if route_key and route_key in ROUTES:
        route = ROUTES[route_key]
    else:
        route = session.get_route_info()

    messages = [
        {"role": "system", "content": session.system_prompt},
    ] + session.messages + [{"role": "user", "content": prompt}]

    payload = {
        "model": route["model"],
        "messages": messages,
        "temperature": 0.3,
        "stream": True,
    }

    t0 = time.monotonic()
    collected_tokens = []
    
    console.print(f"\n[bold {route['color']}]{route['label']}[/bold {route['color']}] ───")

    try:
        async with httpx.AsyncClient(timeout=120.0) as client:
            async with client.stream("POST", route["url"], json=payload) as response:
                if response.status_code != 200:
                    body = await response.aread()
                    console.print(f"[bold red]API Error {response.status_code}: {body.decode('utf-8', errors='replace')}[/bold red]")
                    return

                async for line in response.aiter_lines():
                    if not line:
                        continue
                    if line.startswith("data: "):
                        data_str = line[6:].strip()
                        if data_str == "[DONE]":
                            break
                        try:
                            chunk = json.loads(data_str)
                            choices = chunk.get("choices") or []
                            if choices:
                                delta = choices[0].get("delta", {}).get("content", "")
                                if delta:
                                    sys.stdout.write(delta)
                                    sys.stdout.flush()
                                    collected_tokens.append(delta)
                        except json.JSONDecodeError:
                            continue

        print()  # Newline after stream
        full_text = "".join(collected_tokens)
        elapsed = time.monotonic() - t0
        tok_count = len(collected_tokens)
        tok_per_sec = (tok_count / elapsed) if elapsed > 0 else 0.0

        session.messages.append({"role": "user", "content": prompt})
        session.messages.append({"role": "assistant", "content": full_text})
        session.total_prompts += 1
        session.total_tokens_out += tok_count

        console.print(f"[dim]── [{elapsed:.2f}s · ~{tok_count} tokens · {tok_per_sec:.1f} tok/s · {route['backend']}][/dim]\n")

    except httpx.ConnectError:
        console.print(f"[bold red]Connection error to {route['url']}. Ensure AI services are running.[/bold red]")
    except Exception as e:
        console.print(f"[bold red]Streaming error: {e}[/bold red]")


async def broadcast_chat(prompt: str):
    """Broadcast prompt to all 4 models and stream responses sequentially with telemetry benchmark."""
    all_lanes = ["local", "claude", "codex", "gemini"]
    console.print(Panel(
        f"[bold #00d9ff]󰚩 MULTI-AGENT BROADCAST PROMPT[/bold #00d9ff]\n"
        f"[white]{prompt}[/white]\n"
        f"[dim]Broadcasting across all 4 agent lanes (Local, Claude, Codex, Gemini)...[/dim]",
        border_style="#00d9ff",
        padding=(0, 1),
    ))
    benchmarks = []
    for lane in all_lanes:
        t0 = time.monotonic()
        await stream_chat(prompt, route_key=lane)
        elapsed = time.monotonic() - t0
        benchmarks.append((lane, elapsed))

    # Benchmark summary table
    table = Table(title="Multi-Agent Benchmark Comparison", box=None, padding=(0, 1))
    table.add_column("Agent Lane", style="bold cyan")
    table.add_column("Latency", style="white")
    table.add_column("Backend", style="dim")
    for lane, elapsed in benchmarks:
        r = ROUTES[lane]
        table.add_row(f"[{r['color']}]{r['label']}[/{r['color']}]", f"{elapsed:.2f}s", r["backend"])
    console.print(Panel(table, border_style="cyan", padding=(0, 1)))



async def main():
    parser = argparse.ArgumentParser(description="AQ-OS Agentic Coordinator Console")
    parser.add_argument("--route", default="local", help="Initial route: local, claude, codex, gemini")
    parser.add_argument("--prompt", help="Execute single prompt and exit")
    args = parser.parse_args()

    session.set_route(args.route)

    if args.prompt:
        await stream_chat(args.prompt)
        return

    render_banner()

    pt_session = PromptSession(
        history=FileHistory(str(HISTORY_FILE)),
        completer=command_completer,
        style=PT_STYLE,
    )

    while True:
        try:
            route_info = session.get_route_info()
            prompt_html = HTML(f"<prompt>aq</prompt> <lane>[{session.active_route}]</lane> ❯ ")
            user_input = await pt_session.prompt_async(prompt_html)
            text = user_input.strip()
        except (KeyboardInterrupt, EOFError):
            console.print("\n[dim]Exiting Coordinator REPL. Goodbye![/dim]")
            break

        if not text:
            continue

        # Command handling
        if text.startswith("/"):
            parts = text.split(" ", 2)
            cmd = parts[0].lower()

            if cmd in ("/exit", "/quit"):
                console.print("[dim]Goodbye![/dim]")
                break
            elif cmd == "/help":
                show_help()
            elif cmd == "/clear":
                os.system("clear")
                render_banner()
            elif cmd in ("/model", "/route"):
                if len(parts) > 1 and session.set_route(parts[1]):
                    ri = session.get_route_info()
                    console.print(f"[bold green]Switched route to:[/bold green] [{ri['color']}]{ri['label']}[/{ri['color']}]")
                else:
                    console.print(f"Usage: {cmd} <local|claude|codex|gemini>")
            elif cmd == "/fleet":
                list_fleet()
            elif cmd == "/status":
                subprocess.run([str(REPO_ROOT / "scripts" / "ai" / "aq-cockpit-monitor"), "--once"])
            elif cmd == "/pulse":
                subprocess.run(["tail", "-n", "8", str(PULSE_LOG)])
            elif cmd == "/steer":
                if len(parts) >= 3:
                    steer_agent(parts[1], parts[2], cancel=False)
                else:
                    console.print("Usage: /steer <task_id> \"<message>\"")
            elif cmd == "/kill":
                if len(parts) >= 2:
                    steer_agent(parts[1], "Cancelled by operator", cancel=True)
                else:
                    console.print("Usage: /kill <task_id>")
            elif cmd == "/inspect":
                if len(parts) >= 2:
                    tid = parts[1]
                    out = REPO_ROOT / ".agents" / "delegation" / "outputs" / f"{tid}.log"
                    if out.is_file():
                        console.print(f"[bold cyan]Log for {tid}:[/bold cyan]")
                        console.print(out.read_text(encoding="utf-8", errors="replace")[-2000:])
                    else:
                        console.print(f"[red]Log file not found for task {tid}[/red]")
                else:
                    console.print("Usage: /inspect <task_id>")
            elif cmd == "/dispatch":
                if len(parts) >= 3:
                    lane = parts[1]
                    prompt_text = parts[2]
                    dispatch_subagent(lane, prompt_text)
                elif len(parts) == 2:
                    dispatch_subagent("local", parts[1])
                else:
                    console.print("Usage: /dispatch [lane] \"<prompt>\"")
            elif cmd in ("/tools", "/toolchain"):
                subprocess.run([sys.executable, str(REPO_ROOT / "scripts" / "ai" / "aq-capabilities")])
            elif cmd in ("/caps", "/capabilities"):
                subprocess.run([sys.executable, str(REPO_ROOT / "scripts" / "ai" / "aq-capabilities"), "overview"])
            elif cmd in ("/plan", "/tracker", "/pm"):
                subprocess.run([sys.executable, str(REPO_ROOT / "scripts" / "ai" / "aq-pm-tracker"), "--all"])
            else:
                console.print(f"[yellow]Unknown command '{cmd}'. Type /help for available commands.[/yellow]")
            continue

        # Targeted agent prompting (@local, @claude, @codex, @gemini, @all)
        if text.startswith("@"):
            parts = text.split(" ", 1)
            target = parts[0][1:].lower()
            query = parts[1].strip() if len(parts) > 1 else ""

            if not query:
                console.print(f"[yellow]Usage: @{target} <prompt>[/yellow]")
                continue

            if target in ("all", "broadcast"):
                await broadcast_chat(query)
                continue
            elif target in ("local", "qwen", "hybrid"):
                await stream_chat(query, route_key="local")
                continue
            elif target in ("claude", "anthropic", "fable"):
                await stream_chat(query, route_key="claude")
                continue
            elif target in ("codex", "openai", "gpt"):
                await stream_chat(query, route_key="codex")
                continue
            elif target in ("gemini", "antigravity", "google"):
                await stream_chat(query, route_key="gemini")
                continue
            else:
                console.print(f"[yellow]Unknown agent '@{target}'. Supported: @all, @local, @claude, @codex, @gemini[/yellow]")
                continue

        # Normal prompt stream
        await stream_chat(text)


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
