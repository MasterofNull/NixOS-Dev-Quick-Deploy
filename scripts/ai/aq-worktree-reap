#!/usr/bin/env python3
"""
aq-worktree-reap

Automatically remove delegate worktrees and branches with zero changes.
Optionally clean up orphaned lean-ctx graphs.

Default is DRY RUN (prints JSON plan); use --apply to perform removal.

Usage:
    aq-worktree-reap [--apply] [--repo PATH] [--min-age-hours N] [--json] [--graphs]
    aq-worktree-reap --help
"""

from __future__ import annotations
try:  # aq-usage-hook
    import importlib.util as _aqu, os as _aqo
    _aqs = _aqu.spec_from_file_location("aq_usage", _aqo.path.join(_aqo.path.dirname(_aqo.path.realpath(__file__)), "lib", "aq_usage.py"))
    _aqm = _aqu.module_from_spec(_aqs); _aqs.loader.exec_module(_aqm); _aqm.record(__file__, __name__)
except Exception:
