#!/usr/bin/env bash
# delegate-to-claude — Delegate a task to Claude CLI (headless, persistent)
#
# Usage:
#   delegate-to-claude --prompt "implement X in file Y"  # delegate in background
#   delegate-to-claude --prompt "..." --wait             # block until done
#   delegate-to-claude --check <task-id>                 # read output
#   delegate-to-claude --list                            # list all tasks
#   delegate-to-claude --status <task-id>                # check status
#
# Options:
#   --prompt TEXT      Task prompt to send to Claude
#   --prompt-file FILE Read prompt from file
#   --role ROLE        Role: plan|implement|review|research  [default: implement]
#   --model-tier TIER  Resolve Anthropic tier via config/model-coordinator.json
#                      flagship|flagship_fallback|balanced|fast|creative
#   --wait             Block until task completes (default: background)
#   --force-budget     Bypass the daily dispatch cap and parallel-slot limit once
#   --budget-check-only  Check cap + slot availability for --role, then exit (0 ok, 3 refused)
#   --check ID         Print output of a completed task
#   --status ID        Show status of a task
#   --list             List all registered tasks
#   --help             Show this help
#
# Claude CLI invoked as: claude -p "prompt" --output-format text
# Admission control (exit 3 when refused; --force-budget overrides):
#   DELEGATE_CLAUDE_DAILY_DISPATCH_CAP  dispatches/day (UTC) [default: 40]
#   DELEGATE_CLAUDE_MAX_PARALLEL        simultaneous delegates (flock slots) [default: 2]
#   One slot (slot-0) is reserved for --role review when MAX_PARALLEL >= 2.
# REPO_ROOT is resolved from BASH_SOURCE — no external env var required.

set -euo pipefail

# Guard: sourcing this script directly (e.g. in nohup subshell) should not
# re-execute the arg parser.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
DELEGATION_DIR="$REPO_ROOT/.agents/delegation"
OUTPUTS_DIR="$DELEGATION_DIR/outputs"
REGISTRY="$DELEGATION_DIR/registry.jsonl"
CLAUDE_BIN="${CLAUDE_BIN:-$HOME/.local/bin/claude}"
MODEL_COORDINATOR="$REPO_ROOT/config/model-coordinator.json"

# Phase 56.1/56.7 — delegation audit bridge
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/lib/audit-write.sh" 2>/dev/null || true
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/lib/harness-grounding.sh" 2>/dev/null || true

# ── helpers ──────────────────────────────────────────────────────────────────

die()  { echo "ERROR: $*" >&2; exit 1; }
die_budget() { echo "[delegate-to-claude] $*" >&2; exit 3; }
info() { echo "[delegate-to-claude] $*"; }

require_claude() {
    [[ -x "$CLAUDE_BIN" ]] || die "Claude CLI not found at $CLAUDE_BIN
  Or set: export CLAUDE_BIN=/path/to/claude"
}

ensure_dirs() {
    mkdir -p "$OUTPUTS_DIR"
    touch "$REGISTRY"
}

task_id() {
    # Use subshell with pipefail disabled — tr exits SIGPIPE when head closes
    # the pipe, which with set -o pipefail would trigger the fallback.
    local rand; rand="$(set +o pipefail; tr -dc 'a-z0-9' </dev/urandom 2>/dev/null | head -c6)" || rand="xxxxxx"
    echo "claude-$(date +%Y%m%d-%H%M%S)-${rand}"
}

resolve_model_tier() {
    local tier="$1"
    python3 - "$MODEL_COORDINATOR" "$tier" <<'PYEOF'
import json
import re
import sys
from pathlib import Path

path, tier = Path(sys.argv[1]), sys.argv[2]
allowed = {"flagship", "flagship_fallback", "balanced", "fast", "creative"}
if tier not in allowed:
    raise SystemExit(f"unknown Claude model tier: {tier}")
try:
    document = json.loads(path.read_text(encoding="utf-8"))
    model = document["tiers"]["anthropic"][tier]
except (OSError, KeyError, TypeError, json.JSONDecodeError) as exc:
    raise SystemExit(f"Claude model coordinator invalid: {type(exc).__name__}") from None
if not isinstance(model, str) or re.fullmatch(r"claude-[a-z0-9][a-z0-9.-]{1,63}", model) is None:
    raise SystemExit("Claude model coordinator returned an invalid model id")
print(model)
PYEOF
}

SLOTS_DIR="$DELEGATION_DIR/claude-slots"
SLOT_FD=""
TERMINAL_RECORDED=false
CURRENT_TASK_ID=""
HEARTBEAT_PID=""
PROVIDER_PID=""
TAIL_PID=""

# registry_append <id> <desc> <output_file> <pid> <role> <tier> <model> <daily_cap|0>
# Cap check and append happen under one flock so concurrent dispatchers cannot
# both slip under the cap. Exits 3 (printed refusal) when over cap.
registry_append() {
    local rc=0
    python3 - "$REGISTRY" "$@" <<'PYEOF' || rc=$?
import fcntl, json, sys, time
from datetime import datetime, timezone
registry, tid, desc, out, pid, role, tier, model, cap = sys.argv[1:10]
with open(registry + ".lock", "a") as lk:
    fcntl.flock(lk, fcntl.LOCK_EX)
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    n = 0
    try:
        with open(registry) as fh:
            for line in fh:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if e.get("agent") == "claude" and str(e.get("created", "")).startswith(today):
                    n += 1
    except FileNotFoundError:
        pass
    if int(cap) > 0 and n >= int(cap):
        print(f"daily dispatch cap reached: {n}/{cap} claude dispatches today; reserving quota. "
              "Route to another lane or pass --force-budget.", file=sys.stderr)
        sys.exit(3)
    row = {"id": tid, "agent": "claude", "role": role, "description": desc,
           "output_file": out, "pid": int(pid) if pid else None, "status": "running",
           "tokens_in": None, "tokens_out": None,
           "requested_model_tier": tier or None, "resolved_model": model or None,
           "created": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
    with open(registry, "a") as fh:
        fh.write(json.dumps(row) + "\n")
PYEOF
    [[ "$rc" -eq 0 ]] || { [[ "$rc" -eq 3 ]] && echo "[delegate-to-claude] dispatch refused (daily cap)" >&2; exit "$rc"; }
}

# reg_update <id> key=value...   (value: int, "null", or string) — flock + atomic replace.
reg_update() {
    python3 - "$REGISTRY" "$@" <<'PYEOF'
import fcntl, json, os, sys
registry, tid, *pairs = sys.argv[1:]
upd = {}
for p in pairs:
    k, _, v = p.partition("=")
    upd[k] = None if v == "null" else (int(v) if v.lstrip("-").isdigit() else v)
with open(registry + ".lock", "a") as lk:
    fcntl.flock(lk, fcntl.LOCK_EX)
    out = []
    with open(registry) as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
                if e.get("id") == tid:
                    e.update(upd)
                out.append(json.dumps(e))
            except ValueError:
                out.append(line)
    tmp = registry + ".tmp.%d" % os.getpid()
    with open(tmp, "w") as fh:
        fh.write("\n".join(out) + ("\n" if out else ""))
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, registry)
PYEOF
}

registry_update_status() {
    reg_update "$1" "status=$2"
}

# Terminal reconciliation: runs on EVERY exit path of a dispatch (provider
# failure, signal, set -e abort) so a task is never left "running" forever.
record_terminal() {
    local status="$1" code="$2" reason="${3:-}"
    [[ "$TERMINAL_RECORDED" == "true" ]] && return 0
    TERMINAL_RECORDED=true
    local ts; ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    reg_update "$CURRENT_TASK_ID" "status=$status" "exit_code=$code" "finished_at=$ts" \
        "terminal_reason=${reason:-provider_exit_$code}" "heartbeat_at=$ts" \
        || echo "[delegate-to-claude] WARN: terminal registry write failed for $CURRENT_TASK_ID" >&2
}

on_exit_reconcile() {
    local rc=$?
    # Aborted mid-run: do not leave the provider/tail/heartbeat orphaned.
    local p
    for p in "$HEARTBEAT_PID" "$PROVIDER_PID" "$TAIL_PID"; do
        [[ -n "$p" ]] && kill "$p" 2>/dev/null || true
    done
    if [[ -n "$CURRENT_TASK_ID" && "$TERMINAL_RECORDED" != "true" ]]; then
        record_terminal failed "$rc" "wrapper_aborted_exit_$rc"
    fi
}

heartbeat_loop() {
    # heartbeat_loop <id> <pid> — update heartbeat_at while pid is alive.
    local id="$1" pid="$2" every="${DELEGATE_CLAUDE_HEARTBEAT_S:-30}"
    while kill -0 "$pid" 2>/dev/null; do
        reg_update "$id" "heartbeat_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" 2>/dev/null || true
        sleep "$every"
    done
}

# acquire_slot <role>: flock-based concurrency slot, auto-released when the
# holder (and any inheriting child) dies. slot-0 is reserved for reviewers.
acquire_slot() {
    local role="$1" max="${DELEGATE_CLAUDE_MAX_PARALLEL:-2}" start=0 i fd
    [[ "$max" =~ ^[0-9]+$ && "$max" -ge 1 ]] || max=2
    command -v flock >/dev/null 2>&1 || die "flock(1) not found; cannot enforce parallel limit"
    mkdir -p "$SLOTS_DIR"
    if [[ "$role" != "review" && "$max" -ge 2 ]]; then start=1; fi
    for ((i=start; i<max; i++)); do
        exec {fd}>>"$SLOTS_DIR/slot-$i.lock"
        if flock -n "$fd"; then SLOT_FD="$fd"; return 0; fi
        exec {fd}>&-
    done
    return 1
}

release_slot() { [[ -n "$SLOT_FD" ]] && { exec {SLOT_FD}>&-; SLOT_FD=""; } || true; }

daily_cap_value() { echo "${DELEGATE_CLAUDE_DAILY_DISPATCH_CAP:-40}"; }

budget_check_only() {
    local role="$1" force="$2" cap; cap="$(daily_cap_value)"
    local n; n="$(python3 - "$REGISTRY" <<'PYEOF'
import json, sys
from datetime import datetime, timezone
today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
n = 0
try:
    for line in open(sys.argv[1]):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("agent") == "claude" and str(e.get("created", "")).startswith(today):
            n += 1
except FileNotFoundError:
    pass
print(n)
PYEOF
)"
    info "Dispatch budget: ${n}/${cap} today; parallel max ${DELEGATE_CLAUDE_MAX_PARALLEL:-2}"
    if [[ "$cap" -gt 0 && "$n" -ge "$cap" && "$force" != "true" ]]; then
        die_budget "daily dispatch cap reached: ${n}/${cap}; route to another lane or set --force-budget."
    fi
    if [[ "$force" != "true" ]]; then
        if acquire_slot "$role"; then release_slot
        else die_budget "no free claude slot for role=$role (DELEGATE_CLAUDE_MAX_PARALLEL=${DELEGATE_CLAUDE_MAX_PARALLEL:-2}); retry later or set --force-budget."; fi
    fi
}

check_pid_alive() {
    local pid="$1"
    [[ -n "$pid" ]] && [[ "$pid" != "null" ]] && kill -0 "$pid" 2>/dev/null
}

# ── subcommands ───────────────────────────────────────────────────────────────

cmd_list() {
    [[ -f "$REGISTRY" ]] || { info "No delegated tasks yet."; return; }
    printf "%-35s  %-10s  %-10s  %-10s  %6s  %6s  %s\n" \
        "TASK ID" "STATUS" "AGENT" "ROLE" "TOK_IN" "TOK_OUT" "DESCRIPTION"
    printf "%-35s  %-10s  %-10s  %-10s  %6s  %6s  %s\n" \
        "-----------------------------------" "----------" "----------" \
        "----------" "------" "-------" "-----------"
    python3 - "$REGISTRY" <<'PYEOF'
import sys, json
with open(sys.argv[1]) as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            e = json.loads(line)
            desc = e.get("description", "")[:50]
            ti = str(e.get("tokens_in") or "-")
            to = str(e.get("tokens_out") or "-")
            print(f"{e['id']:<35}  {e.get('status','?'):<10}  {e.get('agent','?'):<10}  {e.get('role','?'):<10}  {ti:>6}  {to:>7}  {desc}")
        except Exception:
            pass
PYEOF
}

cmd_status() {
    local id="$1"
    [[ -f "$REGISTRY" ]] || die "No registry found at $REGISTRY"
    python3 - "$REGISTRY" "$id" <<'PYEOF'
import sys, json
registry_file, task_id = sys.argv[1], sys.argv[2]
found = False
with open(registry_file) as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            e = json.loads(line)
            if e.get("id") == task_id:
                found = True
                print(json.dumps(e, indent=2))
        except Exception:
            pass
if not found:
    print(f"Task not found: {task_id}", file=sys.stderr)
    sys.exit(1)
PYEOF

    local pid; pid=$(python3 - "$REGISTRY" "$id" <<'PYEOF'
import sys, json
registry_file, task_id = sys.argv[1], sys.argv[2]
with open(registry_file) as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            e = json.loads(line)
            if e.get("id") == task_id:
                print(e.get("pid", ""))
        except Exception:
            pass
PYEOF
)
    if check_pid_alive "$pid"; then
        info "Process $pid is still running."
    else
        info "Process no longer running."
    fi
}

cmd_check() {
    local id="$1"
    local output_file; output_file=$(python3 - "$REGISTRY" "$id" <<'PYEOF'
import sys, json
registry_file, task_id = sys.argv[1], sys.argv[2]
with open(registry_file) as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            e = json.loads(line)
            if e.get("id") == task_id:
                print(e.get("output_file", ""))
        except Exception:
            pass
PYEOF
)
    [[ -n "$output_file" ]] || die "Task not found in registry: $id"
    [[ "$output_file" = /* ]] || output_file="$REPO_ROOT/$output_file"
    [[ -f "$output_file" ]] || die "Output file not found: $output_file (task may still be running)"
    cat "$output_file"
}

cmd_delegate() {
    local prompt="$1" wait_mode="${2:-false}" role="${3:-implement}" model_tier="${4:-}" force_budget="${5:-false}"

    require_claude
    ensure_dirs

    local id; id="$(task_id)"
    local output_file="$OUTPUTS_DIR/${id}.log"
    local rel_output=".agents/delegation/outputs/${id}.log"

    # Prepend the canonical harness grounding SSOT (config/local-agent-grounding.md)
    # so a headless Claude delegation gets the same facts even outside the repo's
    # CLAUDE.md scope, then the role tag.
    local grounding; grounding="$(harness_grounding claude 2>/dev/null || true)"
    local resolved_model=""
    if [[ -n "$model_tier" ]]; then
        resolved_model="$(resolve_model_tier "$model_tier")" || die "Unable to resolve Claude model tier '$model_tier'"
    fi

    # Phase 33.5: prepend role tag so Claude knows its specialization
    local full_prompt="${grounding:+$grounding

}[ROLE: ${role}]

${prompt}"

    info "Delegating task: $id"
    info "Role:            $role"
    if [[ -n "$resolved_model" ]]; then
        info "Model tier:      $model_tier -> $resolved_model"
    else
        info "Model tier:      CLI default (unresolved)"
    fi
    info "Output file:     $output_file"

    local cmd=("$CLAUDE_BIN" "-p" "$full_prompt" "--output-format" "text")
    if [[ -n "$resolved_model" ]]; then
        cmd+=("--model" "$resolved_model")
    fi

    # Admission control BEFORE any registry row exists: refused dispatches leave no
    # "running" ghost. --force-budget bypasses cap and slot limit.
    local cap; cap="$(daily_cap_value)"
    if [[ "$force_budget" == "true" ]]; then
        cap=0
        info "Budget override: --force-budget (cap and slot limit bypassed)"
    elif ! acquire_slot "$role"; then
        die_budget "no free claude slot for role=$role (DELEGATE_CLAUDE_MAX_PARALLEL=${DELEGATE_CLAUDE_MAX_PARALLEL:-2}; one slot reserved for review). Retry later, route to another lane, or set --force-budget."
    fi

    # Register before launching so the task is findable even if we die
    local rc=0
    registry_append "$id" "$prompt" "$rel_output" "" "$role" "$model_tier" "$resolved_model" "$cap" || rc=$?
    if [[ "$rc" -ne 0 ]]; then release_slot; exit "$rc"; fi
    CURRENT_TASK_ID="$id"
    TERMINAL_RECORDED=false
    trap on_exit_reconcile EXIT
    trap 'exit 143' TERM
    trap 'exit 130' INT
    audit_event_start "claude" "$id" "${prompt:0:200}" || true

    if [[ "$wait_mode" == "true" ]]; then
        info "Running in blocking mode..."
        # set -e must not abort before the terminal write: run the provider
        # backgrounded so its PID is recorded and heartbeated, then reap it.
        local exit_code=0 provider_pid tail_pid=""
        : > "$output_file"
        "${cmd[@]}" > "$output_file" 2>&1 </dev/null &
        provider_pid=$!; PROVIDER_PID=$provider_pid
        reg_update "$id" "pid=$provider_pid" "wrapper_pid=$$" \
            "heartbeat_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" || true
        heartbeat_loop "$id" "$provider_pid" >/dev/null 2>&1 &
        HEARTBEAT_PID=$!
        tail -n +1 -s 0.1 -f "$output_file" 2>/dev/null &
        tail_pid=$!; TAIL_PID=$tail_pid
        wait "$provider_pid" || exit_code=$?
        # tail --pid cannot be relied on (zombie/already-reaped races); give it one
        # poll interval to flush the final bytes, then stop it explicitly.
        sleep 0.4
        kill "$tail_pid" 2>/dev/null || true
        wait "$tail_pid" 2>/dev/null || true
        kill "$HEARTBEAT_PID" 2>/dev/null || true
        wait "$HEARTBEAT_PID" 2>/dev/null || true
        HEARTBEAT_PID=""; PROVIDER_PID=""; TAIL_PID=""
        if [[ "$exit_code" -eq 0 ]]; then
            record_terminal done 0 "completed"
            audit_event_end "claude" "$id" "success" "0" "completed: ${prompt:0:100}" "$role" || true
            audit_save_session "claude" "$id" "$prompt" "$output_file" || true
            info "Task $id completed successfully."
        else
            record_terminal failed "$exit_code"
            audit_event_end "claude" "$id" "error" "0" "failed exit=${exit_code}: ${prompt:0:100}" "$role" || true
            audit_save_session "claude" "$id" "$prompt" "$output_file" || true
            info "Task $id failed (exit $exit_code)."
        fi
        release_slot
        return 0
    else
        # Background mode: fully detach so it survives session eviction. The
        # worker inherits the slot fd, holding the slot until the provider dies.
        local _coord_url="${HYBRID_COORDINATOR_URL:-http://127.0.0.1:8003}"
        local _audit_helper; _audit_helper="$SCRIPT_DIR/lib/audit-post.sh"
        nohup bash "$SCRIPT_DIR/lib/claude-background-worker.sh" \
            "$output_file" "$_audit_helper" "$_coord_url" "$REGISTRY" "$id" "$role" "$prompt" \
            "${cmd[@]}" </dev/null > /dev/null 2>&1 &
        local pid=$!
        disown "$pid"
        release_slot
        # Worker is the lifecycle owner from here; it writes the terminal state.
        TERMINAL_RECORDED=true
        reg_update "$id" "pid=$pid" "heartbeat_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" || true

        info "Task $id started in background (pid $pid)"
        info "Check output:  delegate-to-claude --check $id"
        info "Check status:  delegate-to-claude --status $id"
        echo "$id"
    fi
}

# ── argument parsing ──────────────────────────────────────────────────────────

PROMPT=""
PROMPT_FILE=""
ROLE="implement"
MODEL_TIER=""
WAIT=false
FORCE_BUDGET=false
SUBCMD=""
SUBCMD_ARG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --prompt)      PROMPT="$2";      shift 2 ;;
        --prompt-file) PROMPT_FILE="$2"; shift 2 ;;
        --role)        ROLE="$2";        shift 2 ;;
        --model-tier)  MODEL_TIER="$2";  shift 2 ;;
        --wait)        WAIT=true;        shift   ;;
        --force-budget) FORCE_BUDGET=true; shift  ;;
        --budget-check-only) SUBCMD="budget"; shift ;;
        --check)       SUBCMD="check";   SUBCMD_ARG="$2"; shift 2 ;;
        --status)      SUBCMD="status";  SUBCMD_ARG="$2"; shift 2 ;;
        --list)        SUBCMD="list";    shift   ;;
        --help|-h)     grep "^#" "$0" | sed 's/^# \?//'; exit 0 ;;
        *) die "Unknown option: $1 (run with --help for usage)" ;;
    esac
done

case "$ROLE" in
    plan|implement|review|research) ;;
    *) die "Invalid --role '$ROLE'. Valid: plan | implement | review | research" ;;
esac

case "$MODEL_TIER" in
    ""|flagship|flagship_fallback|balanced|fast|creative) ;;
    *) die "Invalid --model-tier '$MODEL_TIER'. Valid: flagship | flagship_fallback | balanced | fast | creative" ;;
esac

case "${SUBCMD:-}" in
    list)   ensure_dirs; cmd_list ;;
    status) ensure_dirs; cmd_status "$SUBCMD_ARG" ;;
    check)  ensure_dirs; cmd_check "$SUBCMD_ARG" ;;
    budget) ensure_dirs; budget_check_only "$ROLE" "$FORCE_BUDGET" ;;
    "")
        if [[ -n "$PROMPT_FILE" ]]; then
            [[ -f "$PROMPT_FILE" ]] || die "Prompt file not found: $PROMPT_FILE"
            PROMPT="$(cat "$PROMPT_FILE")"
        fi
        [[ -n "$PROMPT" ]] || die "Provide --prompt TEXT or --prompt-file FILE (or --help)"
        cmd_delegate "$PROMPT" "$WAIT" "$ROLE" "$MODEL_TIER" "$FORCE_BUDGET"
        ;;
esac
