#!/usr/bin/env bash
# aq-deploy-current — one owner-run command: bring this machine to exactly origin/main
# (NixOS system + home-manager), then prove it. Closes the "system rebuild" stage of the dev loop.
# Incident 2026-10: primary checkout sat 3 days / 16 merged PRs behind origin/main, the running
# system was `eb2f97db-dirty`, and an in-place `nix flake update` left an uncommitted flake.lock.
#
# Steps: primary-checkout + branch-main check -> fetch -> dirty build-affecting files STOP (never
# auto-discarded; prints archive + restore commands) -> ff-only pull -> check-deploy-source.sh +
# pre-rebuild-preflight.sh (as `nrs`) -> [--dry-run stops after dry-build/build] ->
# sudo nixos-rebuild switch -> guarded home-manager switch (as `hms`) -> verify configuration
# revision == HEAD and not -dirty, list stale units -> 8b audited MCP baseline reseed + check -> 9 live QA.
#
# --rev <sha>: refuse (exit 1, before any guard or rebuild) unless HEAD after the pull is exactly that
# 40-hex revision; aq-update passes the revision it verified, so a main that moved is never deployed.
#
# Usage: scripts/maintenance/aq-deploy-current [--dry-run] [--rev <sha>] [--help]
# Run as the owner (not root); sudo switches NixOS and refreshes/checks the MCP integrity baseline.
set -euo pipefail

TAG="[aq-deploy-current]"
DRY=0
usage() { sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; echo; echo "Flags: --dry-run  build only, print what a real run would switch;  --rev <sha>  deploy only exactly that revision;  --help"; }
die() { echo "$TAG STOP: $*" >&2; exit 1; }

WANT_REV=""
HAVE_REV=0
while (($#)); do
  case "$1" in
    --dry-run) DRY=1 ;;
    --rev) (($# >= 2)) || { echo "$TAG --rev needs a value" >&2; exit 2; }; WANT_REV="$2"; HAVE_REV=1; shift ;;
    --rev=*) WANT_REV="${1#--rev=}"; HAVE_REV=1 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "$TAG unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done
if ((HAVE_REV)) && [[ ! "$WANT_REV" =~ ^[0-9a-f]{40}$ ]]; then
  echo "$TAG --rev must be a full 40-hex revision, got '$WANT_REV'" >&2; exit 2
fi

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(git -C "$SELF_DIR" rev-parse --show-toplevel)" || die "not inside a git checkout"
cd "$REPO"

# 1. primary checkout only
if [[ "$(git rev-parse --absolute-git-dir)" != "$(cd "$(git rev-parse --git-common-dir)" && pwd)" ]]; then
  die "$REPO is a linked worktree; run this from the primary checkout the flake is deployed from"
fi

# 2. fetch + branch
git fetch origin || die "git fetch origin failed; currency cannot be proven"
branch="$(git symbolic-ref -q --short HEAD || echo DETACHED)"
[[ "$branch" == "main" ]] || die "on '$branch', not main (git switch main)"

# 3. dirty tracked files; inert-path rule is read from check-deploy-source.sh (single source)
inert_re="$(sed -n "s/^inert_re='\(.*\)'\$/\1/p" scripts/governance/check-deploy-source.sh)"
[[ -n "$inert_re" ]] || die "could not read inert_re from scripts/governance/check-deploy-source.sh"
build_dirty=()
while IFS= read -r -d '' f; do
  if [[ "$f" != nix/* && "$f" =~ $inert_re ]]; then continue; fi
  build_dirty+=("$f")
done < <(git diff --name-only -z HEAD)
if ((${#build_dirty[@]})); then
  stamp="$(date +%Y%m%d)"
  echo "$TAG STOP: build-affecting tracked files are dirty. Nothing was discarded. For each, run:" >&2
  echo "mkdir -p .agents/archive" >&2
  for f in "${build_dirty[@]}"; do
    printf 'cp -p %q .agents/archive/%s-%q && git restore %q\n' "$f" "$stamp" "$(basename "$f")" "$f" >&2
  done
  echo "Then re-run scripts/maintenance/aq-deploy-current. (Lock updates belong in a flake-refresh PR.)" >&2
  exit 1
fi

# 4. fast-forward
git pull --ff-only origin main || die "git pull --ff-only origin main failed (local main has diverged?)"

if ((HAVE_REV)) && [[ "$(git rev-parse HEAD)" != "$WANT_REV" ]]; then
  die "checkout is at $(git rev-parse HEAD) after the pull, not the requested --rev $WANT_REV (main moved or the checkout diverged); nothing was built"
fi

# Build from the committed HEAD, not the working tree: agent appends to tracked inert files
# (issues-backlog.md, rsi-incidents.json, ...) would otherwise make the flake record `<rev>-dirty`.
# Build-affecting dirt already STOPped above, so the pinned tree equals what the working tree builds.
FLAKE="git+file://$REPO?rev=$(git rev-parse HEAD)"

# 5. guards exactly as nrs
scripts/governance/check-deploy-source.sh || die "check-deploy-source.sh failed"
scripts/governance/pre-rebuild-preflight.sh || die "pre-rebuild-preflight.sh failed"

# 6. dry run
if ((DRY)); then
  nixos-rebuild dry-build --flake "$FLAKE#hyperd-ai-dev"
  nix build --no-link --print-out-paths "$FLAKE#homeConfigurations.hyperd.activationPackage"
  echo "$TAG DRY RUN OK. A real run would: sudo nixos-rebuild switch --flake <HEAD-pinned>#hyperd-ai-dev;"
  echo "$TAG   home-manager switch --flake .#hyperd; then verify revision == $(git rev-parse --short=8 HEAD)."
  echo "$TAG   8b would reseed the MCP integrity baseline with audit diff and start its check after revision verification."
  exit 0
fi

# 7. real switch
started="$(date +%s)"
sudo nixos-rebuild switch --flake "$FLAKE#hyperd-ai-dev"
bash scripts/governance/check-deploy-source.sh "$REPO"
bash scripts/governance/check-checkout-fresh.sh
home-manager switch --flake "$FLAKE#hyperd"

# 8. verify
rc=0
want="$(git rev-parse HEAD)"
got="$(nixos-version --configuration-revision 2>/dev/null || true)"
if [[ -n "$got" && "$got" == "$want" && "$got" != *-dirty ]]; then
  echo "$TAG PASS: configuration revision $got == HEAD $want"
else
  echo "$TAG FAIL: configuration revision '${got:-<empty>}' != HEAD '$want' (or -dirty)" >&2
  rc=1
fi

stale=()
while read -r unit _; do
  [[ -n "$unit" ]] || continue
  wd="$(systemctl show -p WorkingDirectory --value "$unit" 2>/dev/null || true)"
  es="$(systemctl show -p ExecStart --value "$unit" 2>/dev/null || true)"
  [[ "$wd" == "$REPO"* || "$es" == *"$REPO"* ]] || continue
  since="$(systemctl show -p ActiveEnterTimestamp --value "$unit" 2>/dev/null || true)"
  since_s="$(date -d "$since" +%s 2>/dev/null || echo 0)"
  ((since_s < started)) && stale+=("$unit")
done < <({ echo command-center-dashboard-api.service; systemctl list-units --type=service --state=running --plain --no-legend 2>/dev/null; } | sort -u)
if ((${#stale[@]})); then
  echo "$TAG These units run code from the working tree and were not restarted by the switch:"
  echo "sudo systemctl restart ${stale[*]}"
fi

# 8b. Only bless MCP sources after the deployed revision has been verified.
if ((rc == 0)); then
  mcp_environment="$(systemctl show -p Environment --value ai-mcp-integrity-check.service 2>/dev/null || true)"
  mapfile -d '' -t mcp_paths < <(printf '%s' "$mcp_environment" | python3 -c '
import shlex
import sys
values = dict(item.split("=", 1) for item in shlex.split(sys.stdin.read()) if "=" in item)
for key in ("MCP_SERVER_DIR", "MCP_INTEGRITY_BASELINE"):
    sys.stdout.write(values.get(key, "") + "\0")
')
  if [[ ${#mcp_paths[@]} -ne 2 || -z "${mcp_paths[0]:-}" || -z "${mcp_paths[1]:-}" ]]; then
    echo "$TAG WARN: MCP integrity unit/environment absent; skipping baseline reseed."
  elif sudo env MCP_SERVER_DIR="${mcp_paths[0]}" MCP_INTEGRITY_BASELINE="${mcp_paths[1]}" \
      MCP_BASELINE_GIT_REV="$want" bash scripts/security/update-mcp-integrity-baseline.sh && \
      sudo systemctl start ai-mcp-integrity-check.service; then
    echo "$TAG PASS: MCP baseline reseeded with audit diff and integrity check passed"
  else
    echo "$TAG FAIL: MCP baseline reseed or subsequent integrity check failed" >&2
    rc=1
  fi
fi

# 9. prove the live stack from the owner's shell. QA phase 0 owns the live-state checks that tier0 --pre-commit
# no longer runs (0.1.2, 0.16.2, 0.10.66 aq-confine needs this shell's systemd user manager). Context-required:
# a skip for "cannot run here" becomes a failure so the suite always runs somewhere.
if [[ -x scripts/ai/aq-qa ]]; then
  qa_out="$(AQ_CONFINE_REQUIRE_CONTEXT=1 scripts/ai/aq-qa 0 --machine 2>&1)" || true
  echo "$qa_out" | tail -n 25
  if echo "$qa_out" | grep -qE '^SUMMARY .* 0 failed'; then
    echo "$TAG PASS: aq-qa 0 (live stack) reports 0 failed"
  else
    echo "$TAG FAIL: aq-qa 0 --machine did not report '0 failed' (no SUMMARY line counts as failure)" >&2
    rc=1
  fi
fi

((rc == 0)) || exit 1
