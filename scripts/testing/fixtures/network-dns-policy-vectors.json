  "sanitizer_vectors": [
    {
      "name": "scrub_profile_uuid",
      "raw": "nmcli connection 12345678-abcd-ef01-2345-6789abcdef01 up",
      "expected": "nmcli connection [REDACTED_UUID] up"
    },
    {
      "name": "scrub_mac_address",
      "raw": "bssid 00:1a:2b:3c:4d:5e on wlan0",
