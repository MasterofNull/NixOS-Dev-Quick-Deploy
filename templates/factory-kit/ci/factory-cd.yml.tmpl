# factory-gate-cd-pack v1
# Generated by the factory gate bundle. Project-owned after install: edits are preserved on upgrade.
# Policy: separately approval-gated CD with environment protection; every third-party action is pinned to a full commit SHA;
# permissions are read-only at workflow level; concurrency group prevents destructive parallel runs (cancel-in-progress: false);
# artifact digest verification and automated rollback handling on failure are mandatory.
name: factory-cd

on:
  workflow_dispatch:
    inputs:
      deployment_target:
        description: "Target environment (requires environment approval)"
        required: true
        default: "staging"
        type: choice
        options:
          - staging
          - production
      artifact_digest:
        description: "Expected evidence/artifact SHA-256 digest"
        required: false
        default: ""
        type: string
      rollback_target:
        description: "Optional prior artifact digest to restore in rollback"
        required: false
        default: ""
        type: string

permissions:
  contents: read

concurrency:
  group: factory-cd-${{ github.workflow }}-${{ inputs.deployment_target || 'staging' }}
  cancel-in-progress: false

jobs:
  deploy:
    name: Approval-gated deployment (${{ inputs.deployment_target || 'staging' }})
    runs-on: ubuntu-latest
    timeout-minutes: 45
    environment:
      name: ${{ inputs.deployment_target || 'staging' }}
    permissions:
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09  # v5
        with:
          persist-credentials: false
          fetch-depth: 0

      - name: CD policy and pin audit (blocking)
        run: python3 .factory/gate-bundle/ci/cd_policy.py check . --json

      - name: Verify artifact digest and provenance
        run: |
          if [ -n "${{ inputs.artifact_digest }}" ]; then
            echo "Verifying artifact digest: ${{ inputs.artifact_digest }}"
            if [ -f ci-evidence/SHA256SUMS ]; then
              grep -F "${{ inputs.artifact_digest }}" ci-evidence/SHA256SUMS || { echo "Digest mismatch"; exit 1; }
            fi
          else
            echo "No external artifact digest specified; proceeding with repository source"
          fi

      - name: Pre-deployment gate check (blocking)
        run: {{GATE_RUNNER_PATH}} --pre-commit

      - name: Toolchain setup (optional)
        run: |
          if [ -x .factory/cd-setup.sh ]; then .factory/cd-setup.sh; else echo "no .factory/cd-setup.sh; skipping"; fi

      - name: Execute deployment
        run: |
          echo "Deploying to environment: ${{ inputs.deployment_target || 'staging' }}"
          if [ -x .factory/cd-deploy.sh ]; then
            .factory/cd-deploy.sh "${{ inputs.deployment_target || 'staging' }}"
          else
            echo "Dry-run / template deployment complete"
          fi

      - name: Post-deployment health verification
        run: |
          echo "Verifying post-deployment health"
          if [ -x .factory/cd-health.sh ]; then
            .factory/cd-health.sh "${{ inputs.deployment_target || 'staging' }}"
          fi

      - name: Rollback plan on deployment failure
        if: failure()
        run: |
          echo "DEPLOYMENT FAILED: Initiating rollback procedure"
          if [ -x .factory/cd-rollback.sh ]; then
            .factory/cd-rollback.sh "${{ inputs.deployment_target || 'staging' }}" "${{ inputs.rollback_target }}"
          else
            echo "Manual rollback intervention required. Target environment: ${{ inputs.deployment_target || 'staging' }}"
            exit 1
          fi
