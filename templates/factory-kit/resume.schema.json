{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FactoryResumeSchema",
  "description": "Schema for RESUME.json in .agent/collaboration/",
  "type": "object",
  "required": [
    "current_objective",
    "phase",
    "todo_snapshot",
    "uncommitted_changes",
    "resume_hint"
  ],
  "properties": {
    "current_objective": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "todo_snapshot": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncommitted_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resume_hint": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
