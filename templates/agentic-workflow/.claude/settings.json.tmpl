{
  "mcpServers": {
    "ai-stack-harness": {
      "command": "python3",
      "args": [
        "/opt/nixos-quick-deploy/scripts/ai/mcp-bridge-hybrid.py"
      ],
      "env": {
        "HYBRID_URL": "{{HYBRID_COORDINATOR_ENDPOINT}}",
        "AIDB_URL": "{{AIDB_ENDPOINT}}",
        "HYBRID_API_KEY_FILE": "/run/secrets/hybrid_coordinator_api_key",
        "AIDB_API_KEY_FILE": "/run/secrets/aidb_api_key"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(aq-hints*)",
      "Bash(aq-report*)",
      "Bash(aq-qa*)",
      "Bash(aqd*)",
      "Bash(project-init*)",
      "Bash(workflow-primer*)",
      "Bash(workflow-brownfield*)",
      "Bash(harness-rpc*)",
      "Bash(git *)",
      "Bash(curl -sf {{HYBRID_COORDINATOR_CURL_TARGET}}*)",
      "Bash(curl -sf {{AIDB_CURL_TARGET}}*)"
    ]
  },
  "hints": {
    "enabled": {{HYBRID_COORDINATOR_HINTS_ENABLED}},
    "endpoint": "{{HYBRID_COORDINATOR_HINTS_ENDPOINT}}",
    "autoFetch": true,
    "minScore": 0.55
  },
  "progressiveDisclosure": {
    "defaultLevel": "overview",
    "escalateOnBlock": true
  }
}
