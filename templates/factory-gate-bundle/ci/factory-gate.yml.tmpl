# factory-gate-ci-pack v1
# Generated by the factory gate bundle. Project-owned after install: edits are preserved on upgrade.
# Policy: every third-party action is pinned to a full commit SHA (ci/ci_policy.py rejects tags/branches);
# permissions are read-only at workflow level; no privileged PR trigger; no repository secrets are referenced,
# so fork pull requests run the same blocking gates with no credentials.
name: factory-gate

on:
  push:
    branches: [ "main", "master" ]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: factory-gate-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  gate:
    name: Factory gate (blocking)
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09  # v5
        with:
          persist-credentials: false
          fetch-depth: 0

      # Stack toolchain setup is project-owned: add pinned setup-* actions above or
      # provide an executable .factory/ci-setup.sh. Absent setup is not an error.
      - name: Toolchain setup (optional)
        run: |
          if [ -x .factory/ci-setup.sh ]; then .factory/ci-setup.sh; else echo "no .factory/ci-setup.sh; skipping"; fi

      - name: Workflow pin and permission audit (blocking)
        run: python3 .factory/gate-bundle/ci/ci_policy.py check . --json

      - name: Bundle self-test (blocking)
        run: bash .factory/gate-bundle/self-test.sh

      - name: Factory gate - structure, secret scan, build, test, lint (blocking)
        run: {{GATE_RUNNER_PATH}} --pre-commit

      - name: Record evidence digest
        if: always()
        run: |
          mkdir -p ci-evidence
          if [ -f .factory/gate-run-evidence.json ]; then
            cp .factory/gate-run-evidence.json ci-evidence/
            sha256sum ci-evidence/gate-run-evidence.json > ci-evidence/SHA256SUMS
          fi

      - name: Upload evidence
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f  # v6
        with:
          name: factory-gate-evidence
          path: ci-evidence
          if-no-files-found: ignore
          retention-days: 30
